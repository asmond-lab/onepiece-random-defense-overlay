local real o8b=GetUnitState(J8b,k8b)
if not KZ then
set KZ=true
call TimerStart(qZ,.25,true,Z7)
endif
if sZ!=o8b then
set sZ=o8b
if nZ<o8b then
else
set NZ=NZ*(o8b/nZ)
endif
set nZ=o8b
endif
set NZ=NZ+GetEventDamage()
set k8b=UNIT_STATE_MAX_LIFE
if GetUnitState(J8b,k8b)>=NZ then
if GetPlayerController(H8b)==MAP_CONTROL_USER then
set iZ[GetPlayerId(H8b)]=iZ[GetPlayerId(H8b)]+GetEventDamage()
else
set iZ[GetUnitUserData(t8b)]=iZ[GetUnitUserData(t8b)]+GetEventDamage()
endif
else
set o8b=NZ-o8b
set o8b=GetEventDamage()-o8b
if GetPlayerController(H8b)==MAP_CONTROL_USER then
set iZ[GetPlayerId(H8b)]=iZ[GetPlayerId(H8b)]+o8b
else
set iZ[GetUnitUserData(t8b)]=iZ[GetUnitUserData(t8b)]+o8b
endif
endif
set t8b=null
set J8b=null
set H8b=null
set k8b=null
endfunction
