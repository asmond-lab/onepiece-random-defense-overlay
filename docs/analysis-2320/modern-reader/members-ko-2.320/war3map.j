function yry takes nothing returns nothing
local unit lOy=GetAttacker()
local unit IOy=GetTriggerUnit()
local location COy=GetUnitLoc(lOy)
local location SOy=GetUnitLoc(IOy)
local unitstate bry=UNIT_STATE_LIFE
local integer EOy
local unitstate Try
if GetUnitState(lOy,bry)==35. then
call SetUnitState(lOy,UNIT_STATE_LIFE,1.)
call CreateUnitAtLoc(Vy,$65303359,SOy,GetRandomReal(0.,360.))
call CreateUnitAtLoc(Vy,$6530335a,SOy,GetRandomReal(0.,360.))
set EOy=d7b()
call bnb(EOy,575.,SOy,Condition(fW),BW)
call qny(EOy)
else
set bry=UNIT_STATE_LIFE
set Try=UNIT_STATE_LIFE
call SetUnitState(lOy,bry,GetUnitState(lOy,Try)+1.)
endif
if ptT(1,$3e8)<=88 then
call CreateUnitAtLoc(Vy,$65303359,SOy,GetRandomReal(0.,360.))
call CreateUnitAtLoc(Vy,$6530335a,SOy,GetRandomReal(0.,360.))
set EOy=d7b()
call bnb(EOy,575.,SOy,Condition(fW),BW)
call qny(EOy)
endif
call RemoveLocation(COy)
call RemoveLocation(SOy)
set lOy=null
set IOy=null
set COy=null
set SOy=null
set bry=null
set Try=null
endfunction
function ysT takes nothing returns nothing
local unit lPT=GetAttacker()
local unit IPT=GetTriggerUnit()
local location CPT=GetUnitLoc(IPT)
local unitstate SPT=UNIT_STATE_MANA
local unitstate bsT
local unitstate TsT
if GetUnitState(lPT,SPT)==125. then
call SetUnitAnimationByIndex(lPT,9)
call SetUnitState(lPT,UNIT_STATE_MANA,0.)
call TriggerExecute(yi)
else
set SPT=UNIT_STATE_MANA
set bsT=UNIT_STATE_MANA
call SetUnitState(lPT,SPT,GetUnitState(lPT,bsT)+1.)
endif
if ptT(1,16)<=1 then
call TriggerExecute(Fi)
endif
if ptT(1,$64)<=15 then
call TriggerExecute(gi)
endif
if ptT(1,$2710)<=$1db then
call CreateUnitAtLoc(Vy,$65304b41,CPT,GetRandomReal(0.,360.))
if mmy(IPT) then
set TsT=UNIT_STATE_LIFE
call OeT(lPT,IPT,GetUnitState(IPT,TsT)*2.,1.,1.,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
else
call OeT(lPT,IPT,2000000.,1.,1.50,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endif
endif
call RemoveLocation(CPT)
set lPT=null
set IPT=null
set CPT=null
set SPT=null
set bsT=null
set TsT=null
endfunction
