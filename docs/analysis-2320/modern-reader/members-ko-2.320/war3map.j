local real kpT
local unit jpT
set LpT=Player(HpT)
set kpT=GetStartLocationY(GetPlayerStartLocation(LpT))
if GetUnitTypeId(GetTriggerUnit())!=$65303135 then
set LpT=null
set jpT=null
