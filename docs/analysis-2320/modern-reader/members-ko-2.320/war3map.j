call SetUnitUserData(byy,0)
call TriggerExecute(mN)
endif
if ptT(1,$64)<=10 then
call TriggerExecute(dN)
endif
if ptT(1,$64)<=8 then
set Tyy=CreateUnitAtLoc(Vy,$68304335,yyy,bj_UNIT_FACING)
