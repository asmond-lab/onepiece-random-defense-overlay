function XET takes nothing returns nothing
local unit EUT=GetAttacker()
local unit lUT=GetTriggerUnit()
local location CUT=GetUnitLoc(EUT)
local location SUT=GetUnitLoc(lUT)
local real bET=GetUnitFacing(EUT)
local player TET=GetOwningPlayer(EUT)
local integer yET=GetPlayerId(TET)
local integer FET=5
local integer gET=$7d
