function OJT takes nothing returns nothing
local player NJT=GetTriggerPlayer()
local unit iJT=GetTriggerUnit()
local location KJT=GetStartLocationLoc(GetPlayerId(NJT))
local integer ZJT=GetSpellAbilityId()
local integer fJT=0
local string BJT=""
local string RJT=""
local integer xJT=0
local integer MJT=0
local boolean vJT=true
local unit qJT
if ZJT==$41313451 then
set xJT=2*hP[GetPlayerId(NJT)]
set MJT=7*hP[GetPlayerId(NJT)]
set fJT=$48304142
set BJT="SE\\Vegapunk_Lilith.mp3"
set RJT="|cffc0c0c0릴리스|r : |cff00fa9a난 정부한테 고용된 하찮은 천재 과학자, 닥터 베가펑크다!|r"
elseif ZJT==$41313452 then
set xJT=2*hP[GetPlayerId(NJT)]
set MJT=7*hP[GetPlayerId(NJT)]
set fJT=$48304145
set BJT="SE\\Vegapunk_Atlas.mp3"
set RJT="|cffc0c0c0아틀라스|r : |cff00fa9a난 정부한테 고용된 하찮은 천재 과학자, 닥터 베가펑크다!|r"
elseif ZJT==$41313455 then
set xJT=4
set MJT=0
set fJT=$4830414d
set BJT="SE\\Vegapunk_York.mp3"
set RJT="|cffc0c0c0요크|r : |cff00fa9a닥터 베가펑크는 이 세상에 한 명이면 충분하지?|r"
else
set vJT=false
endif
if vJT then
if GetPlayerState(NJT,PLAYER_STATE_RESOURCE_FOOD_USED)<xJT then
call DisplayTimedTextToPlayer(NJT,0.,0.,6.,"|cffff0000[오류]|r|cff1e90ff특성포인트|r가 부족합니다!")
call IssueImmediateOrder(iJT,"stop")
set vJT=false
elseif MJT>0 and GetPlayerState(NJT,PLAYER_STATE_RESOURCE_LUMBER)<MJT then
call DisplayTimedTextToPlayer(NJT,0.,0.,5.,"|cffFF8200|cff7ad823목재|r가 부족합니다!|r")
call IssueImmediateOrder(iJT,"stop")
set vJT=false
endif
endif
if vJT then
call SetPlayerState(NJT,PLAYER_STATE_RESOURCE_FOOD_USED,GetPlayerState(NJT,PLAYER_STATE_RESOURCE_FOOD_USED)-xJT)
if MJT>0 then
call SetPlayerState(NJT,PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(NJT,PLAYER_STATE_RESOURCE_LUMBER)-MJT)
endif
call StartSound(tyy(BJT,null,$7f,1.,false,0.,0.))
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10.,RJT)
set qJT=CreateUnitAtLoc(NJT,fJT,KJT,bj_UNIT_FACING)
call GroupAddUnit(Hc[Hg[GetPlayerId(NJT)]],qJT)
call SetPlayerAbilityAvailable(NJT,ZJT,false)
set JP[GetPlayerId(NJT)]=JP[GetPlayerId(NJT)]+2
if ZJT==$41313451 or ZJT==$41313452 then
set hP[GetPlayerId(NJT)]=hP[GetPlayerId(NJT)]+1
endif
endif
call RemoveLocation(KJT)
set NJT=null
set iJT=null
set qJT=null
set KJT=null
endfunction
