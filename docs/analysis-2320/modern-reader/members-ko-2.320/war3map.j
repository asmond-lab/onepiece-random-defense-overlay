function U9T takes nothing returns nothing
local real W9T
local real w9T
local integer Y9T
call jNy(0)
if mv[Yg]==0 then
call hFF(Yg,0,GetAttacker())
call hFF(Yg,1,GetTriggerUnit())
call lAF(Yg,0,GetUnitLoc(LoadUnitHandle(UO,0,Yg*$1f4)))
call lAF(Yg,1,GetUnitLoc(LoadUnitHandle(UO,0,Yg*$1f4+1)))
call hXT(Yg,0,AngleBetweenPoints(LoadLocationHandle(lO,0,Yg*$1f4),LoadLocationHandle(lO,0,Yg*$1f4+1)))
call hFF(Yg,3,gg[GetPlayerId(GetOwningPlayer(LoadUnitHandle(UO,0,Yg*$1f4)))])
call ghb(Yg,LoadUnitHandle(UO,0,Yg*$1f4+1),EVENT_UNIT_DAMAGED,Condition(Uw),5)
call ghb(Yg,LoadUnitHandle(UO,0,Yg*$1f4),EVENT_UNIT_ISSUED_ORDER,Condition(Ew),1)
call Sny(Yg,.64,1)
elseif mv[Yg]==1 then
call U5T(Yg)
call ewb(Yg)
elseif mv[Yg]==5 then
call U5T(Yg)
set Y9T=Yg
set W9T=GetEventDamage()
if .0<W9T then
set w9T=W9T
else
set w9T=.0
endif
call hXT(Y9T,3,w9T)
call SetUnitState(LoadUnitHandle(UO,0,Yg*$1f4),UNIT_STATE_LIFE,GetUnitStateSwap(UNIT_STATE_LIFE,LoadUnitHandle(UO,0,Yg*$1f4))+1.)
call UnitDamagePointLoc(LoadUnitHandle(UO,0,Yg*$1f4+3),0.,400.,LoadLocationHandle(lO,0,Yg*$1f4+1),LoadReal(yr,0,Yg*$1f4+3)*.8,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL)
if ptT(1,$64)<=18 then
if GetUnitStateSwap(UNIT_STATE_LIFE,LoadUnitHandle(UO,0,Yg*$1f4))>=15. then
call SetUnitState(LoadUnitHandle(UO,0,Yg*$1f4),UNIT_STATE_LIFE,GetUnitStateSwap(UNIT_STATE_LIFE,LoadUnitHandle(UO,0,Yg*$1f4))-10.)
call Sny(Yg,.03,1)
else
call TYT(Yg,.03,10)
endif
else
call TYT(Yg,.03,10)
endif
elseif mv[Yg]==6 then
call awT("EffectStrikeDust.mdx",LoadUnitHandle(UO,0,Yg*$1f4),"origin")
call hFF(Yg,10,CreateUnitAtLoc(Vy,$65303437,LoadLocationHandle(lO,0,Yg*$1f4),LoadReal(yr,0,Yg*$1f4)))
call SetUnitScale(LoadUnitHandle(UO,0,Yg*$1f4+10),.85,1.,1.)
call SetUnitFlyHeight(LoadUnitHandle(UO,0,Yg*$1f4+10),15.,.0)
call SetUnitX(nG[LoadInteger(br,0,Yg*$1f4+8)],GetUnitX(LoadUnitHandle(UO,0,Yg*$1f4)))
call SetUnitY(nG[LoadInteger(br,0,Yg*$1f4+8)],GetUnitY(LoadUnitHandle(UO,0,Yg*$1f4)))
call IssueImmediateOrderById(nG[LoadInteger(br,0,Yg*$1f4+8)],OrderId("fanofknives"))
set bj_lastPlayedSound=tyy("SE\\marco_fire.wav",null,$64,1.,true,1500.,2500.)
call StopSound(bj_lastPlayedSound,false,false)
call lHT(LoadUnitHandle(UO,0,Yg*$1f4),bj_lastPlayedSound)
call lAF(Yg,2,PolarProjectionBJ(LoadLocationHandle(lO,0,Yg*$1f4),700.,LoadReal(yr,0,Yg*$1f4)))
call hFF(Yg,10,CreateUnitAtLoc(Vy,$65303438,LoadLocationHandle(lO,0,Yg*$1f4),LoadReal(yr,0,Yg*$1f4)))
call x4b(LoadUnitHandle(UO,0,Yg*$1f4+10),LoadLocationHandle(lO,0,Yg*$1f4+2),.28,.04)
call Sny(Yg,.04,1)
elseif mv[Yg]>=7 and mv[Yg]<=8 then
call lAF(Yg,2,PolarProjectionBJ(LoadLocationHandle(lO,0,Yg*$1f4),200.*I2R(mv[Yg]),LoadReal(yr,0,Yg*$1f4)))
call hFF(Yg,10,CreateUnitAtLoc(Vy,$65303438,LoadLocationHandle(lO,0,Yg*$1f4+2),LoadReal(yr,0,Yg*$1f4)))
call SetUnitScale(LoadUnitHandle(UO,0,Yg*$1f4+10),(180.+20.*I2R(mv[Yg]))*.01,1.,1.)
