function kOb takes nothing returns nothing
local string KOb=""
local unitstate xOb=UNIT_STATE_MAX_LIFE
local unit MOb=GetTriggerUnit()
local real ZOb=GetUnitState(MOb,xOb)
local integer ROb=0
local real fOb
local integer BOb
local integer vOb
local integer OOb
local player rOb
local player QOb
local player hOb
local player tOb
local player JOb
local player HOb
local real oOb
loop
exitwhen ROb>=4
if Uy[ROb]then
call jib(ROb)
else
call j0y(ROb)
endif
set ROb=ROb+1
endloop
call PauseTimer(cB)
set dB=false
set vOb=0
set OOb=0
loop
exitwhen vOb>=4
if Zy[vOb] and GetPlayerSlotState(Player(vOb))==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(vOb))==MAP_CONTROL_USER then
set OOb=OOb+1
endif
set vOb=vOb+1
endloop
if OOb==2 then
set mB=30
elseif OOb==3 then
set mB=25
else
set mB=20
endif
set ROb=0
loop
exitwhen ROb>=4
if Zy[ROb]then
set fOb=100.*(AB[ROb]/ZOb)
set GB[ROb]=fOb>=I2R(mB)
set BOb=R2I(($12c-eT[8])*fOb*5./100.)
call DisplayTimedTextToPlayer(Player(ROb),0.,0.,5.,"|cffffd700자신이 가한데미지는 "+R2SW(fOb,0,2)+"% 입니다.")
if BOb>0 then
call DisplayTimedTextToPlayer(Player(ROb),0.,0.,10.,"|cffdc143c[클리어점수]|r 스토리 파괴 : |cffffd700"+I2S(BOb)+"점|r")
call GgF(ROb,BOb)
endif
if VB<=AB[ROb]then
set VB=AB[ROb]
set DB=ROb
set eB=fOb
endif
endif
set ROb=ROb+1
endloop
set QF[DB]=QF[DB]+1
set VT[8]=Player(DB)
set DT[8]=eB*1.
set ROb=0
loop
exitwhen ROb>=4
if Zy[ROb]then
set rOb=Player(ROb)
call SetPlayerState(rOb,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(rOb,PLAYER_STATE_RESOURCE_GOLD)+$2328)
set QOb=Player(ROb)
call SetPlayerState(QOb,PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(QOb,PLAYER_STATE_RESOURCE_LUMBER)+5)
call gpy(Player(ROb),1)
set HOb=Player(ROb)
set hOb=Player(ROb)
set oOb=GetStartLocationX(GetPlayerStartLocation(hOb))
set tOb=Player(ROb)
call CreateUnit(HOb,$68303559,oOb,GetStartLocationY(GetPlayerStartLocation(tOb)),bj_UNIT_FACING)
call SetPlayerTechResearched(Player(ROb),$52303150,1)
call AuT(ROb,1)
endif
set ROb=ROb+1
endloop
set ROb=0
loop
exitwhen ROb>=4
if Zy[ROb] and GB[ROb]then
call DisplayTimedTextToPlayer(Player(ROb),0.,0.,10.,"기여도 "+I2S(mB)+"% 이상으로 |cff7ad823목재 1개|r 추가 획득!")
set JOb=Player(ROb)
call SetPlayerState(JOb,PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(JOb,PLAYER_STATE_RESOURCE_LUMBER)+1)
endif
set ROb=ROb+1
endloop
call gpy(Player(DB),1)
set KOb=KOb+"|cffFF0000"+GetObjectName($6e303041)+"|r 스토리 진행 완료! 모든 플레이어에게 보상을 지급합니다.\n"
set KOb=KOb+"|cffffdead◎|r 재화 : |cffffd7009000 골드|r, |cff7ad8235 목재|r\n"
set KOb=KOb+"|cffffdead◎|r 유닛 : |cffff8200"+GetObjectName($65303138)+"|r 1개, |cffb22222고대의 배|r\n"
set KOb=KOb+"|cffffdead◎|r MVP : "+GetPlayerName(Player(DB))+" (기여도 : |cffFF0000"+R2SW(eB,0,2)+"%|r)\n"
set KOb=KOb+"|cffffdead　▶|r 해당 플레이어에게 |cffff8200"+GetObjectName($65303138)+"|r 1개를 추가 지급합니다!"
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10.,KOb)
