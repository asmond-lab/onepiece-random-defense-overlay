local player VLb
set pT=GetStartLocationX(GetPlayerStartLocation(mLb))
set VLb=Player(gLb)
set WT=GetStartLocationY(GetPlayerStartLocation(VLb))
if HaveSavedReal(wT,YT,ALb) then
set pT=GetRectCenterX(eb[gLb])+cLb
set WT=GetRectCenterY(eb[gLb])+dLb
if cg[gLb]then
set WT=WT-225.
endif
endif
set mLb=null
set VLb=null
endfunction
