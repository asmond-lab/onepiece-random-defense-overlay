function lwy takes nothing returns nothing
local integer jwy=GetPlayerId(GetTriggerPlayer())
local unit uwy=GetTriggerUnit()
local player pwy
local integer Wwy
local integer wwy
local integer Ywy
local integer Uwy
local boolean Ewy
if (not IsUnitOwnedByPlayer(uwy,Player(7)))or(not HaveSavedInteger(Lc,GetUnitTypeId(uwy),-1)) then
set uwy=null
set pwy=null
return
endif
if not Li[jwy]then
set Li[jwy]=true
set ui[jwy]=GetTriggerUnit()
set uwy=GetTriggerUnit()
set pwy=GetTriggerPlayer()
set Ewy=false
set Wwy=GetUnitTypeId(uwy)
set wwy=GetPlayerId(pwy)
set Ywy=0
set Uwy=LoadInteger(Lc,Wwy,-1)
if not Wy[wwy]then
set Ewy=true
endif
if not Ewy then
set Wi[wwy]=Uwy
set wi[wwy]=Uwy
loop
exitwhen Ewy or((not Ewy)and Ywy==Uwy)
if not Ewy then
call T2F(pwy,Wwy,Ywy)
set Ywy=Ywy+1
endif
endloop
call nNy(wwy,Yi[Uwy-1])
call mPb(wwy,false)
call bub(wwy,false)
call xgF(wwy,Ui[wwy*50+Uwy-1],Uwy)
endif
if ji[jwy]==null then
set ji[jwy]=QAF(jwy)
endif
call TimerStart(ji[jwy],.5,false,N3)
else
if ui[jwy]!=GetTriggerUnit() then
set Li[jwy]=false
set ui[jwy]=null
set uwy=null
set pwy=null
return
endif
set Li[jwy]=false
set ui[jwy]=null
set pwy=GetTriggerPlayer()
set Wwy=GetPlayerId(pwy)
if oi[Wwy]==null then
set oi[Wwy]=CreateGroup()
endif
call ForGroup(oi[Wwy],i3)
set wwy=Wwy
set Ywy=0
loop
exitwhen Ywy>=50
if ki[wwy*50+Ywy]!=null then
call DestroyTextTag(ki[wwy*50+Ywy])
set ki[wwy*50+Ywy]=null
endif
set Ywy=Ywy+1
endloop
call GroupClear(oi[Wwy])
set uwy=GetTriggerUnit()
set pwy=GetTriggerPlayer()
set Wwy=GetUnitTypeId(uwy)
set wwy=GetPlayerId(pwy)
set Ywy=0
set Uwy=LoadInteger(Lc,Wwy,-1)
set pi=0
loop
exitwhen Ywy==Uwy
call CYy(pwy,Wwy,Ywy)
set Ywy=Ywy+1
endloop
set bj_lastCreatedUnit=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE),Wwy,GetRectCenterX(IF[wwy]),GetRectCenterY(IF[wwy]),bj_UNIT_FACING)
call UnitAddAbility(bj_lastCreatedUnit,$41657468)
