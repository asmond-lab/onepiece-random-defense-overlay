call ModifyHeroStat(bj_HEROSTAT_AGI,DZy,bj_MODIFYMETHOD_SET,aZy)
call ModifyHeroStat(bj_HEROSTAT_INT,DZy,bj_MODIFYMETHOD_SET,PZy)
call qkb(DZy)
call RemoveLocation(nZy)
set DZy=null
set eZy=null
set nZy=null
endfunction
function Tqy takes real Iiy,location Ciy,boolexpr Siy returns unit
