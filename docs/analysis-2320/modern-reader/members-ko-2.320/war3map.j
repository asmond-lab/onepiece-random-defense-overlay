function Jcy takes integer hcy,integer tcy returns integer
if hcy<tcy then
return hcy
else
return tcy
endif
endfunction
function svy takes integer Pvy returns integer
if Pvy<0 then
return -Pvy
else
return Pvy
endif
endfunction
function ptT takes integer ktT,integer LtT returns integer
local integer jtT=Jcy(ktT,LtT)
local integer utT=svy(LtT-ktT)
if Db==0 then
set Db=GetRandomInt(1,$f4240)
endif
set Db=ModuloInteger($10dcd*Db+1,$7fffffff)
return R2I(I2R(Db)/I2R($7fffffff)*(utT+1))+jtT
endfunction
function A4F takes nothing returns nothing
