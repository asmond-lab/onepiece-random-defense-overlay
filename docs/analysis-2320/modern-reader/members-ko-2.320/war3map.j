function dwb takes nothing returns nothing
local unit ywb=GetEventDamageSource()
local unit Fwb=GetTriggerUnit()
local player gwb=GetOwningPlayer(ywb)
local unitstate cwb=UNIT_STATE_MAX_LIFE
local real Awb=GetUnitState(Fwb,cwb)
if not Uf then
set Uf=true
call TimerStart(Yf,.25,true,u7)
endif
if uf!=Awb then
set uf=Awb
if pf<Awb then
else
set Wf=Wf*(Awb/pf)
endif
set pf=Awb
endif
set Wf=Wf+GetEventDamage()
set cwb=UNIT_STATE_MAX_LIFE
if GetUnitState(Fwb,cwb)>=Wf then
if GetPlayerController(gwb)==MAP_CONTROL_USER then
set wf[GetPlayerId(gwb)]=wf[GetPlayerId(gwb)]+GetEventDamage()
else
set wf[GetUnitUserData(ywb)]=wf[GetUnitUserData(ywb)]+GetEventDamage()
endif
else
set Awb=Wf-Awb
set Awb=GetEventDamage()-Awb
if GetPlayerController(gwb)==MAP_CONTROL_USER then
set wf[GetPlayerId(gwb)]=wf[GetPlayerId(gwb)]+Awb
else
set wf[GetUnitUserData(ywb)]=wf[GetUnitUserData(ywb)]+Awb
endif
endif
set ywb=null
set Fwb=null
set gwb=null
set cwb=null
endfunction
