local string nlb=""
local string Nlb
loop
exitwhen slb<=0
set nlb=nlb+"0"
set slb=slb-1
endloop
call wkb(Xlb)
call qky(Xlb,"202502131")
call qky(Xlb,"0")
call qky(Xlb,"0")
call qky(Xlb,"0")
call qky(Xlb,"0")
call qky(Xlb,"0")
call qky(Xlb,"0")
call qky(Xlb,I2S(25))
set slb=25
set Nlb=""
loop
exitwhen slb<=0
set Nlb=Nlb+"0"
set slb=slb-1
endloop
call qky(Xlb,Nlb)
call qky(Xlb,"0")
call qky(Xlb,I2S($96))
loop
exitwhen Plb>=$96
call qky(Xlb,I2S(yA[Plb])+","+nlb)
set Plb=Plb+1
endloop
call XOT(Xlb,alb)
endfunction
