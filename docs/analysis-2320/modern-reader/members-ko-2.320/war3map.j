function pAy takes nothing returns nothing
local integer oAy=GetPlayerId(GetOwningPlayer(GetAttacker()))
local unitstate kAy
local unit LAy
local unit jAy
local unit uAy
call IssueTargetOrderById(Da[oAy],OrderId("slow"),GetEnumUnit())
set jAy=gg[oAy]
set uAy=GetEnumUnit()
set kAy=UNIT_STATE_LIFE
set LAy=GetTriggerUnit()
call OeT(jAy,uAy,175000.+GetUnitState(LAy,kAy)*.004,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
set kAy=null
