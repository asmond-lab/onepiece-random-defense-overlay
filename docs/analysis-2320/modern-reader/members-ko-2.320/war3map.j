endif
set jpT=GetTriggerUnit()
call ShowUnit(jpT,false)
call KillUnit(jpT)
set bj_lastCreatedUnit=PlaceRandomUnit(HR,Player(HpT),opT,kpT,bj_UNIT_FACING)
call IssueImmediateOrder(bj_lastCreatedUnit,"holdposition")
call DisplayTextToPlayer(Player(HpT),0.,0.,GetUnitName(bj_lastCreatedUnit)+" 획득!")
set LpT=null
set jpT=null
endfunction
