call SetUnitY(bj_lastCreatedUnit,GetRectCenterY(IF[wwy]))
call GroupAddUnit(oi[wwy],bj_lastCreatedUnit)
call bTT(wwy)
if GetUnitAbilityLevel(GetTriggerUnit(),$41383031)==0 then
call SetCameraPositionForPlayer(GetTriggerPlayer(),GetRectCenterX(IF[jwy]),GetRectCenterY(IF[jwy]))
endif
endif
set uwy=null
set pwy=null
endfunction
