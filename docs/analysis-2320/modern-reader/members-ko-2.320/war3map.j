function fmy takes integer qmy,real Kmy,real Zmy returns nothing
set Kr=Dfy(qmy,"GUILogPose__escbutton icon")
call l6b(Kr,30.,30.)
call oCb(Kr,qmy,Kmy,Zmy)
set Zr=iqy(Kr,"GUILogPose__escbutton button")
call l6b(Zr,30.,30.)
call v2b(Zr,1,Kr,1,0.,0.)
call tAy(Zr,Qj)
call eyF(Zr,hj)
call why(Zr,tj)
endfunction
function qDy takes integer aDy,integer PDy,real sDy,real nDy,real NDy,real iDy returns nothing
set cQ[aDy]=Dfy(PDy,"GUILogPose__navigationIcon icon")
call l6b(cQ[aDy],sDy,nDy)
call v2b(cQ[aDy],1,PDy,1,NDy,iDy)
set dQ[aDy]=hQT(cQ[aDy],"GUILogPose__navigationIcon text1")
call TkT(dQ[aDy],"Fonts\\esamanruMedium.ttf",30.)
call v2b(dQ[aDy],1,cQ[aDy],1,0.,nDy+10.)
call K8T(dQ[aDy],false)
endfunction
function tTF takes integer OTF,integer rTF,real QTF,real hTF returns nothing
set Ur[OTF]=Dfy(rTF,"missionrerollbutton icon"+I2S(OTF))
call l6b(Ur[OTF],20.,20.)
call CZy(Ur[OTF],"Interface\\LogPoseBackButtonOff.tga")
call v2b(Ur[OTF],1,rTF,1,QTF,hTF)
set Er[OTF]=iqy(Ur[OTF],"missionrerollbutton button"+I2S(OTF))
call l6b(Er[OTF],20.,20.)
call v2b(Er[OTF],4,Ur[OTF],4,0.,0.)
call SaveInteger(yb,0,Er[OTF],OTF)
call tAy(Er[OTF],oj)
call eyF(Er[OTF],kj)
call why(Er[OTF],Lj)
endfunction
function ubT takes integer obT,integer kbT,real LbT,real jbT returns nothing
set lr[obT]=Dfy(kbT,"GUILogPose__navigationbutton icon")
call l6b(lr[obT],50.,50.)
call v2b(lr[obT],1,kbT,1,LbT,jbT)
set Ir[obT]=hQT(lr[obT],"GUILogPose__navigationbutton text1")
