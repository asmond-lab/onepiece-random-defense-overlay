endif
if GetUnitAbilityLevel(EUT,$4230335a)>0 then
set GET=true
else
set GET=GetUnitAbilityLevel(EUT,$42303343)>0
endif
if GET then
set eET=UNIT_STATE_LIFE
if GetUnitState(EUT,eET)>=250. then
call SetUnitState(EUT,UNIT_STATE_LIFE,1.)
