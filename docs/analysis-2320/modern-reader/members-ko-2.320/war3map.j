if Jhy!=Hhy then
call DisplayTimedTextToPlayer(Hhy,0.,0.,5.,"|cffff0000[오류]|r 자신의 유닛에게만 사용할 수 있습니다.")
set thy=null
set Jhy=null
set Hhy=null
return
endif
