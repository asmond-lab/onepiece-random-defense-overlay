function Qty takes nothing returns boolean
return IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(GetAttacker()))
endfunction
function QuT takes nothing returns nothing
if GetLocalPlayer()==R then
call EVy(WQ[0],true)
endif
endfunction
function Qub takes nothing returns nothing
call jNy(0)
if mv[Yg]==0 then
call hFF(Yg,0,GetAttacker())
call hFF(Yg,1,GetTriggerUnit())
call lAF(Yg,1,GetUnitLoc(LoadUnitHandle(UO,0,Yg*$1f4+1)))
call hFF(Yg,6,CreateUnitAtLoc(Vy,$65304e30,LoadLocationHandle(lO,0,Yg*$1f4+1),GetRandomReal(0.,360.)))
call SetUnitTimeScale(LoadUnitHandle(UO,0,Yg*$1f4+6),1.25)
call gwy(Yg,2,N1T(500.,LoadLocationHandle(lO,0,Yg*$1f4+1),Condition(CU)))
call hXT(Yg,3,I2R(GetHeroStatBJ(bj_HEROSTAT_STR,LoadUnitHandle(UO,0,Yg*$1f4),true))*50000.)
call hXT(Yg,4,I2R(CountUnitsInGroup(LoadGroupHandle(kO,0,Yg*$1f4+2)))*.25)
call jyy(Yg,8,GetPlayerId(GetOwningPlayer(LoadUnitHandle(UO,0,Yg*$1f4))))
call BlzPauseUnitEx(LoadUnitHandle(UO,0,Yg*$1f4),true)
call SetUnitAnimation(LoadUnitHandle(UO,0,Yg*$1f4),"attack slam")
call TYT(Yg,.30,1)
elseif mv[Yg]==1 then
set bj_lastPlayedSound=tyy("SE\\Kid EffectC.wav",null,$7f,1.,false,1000.,1600.)
call StopSound(bj_lastPlayedSound,false,false)
call lHT(LoadUnitHandle(UO,0,Yg*$1f4),bj_lastPlayedSound)
call hFF(Yg,10,CreateUnitAtLoc(Vy,$65304448,LoadLocationHandle(lO,0,Yg*$1f4+1),LoadReal(yr,0,Yg*$1f4)))
call hFF(Yg,10,CreateUnitAtLoc(Vy,$65304449,LoadLocationHandle(lO,0,Yg*$1f4+1),GetRandomReal(0.,360.)))
call IssuePointOrderById(cP[LoadInteger(br,0,Yg*$1f4+8)],OrderId("dreadlordinferno"),GetLocationX(LoadLocationHandle(lO,0,Yg*$1f4+1)),GetLocationY(LoadLocationHandle(lO,0,Yg*$1f4+1)))
call hFF(Yg,10,CreateUnitAtLoc(Vy,$65303757,LoadLocationHandle(lO,0,Yg*$1f4+1),GetRandomReal(0.,360.)))
call SetUnitScale(LoadUnitHandle(UO,0,Yg*$1f4+10),1.25,1.,1.)
call UnitApplyTimedLife(LoadUnitHandle(UO,0,Yg*$1f4+10),$42487765,1.)
call SetUnitFlyHeight(LoadUnitHandle(UO,0,Yg*$1f4+10),200.,10000.)
