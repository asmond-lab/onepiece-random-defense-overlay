local unit IUT
local real dET
local unitstate VET
local unitstate DET
local unitstate eET
local boolean GET
if GetUnitAbilityLevel(EUT,$42303343)>0 then
set FET=10
set gET=$fa
endif
set eET=UNIT_STATE_MANA
set VET=UNIT_STATE_MANA
call SetUnitState(EUT,eET,GetUnitState(EUT,VET)+1.)
set dET=GetUnitState(EUT,UNIT_STATE_MANA)
if AET==1 then
if dET==135. then
call SetUnitState(EUT,UNIT_STATE_LIFE,1.)
call SetUnitState(EUT,UNIT_STATE_MANA,0.)
set IUT=CreateUnitAtLoc(Vy,$65303355,CUT,bET)
