call SetUnitVertexColorBJ(LoadUnitHandle(UO,0,Yg*$1f4+10),100.,100.,100.,50.)
call hFF(Yg,10,CreateUnitAtLoc(Vy,$68303744,LoadLocationHandle(lO,0,Yg*$1f4+1),LoadReal(yr,0,Yg*$1f4)+180.))
