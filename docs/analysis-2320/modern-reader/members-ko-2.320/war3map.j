function giy takes nothing returns nothing
local unit pNy=GetAttacker()
local unit WNy=GetTriggerUnit()
local unit wNy=gg[GetPlayerId(GetOwningPlayer(pNy))]
local location UNy=GetUnitLoc(WNy)
local real ENy=GetUnitFacing(pNy)
local player lNy=GetOwningPlayer(pNy)
local real INy=I2R(UnitCountBuffsExBJ(bj_BUFF_POLARITY_EITHER,bj_BUFF_RESIST_EITHER,pNy,true,true))
local integer CNy=GetUnitAbilityLevel(pNy,$41314355)
local unitstate biy=UNIT_STATE_LIFE
local unitstate SNy=UNIT_STATE_LIFE
local unit YNy
local integer Tiy
local integer yiy
local integer Fiy
call SetUnitState(pNy,biy,GetUnitState(pNy,SNy)+1.)
set biy=UNIT_STATE_LIFE
if GetUnitState(pNy,biy)>=150. then
call TriggerExecute(ZP)
call SetUnitState(pNy,UNIT_STATE_LIFE,1.)
endif
set YNy=CreateUnitAtLoc(Vy,$65304559,UNy,ENy)
call UnitApplyTimedLife(YNy,$42487765,1.)
call UnitDamagePointLoc(wNy,0.,325.,UNy,10000.*INy,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
if ptT(1,$64)<=17 then
call TriggerExecute(fP)
endif
if ptT(1,$2710)<=$1f4+23*R2I(INy) then
set YNy=CreateUnitAtLoc(lNy,$68304350,UNy,ENy)
call UnitApplyTimedLife(YNy,$42487765,5.)
call SetUnitTimeScale(YNy,3.)
call SetUnitAbilityLevelSwapped($41314355,YNy,CNy)
set Tiy=PercentToInt(100.,$ff)
set yiy=PercentToInt(100.,$ff)
set Fiy=PercentToInt(100.,$ff)
call SetUnitVertexColor(YNy,Tiy,yiy,Fiy,PercentToInt(50.,$ff))
call IssueTargetOrder(YNy,"attack",WNy)
endif
call RemoveLocation(UNy)
set pNy=null
set WNy=null
set wNy=null
set YNy=null
set UNy=null
set lNy=null
set SNy=null
set biy=null
endfunction
