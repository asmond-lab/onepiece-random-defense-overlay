function ZIb takes integer iIb,integer qIb,unit KIb returns nothing
if GetItemCharges(Mi[iIb])==30 then
return
endif
if GetItemCharges(Mi[iIb])+qIb>=30 then
call SetItemCharges(Mi[iIb],30)
call SetPlayerTechResearched(Player(iIb),$52303051,30)
else
call SetItemCharges(Mi[iIb],GetItemCharges(Mi[iIb])+qIb)
call SetPlayerTechResearched(Player(iIb),$52303051,GetItemCharges(Mi[iIb]))
endif
if GetItemCharges(Mi[iIb])>=30 and vi[iIb]==0 then
set vi[iIb]=1
call UnitAddAbility(KIb,$4131305a)
call UnitAddAbility(KIb,$41313131)
call UnitAddAbility(KIb,$41313132)
call UnitRemoveAbility(KIb,$41305842)
call UnitRemoveAbility(KIb,$41305838)
call SetUnitAbilityLevel(KIb,$41305841,2)
if GetLocalPlayer()==Player(iIb) then
call SetCineFilterTexture("ReplaceableTextures\\CameraMasks\\Black_mask.blp")
call SetCineFilterBlendMode(BLEND_MODE_BLEND)
call SetCineFilterStartUV(0.,0.,2.,2.)
call SetCineFilterEndUV(0.,0.,2.,2.)
call SetCineFilterStartColor($ff,$ff,$ff,$ff)
call SetCineFilterEndColor($ff,$ff,$ff,0)
call SetCineFilterDuration(3.)
call DisplayCineFilter(true)
endif
call ycT(Player(iIb),"|cffff0000당신은 죄악이 등을 타고 오르는 것을 느꼈다|r",0.,-50.,0.,3.,3.)
call StartSound(tyy("SE\\SansAwaken2.mp3",null,$7f,1.,false,0.,0.))
else
call ygy(xi[ptT(1,29)],KIb,iIb)
call ZBT(Player(iIb),"SE\\SansTalker.wav",null,$7f,1.)
endif
endfunction
