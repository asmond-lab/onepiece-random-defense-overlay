call K8T(Ir[obT],false)
set Cr[obT]=Dfy(lr[obT],"GUILogPose__navigationbutton clearicon")
call l6b(Cr[obT],50.,50.)
call CZy(Cr[obT],"Interface\\BlackBackGround.tga")
call v2b(Cr[obT],4,lr[obT],4,0.,0.)
call EVy(Cr[obT],false)
set Sr[obT]=hQT(Cr[obT],"GUILogPose__navigationbutton cleartext")
call TkT(Sr[obT],"Fonts\\esamanruMedium.ttf",15.)
call v2b(Sr[obT],4,Cr[obT],4,0.,0.)
call rvT(Sr[obT],"클리어")
call K8T(Sr[obT],false)
set bQ[obT]=KfT(lr[obT],"GUILogPose__navigationbutton button")
call l6b(bQ[obT],70.,70.)
call v2b(bQ[obT],1,lr[obT],1,0.,0.)
call SaveInteger(yb,0,bQ[obT],obT)
call tAy(bQ[obT],jj)
call eyF(bQ[obT],uj)
call why(bQ[obT],pj)
endfunction
function wbT takes integer pbT,string WbT returns integer
set S=S+1
return h_T(BlzCreateFrameByType("SPRITE",WbT,LoadFrameHandle(Fb,0,pbT),"",S))
endfunction
