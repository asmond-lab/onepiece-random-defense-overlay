function efb takes nothing returns nothing
local unit Ffb=GetTriggerUnit()
local integer gfb=GetHeroXP(Ffb)
local integer Afb=GetHeroStatBJ(bj_HEROSTAT_STR,Ffb,false)
local integer cfb=GetHeroStatBJ(bj_HEROSTAT_AGI,Ffb,false)
local integer dfb=GetHeroStatBJ(bj_HEROSTAT_INT,Ffb,false)
local player mfb=GetOwningPlayer(Ffb)
local integer Vfb=GetPlayerId(mfb)
local location Dfb=GetUnitLoc(Ffb)
local unit yfb
if GetPlayerState(mfb,PLAYER_STATE_RESOURCE_FOOD_USED)<4 then
call DisplayTimedTextToPlayer(mfb,0.,0.,6.,"|cffff0000[오류]|r|cff1e90ff특성포인트|r가 부족합니다!")
call IssueImmediateOrder(Ffb,"stop")
set yfb=null
set Ffb=null
set mfb=null
set Dfb=null
return
endif
call StartSound(tyy("SE\\Sanji_2.mp3",null,$7f,1.,false,0.,0.))
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10.,"|cffc0c0c0상디 : |r|cff00fa9a여자의 눈물이 떨어지는 소리가 들렸다.|r")
set yfb=CreateUnitAtLoc(mfb,$48303947,Dfb,bj_UNIT_FACING)
call SetHeroXP(yfb,gfb,false)
call GroupAddUnit(Hc[Hg[Vfb]],yfb)
call ModifyHeroStat(bj_HEROSTAT_STR,yfb,bj_MODIFYMETHOD_SET,Afb)
call ModifyHeroStat(bj_HEROSTAT_AGI,yfb,bj_MODIFYMETHOD_SET,cfb)
call ModifyHeroStat(bj_HEROSTAT_INT,yfb,bj_MODIFYMETHOD_SET,dfb)
call IncUnitAbilityLevel(yfb,$41303455)
call IncUnitAbilityLevel(yfb,$41303454)
call IncUnitAbilityLevel(yfb,$41303453)
call qkb(yfb)
call SetPlayerState(mfb,PLAYER_STATE_RESOURCE_FOOD_USED,GetPlayerState(mfb,PLAYER_STATE_RESOURCE_FOOD_USED)-4)
call RemoveLocation(Dfb)
call RemoveUnit(Ffb)
set yfb=null
set Ffb=null
set mfb=null
set Dfb=null
endfunction
