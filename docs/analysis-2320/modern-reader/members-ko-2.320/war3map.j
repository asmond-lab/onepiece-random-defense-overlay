local string DOT
local string GOT
if GetLocalPlayer()==Player(yOT) then
call PreloadGenClear()
call PreloadGenStart()
call Preload(eOT)
call PreloadGenEnd(dOT)
endif
loop
exitwhen gOT>=AOT
set DOT=LoadStr(bT,yOT,gOT)
set eOT="\")\n\tcall BlzSetAbilityTooltip('AZZZ',\""+DOT+"\", 0)\n\treturn//"
set GOT=cOT+I2S(gOT)+".txt"
if GetLocalPlayer()==Player(yOT) then
call PreloadGenClear()
call PreloadGenStart()
call Preload(eOT)
call PreloadGenEnd(GOT)
endif
set VOT=I2S(StringHash(VOT+DOT))
set gOT=gOT+1
endloop
set eOT="\")\n\tcall BlzSetAbilityTooltip('AZZZ',\""+VOT+"\", 0)\n\treturn//"
if GetLocalPlayer()==Player(yOT) then
call PreloadGenClear()
call PreloadGenStart()
call Preload(eOT)
call PreloadGenEnd(mOT)
call BlzSendSyncData("CODE_SAVE","저장이 성공적으로 되었습니다.")
endif
endfunction
