call RemoveSavedHandle(lO,0,QAT*$1f4+hAT)
call SaveLocationHandle(lO,0,QAT*$1f4+hAT,tAT)
endfunction
function lAF takes integer YAF,integer UAF,location EAF returns nothing
call RemoveLocation(LoadLocationHandle(lO,0,YAF*$1f4+UAF))
call JAT(YAF,UAF,EAF)
endfunction
function lHT takes unit UHT,sound EHT returns nothing
if EHT!=null then
if GetLocalPlayer()==GetOwningPlayer(UHT) then
call AttachSoundToUnit(EHT,UHT)
call SetSoundVolume(EHT,$7f)
call StartSound(EHT)
endif
endif
endfunction
function ndF takes integer PdF,real sdF returns nothing
call TYT(PdF,sdF,mv[PdF]+1)
endfunction
function Zwb takes integer Kwb returns nothing
if Kwb==0 then
return
elseif oQ[Kwb]!=-1 then
return
endif
set oQ[Kwb]=JQ
set JQ=Kwb
endfunction
function qny takes integer iny returns nothing
call GroupClear(Hc[iny])
call Zwb(iny)
endfunction
function tyy takes string Ryy,string xyy,integer Myy,real vyy,boolean Oyy,real ryy,real Qyy returns sound
local integer hyy=GetSoundFileDuration(Ryy)
set mT=LoadSoundHandle(dT,StringHash(xyy),StringHash(Ryy))
if mT==null then
if Oyy then
set mT=CreateSound(Ryy,false,true,false,10,10,"DefaultEAXON")
call SetSoundDuration(mT,hyy)
call SetSoundChannel(mT,0)
call SetSoundVolume(mT,Myy)
call SetSoundPitch(mT,vyy)
call SetSoundDistances(mT,ryy,Qyy)
call SetSoundDistanceCutoff(mT,(ryy+Qyy)/2.)
call SetSoundConeAngles(mT,.0,.0,$7f)
call SetSoundConeOrientation(mT,.0,.0,.0)
else
set mT=CreateSound(Ryy,false,false,false,10,10,"DefaultEAXON")
call SetSoundDuration(mT,hyy)
call SetSoundChannel(mT,0)
call SetSoundVolume(mT,Myy)
call SetSoundPitch(mT,vyy)
endif
call SaveSoundHandle(dT,StringHash(xyy),StringHash(Ryy),mT)
endif
return mT
endfunction
function A2F takes nothing returns nothing
local integer F2F
local integer g2F
call jNy(0)
if mv[Yg]==0 then
call hFF(Yg,0,GetAttacker())
call hFF(Yg,1,GetTriggerUnit())
call lAF(Yg,0,GetUnitLoc(LoadUnitHandle(UO,0,Yg*$1f4)))
call lAF(Yg,1,GetUnitLoc(LoadUnitHandle(UO,0,Yg*$1f4+1)))
call hXT(Yg,0,AngleBetweenPoints(LoadLocationHandle(lO,0,Yg*$1f4),LoadLocationHandle(lO,0,Yg*$1f4+1)))
call jyy(Yg,0,0)
call jyy(Yg,8,GetPlayerId(GetOwningPlayer(LoadUnitHandle(UO,0,Yg*$1f4))))
call jyy(Yg,10,GetUnitCurrentOrder(LoadUnitHandle(UO,0,Yg*$1f4)))
call BlzPauseUnitEx(LoadUnitHandle(UO,0,Yg*$1f4),true)
call SetUnitAnimation(LoadUnitHandle(UO,0,Yg*$1f4),"spell one")
call SetUnitTimeScale(LoadUnitHandle(UO,0,Yg*$1f4),.7)
call lAF(Yg,2,PolarProjectionBJ(LoadLocationHandle(lO,0,Yg*$1f4),-120.,LoadReal(yr,0,Yg*$1f4)))
call hFF(Yg,10,CreateUnitAtLoc(Vy,$65304553,LoadLocationHandle(lO,0,Yg*$1f4+2),LoadReal(yr,0,Yg*$1f4)))
call SetUnitVertexColor(LoadUnitHandle(UO,0,Yg*$1f4+10),20,80,$7d,$ff)
call SetUnitTimeScale(LoadUnitHandle(UO,0,Yg*$1f4+10),2.86)
call ndF(Yg,.35)
elseif mv[Yg]==1 then
if LoadInteger(br,0,Yg*$1f4)==0 then
call SetUnitTimeScale(LoadUnitHandle(UO,0,Yg*$1f4),2.)
set bj_lastPlayedSound=tyy("SE\\Jimbe_Effect034.wav",null,$7f,1.6,true,1000.,3000.)
call lHT(LoadUnitHandle(UO,0,Yg*$1f4),bj_lastPlayedSound)
set g2F=0
loop
exitwhen g2F>=2
call hFF(Yg,10,CreateUnitAtLoc(Vy,$65304431,LoadLocationHandle(lO,0,Yg*$1f4),LoadReal(yr,0,Yg*$1f4)))
call SetUnitScale(LoadUnitHandle(UO,0,Yg*$1f4+10),1.75,1.,1.)
call SetUnitTimeScale(LoadUnitHandle(UO,0,Yg*$1f4+10),.75)
set g2F=g2F+1
endloop
set F2F=d7b()
call bnb(F2F,625.,LoadLocationHandle(lO,0,Yg*$1f4+1),Condition(YU),UU)
call qny(F2F)
endif
if LoadInteger(br,0,Yg*$1f4)<3 then
call lAF(Yg,2,PolarProjectionBJ(LoadLocationHandle(lO,0,Yg*$1f4),200.+150.*I2R(LoadInteger(br,0,Yg*$1f4)),LoadReal(yr,0,Yg*$1f4)))
call hFF(Yg,10,CreateUnitAtLoc(Vy,$65303847,LoadLocationHandle(lO,0,Yg*$1f4+2),LoadReal(yr,0,Yg*$1f4)-180.))
call SetUnitScale(LoadUnitHandle(UO,0,Yg*$1f4+10),2.5+.5*I2R(LoadInteger(br,0,Yg*$1f4)),1.,1.)
call lAF(Yg,2,PolarProjectionBJ(LoadLocationHandle(lO,0,Yg*$1f4),400.+150.*I2R(LoadInteger(br,0,Yg*$1f4)),LoadReal(yr,0,Yg*$1f4)))
call hFF(Yg,10,CreateUnitAtLoc(Vy,$6530494e,LoadLocationHandle(lO,0,Yg*$1f4+2),LoadReal(yr,0,Yg*$1f4)))
call SetUnitScale(LoadUnitHandle(UO,0,Yg*$1f4+10),1.5+.5*I2R(LoadInteger(br,0,Yg*$1f4)),1.,1.)
call SetUnitVertexColor(LoadUnitHandle(UO,0,Yg*$1f4+10),20,80,$7d,$ff)
call SetUnitTimeScale(LoadUnitHandle(UO,0,Yg*$1f4+10),3.)
call jyy(Yg,0,LoadInteger(br,0,Yg*$1f4)+1)
call TYT(Yg,.05,1)
else
call TYT(Yg,.1,2)
endif
elseif mv[Yg]==2 then
call BlzPauseUnitEx(LoadUnitHandle(UO,0,Yg*$1f4),false)
call FyF(LoadUnitHandle(UO,0,Yg*$1f4),LoadUnitHandle(UO,0,Yg*$1f4+1),LoadInteger(br,0,Yg*$1f4+10))
call SetUnitTimeScale(LoadUnitHandle(UO,0,Yg*$1f4),1.)
call ewb(Yg)
endif
endfunction
function A2b takes nothing returns boolean
local integer g2b=vO
set XO[g2b]=null
set Kv[g2b]=null
set pv[g2b]=null
set Wv[g2b]=null
set fv[g2b]=null
return false
endfunction
function Ymy takes unit tmy,real Jmy,real Hmy,location omy,real kmy,real Lmy,real jmy,attacktype umy,damagetype pmy returns nothing
local real Wmy=b0b(Lmy,jmy)
local real wmy=Wmy*kmy
call UnitDamagePointLoc(tmy,Jmy,Hmy,omy,wmy,umy,pmy)
endfunction
function x4b takes unit P4b,location s4b,real n4b,real N4b returns nothing
local timer i4b=QAF(0)
local integer q4b=GetHandleId(i4b)
local location K4b=GetUnitLoc(P4b)
local real Z4b=AngleBetweenPoints(K4b,s4b)
local real f4b=DistanceBetweenPoints(K4b,s4b)
local integer B4b=R2I(n4b/N4b)
