function BAF takes nothing returns nothing
local unit iAF=GetEventDamageSource()
local unit qAF=GetTriggerUnit()
local player KAF=GetOwningPlayer(iAF)
local unitstate fAF=UNIT_STATE_MAX_LIFE
local real ZAF=GetUnitState(qAF,fAF)
if not dB then
set dB=true
call TimerStart(cB,.25,true,w7)
endif
if yB!=ZAF then
set yB=ZAF
if FB<ZAF then
else
set gB=gB*(ZAF/FB)
endif
set FB=ZAF
endif
set gB=gB+GetEventDamage()
set fAF=UNIT_STATE_MAX_LIFE
if GetUnitState(qAF,fAF)>=gB then
if GetPlayerController(KAF)==MAP_CONTROL_USER then
set AB[GetPlayerId(KAF)]=AB[GetPlayerId(KAF)]+GetEventDamage()
else
set AB[GetUnitUserData(iAF)]=AB[GetUnitUserData(iAF)]+GetEventDamage()
endif
else
set ZAF=gB-ZAF
set ZAF=GetEventDamage()-ZAF
if GetPlayerController(KAF)==MAP_CONTROL_USER then
set AB[GetPlayerId(KAF)]=AB[GetPlayerId(KAF)]+ZAF
else
set AB[GetUnitUserData(iAF)]=AB[GetUnitUserData(iAF)]+ZAF
endif
endif
set iAF=null
set qAF=null
set KAF=null
set fAF=null
endfunction
