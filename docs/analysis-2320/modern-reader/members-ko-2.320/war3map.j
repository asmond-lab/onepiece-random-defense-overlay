endif
set qdT=null
set KdT=null
endfunction
function fey takes nothing returns nothing
local unit Ney=GetTriggerUnit()
local player iey=GetOwningPlayer(Ney)
local playerstate qey
local integer Key
local integer Zey
if GetPlayerState(iey,PLAYER_STATE_RESOURCE_FOOD_USED)<4 then
call DisplayTimedTextToPlayer(iey,0.,0.,6.,"|cffff0000[오류]|r|cff1e90ff특성포인트|r가 부족합니다!")
call IssueImmediateOrder(Ney,"stop")
set Ney=null
set iey=null
set qey=null
return
endif
call UnitAddAbility(Ney,$41313154)
call UnitRemoveAbility(Ney,$41313151)
set qey=PLAYER_STATE_RESOURCE_FOOD_USED
set Key=GetPlayerState(iey,PLAYER_STATE_RESOURCE_FOOD_USED)-4
set Zey=GetPlayerState(iey,qey)
call AdjustPlayerStateBJ(Key-Zey,iey,qey)
set Ney=null
set iey=null
set qey=null
endfunction
