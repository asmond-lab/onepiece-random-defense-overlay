function pBb takes nothing returns nothing
local unit oBb=GetEventDamageSource()
local unit kBb=GetTriggerUnit()
local player LBb=GetOwningPlayer(oBb)
local unitstate uBb=UNIT_STATE_MAX_LIFE
local real jBb=GetUnitState(kBb,uBb)
if not EB then
set EB=true
call TimerStart(UB,.25,true,T8)
endif
if pB!=jBb then
set pB=jBb
if WB<jBb then
else
set wB=wB*(jBb/WB)
endif
set WB=jBb
endif
set wB=wB+GetEventDamage()
set uBb=UNIT_STATE_MAX_LIFE
if GetUnitState(kBb,uBb)>=wB then
if GetPlayerController(LBb)==MAP_CONTROL_USER then
set YB[GetPlayerId(LBb)]=YB[GetPlayerId(LBb)]+GetEventDamage()
else
set YB[GetUnitUserData(oBb)]=YB[GetUnitUserData(oBb)]+GetEventDamage()
endif
else
set jBb=wB-jBb
set jBb=GetEventDamage()-jBb
if GetPlayerController(LBb)==MAP_CONTROL_USER then
set YB[GetPlayerId(LBb)]=YB[GetPlayerId(LBb)]+jBb
else
set YB[GetUnitUserData(oBb)]=YB[GetUnitUserData(oBb)]+jBb
endif
endif
set oBb=null
set kBb=null
set LBb=null
set uBb=null
endfunction
