function eny takes integer yny,real Fny,location gny returns nothing
local integer Vny=0
local integer Dny=3
local unit Any
local real cny
local real dny
local integer mny
call GroupEnumUnitsInRangeOfLoc(Hc[Se],gny,Fny*1.,Condition(Qw))
loop
exitwhen Vny>=Dny
if rSb(Se)<=0 then
set Any=null
return
endif
set Any=WPT(Se)
set cny=GetUnitStatePercent(Any,UNIT_STATE_LIFE,UNIT_STATE_MAX_LIFE)*.85
set dny=GetUnitDefaultAcquireRange(Any)
set mny=R2I(dny)-ptT(3,5)
call GroupRemoveUnit(Hc[Se],Any)
call Yhb(Any)
if mny>pb-7 then
if mny==39 then
set mny=mny+2
endif
if ModuloInteger(mny,10)==0 and mny<=50 then
set mny=mny+1
endif
call MPT(GetUnitAbilityLevelSwapped($41393031,Any)-1,mny,cny)
endif
set Vny=Vny+1
endloop
set Any=null
endfunction
