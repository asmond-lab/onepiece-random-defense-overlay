function Z2T takes string n2T,boolean N2T,code i2T returns nothing
local integer q2T=0
local trigger K2T=CreateTrigger()
call TriggerAddAction(K2T,i2T)
loop
exitwhen q2T>=4
call TriggerRegisterPlayerChatEvent(K2T,Player(q2T),n2T,N2T)
set q2T=q2T+1
endloop
set K2T=null
endfunction
function OBy takes real vBy returns real
if vBy<0. then
return -vBy
else
return vBy
endif
endfunction
function RFy takes real fFy,real BFy returns real
if fFy<BFy then
return fFy
else
return BFy
endif
endfunction
function b0b takes real l8b,real I8b returns real
local real C8b=RFy(l8b,I8b)
local real S8b=OBy(I8b-l8b)
if Db==0 then
set Db=GetRandomInt(1,$f4240)
endif
set Db=ModuloInteger($10dcd*Db+1,$7fffffff)
return C8b+S8b*(I2R(Db)/I2R($7fffffff))
endfunction
function OeT takes unit qeT,unit KeT,real ZeT,real feT,real BeT,attacktype ReT,damagetype xeT returns nothing
local real MeT=b0b(feT,BeT)
local real veT=MeT*ZeT
call UnitDamageTarget(qeT,KeT,veT,true,false,ReT,xeT,WEAPON_TYPE_WHOKNOWS)
endfunction
function A0T takes nothing returns nothing
call OeT(LoadUnitHandle(UO,0,Yg*$1f4),GetEnumUnit(),6000.,1.,2.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endfunction
function A1y takes nothing returns boolean
local integer g1y=vO
set XO[g1y]=GetTriggerPlayer()
set Kv[g1y]=GetTriggerUnit()
set Sv[g1y]=GetRescuer()
return false
endfunction
function FyF takes unit lTF,unit ITF,integer CTF returns nothing
local real STF=GetUnitX(lTF)-GetUnitX(ITF)
local real byF=GetUnitY(lTF)-GetUnitY(ITF)
local real TyF=SquareRoot(STF*STF+byF*byF)
local real yyF=GetUnitAcquireRange(lTF)+200.
if CTF==0 or TyF>yyF or CTF==OrderId("holdposition") then
call IssueImmediateOrder(lTF,"holdposition")
return
endif
if (not IsUnitType(ITF,UNIT_TYPE_DEAD))and GetWidgetLife(ITF)>.405 and CTF==OrderId("attack") or(CTF==OrderId("smart") and IsUnitEnemy(ITF,GetOwningPlayer(lTF))) then
call IssueTargetOrder(lTF,"attack",ITF)
return
endif
call IssueImmediateOrder(lTF,"holdposition")
endfunction
function TYT takes integer CwT,real SwT,integer bYT returns nothing
if Gv[CwT]==null then
return
endif
set Vv[CwT]=bYT
set Xv[CwT]=false
call TimerStart(Gv[CwT],SwT,false,UH)
endfunction
function bnb takes integer Esb,real lsb,location Isb,boolexpr Csb,code Ssb returns nothing
call GroupEnumUnitsInRangeOfLoc(Hc[Esb],Isb,lsb,Csb)
call ForGroup(Hc[Esb],Ssb)
endfunction
function d7b takes nothing returns integer
local boolean A7b=false
local integer g7b=JQ
local integer F7b
local integer c7b
if g7b!=0 then
set JQ=oQ[g7b]
else
set HQ=HQ+1
set g7b=HQ
endif
if g7b>$1ffe then
set c7b=0
set A7b=true
endif
if not A7b then
set oQ[g7b]=-1
endif
if not A7b then
set c7b=g7b
set A7b=true
endif
if not A7b then
set c7b=0
endif
set F7b=c7b
if Hc[F7b]==null then
set Hc[F7b]=CreateGroup()
endif
return F7b
endfunction
function MMb takes integer xMb returns nothing
set nH=xMb
call TriggerEvaluate(KJ)
endfunction
function gfT takes integer FfT returns nothing
if FfT==0 then
return
elseif Av[FfT]!=-1 then
return
endif
set nH=FfT
call TriggerEvaluate(qJ)
set Av[FfT]=Fv
set Fv=FfT
endfunction
function t7y takes timer h7y returns nothing
if h7y==null then
return
endif
if PT==$1ffe then
call DestroyTimer(h7y)
else
call PauseTimer(h7y)
if LoadInteger(aT,0,GetHandleId(h7y))==$28829022 then
return
endif
call SaveInteger(aT,0,GetHandleId(h7y),$28829022)
set GJ[PT]=h7y
set PT=PT+1
endif
endfunction
function ewb takes integer Dwb returns nothing
if Gv[Dwb]==null then
return
endif
set vO=Dwb
call TriggerEvaluate(PJ[GetHandleId(ev[Dwb])])
call t7y(Gv[Dwb])
set Gv[Dwb]=null
call MMb(Dwb)
call gfT(Dwb)
endfunction
function HDT takes integer tDT,integer JDT returns nothing
if LoadInteger(QO,0,tDT*$1b74+$bc4+JDT+2)-2==-2 then
call SaveInteger(QO,0,tDT*$1b74+$bc4+JDT+2,YO[tDT]+2)
set YO[tDT]=JDT
endif
endfunction
function hFF takes integer OFF,integer rFF,unit QFF returns nothing
call HDT(OFF,rFF)
call RemoveSavedHandle(UO,0,OFF*$1f4+rFF)
call SaveUnitHandle(UO,0,OFF*$1f4+rFF,QFF)
endfunction
function hfb takes integer rfb,integer Qfb returns nothing
if LoadInteger(QO,0,rfb*$1b74+$139c+Qfb+2)-2==-2 then
call SaveInteger(QO,0,rfb*$1b74+$139c+Qfb+2,Tr[rfb]+2)
set Tr[rfb]=Qfb
endif
endfunction
function hXT takes integer OXT,integer rXT,real QXT returns nothing
call hfb(OXT,rXT)
call RemoveSavedReal(yr,0,OXT*$1f4+rXT)
call SaveReal(yr,0,OXT*$1f4+rXT,QXT)
endfunction
function QAF takes integer rAF returns timer
if PT==0 then
if not sT then
call TriggerEvaluate(TH[1])
set PT=PT-1
else
set GJ[0]=CreateTimer()
endif
else
set PT=PT-1
endif
call SaveInteger(aT,0,GetHandleId(GJ[PT]),rAF)
return GJ[PT]
endfunction
function Xfy takes integer Gfy returns nothing
endfunction
function soy takes nothing returns integer
local integer Goy
local integer Xoy
local boolean aoy
local integer Poy
set cv=true
set aoy=false
set Xoy=Fv
if Xoy!=0 then
set Fv=Av[Xoy]
else
set gv=gv+1
set Xoy=gv
endif
if Xoy>$1ffe then
set Poy=0
set aoy=true
endif
if not aoy then
set dv[Xoy]=$28829022
endif
if not aoy then
set mv[Xoy]=$28829022
endif
if not aoy then
set MO[Xoy]=0
endif
if not aoy then
set hO[Xoy]=-1
endif
if not aoy then
set JO[Xoy]=-1
endif
if not aoy then
set oO[Xoy]=-1
endif
if not aoy then
set LO[Xoy]=-1
endif
if not aoy then
set uO[Xoy]=-1
endif
if not aoy then
set WO[Xoy]=-1
endif
if not aoy then
set YO[Xoy]=-1
endif
if not aoy then
set EO[Xoy]=-1
endif
if not aoy then
set IO[Xoy]=-1
endif
if not aoy then
set SO[Xoy]=-1
endif
if not aoy then
set Tr[Xoy]=-1
endif
if not aoy then
set Fr[Xoy]=-1
endif
if not aoy then
set Ar[Xoy]=-1
endif
if not aoy then
set dr[Xoy]=-1
endif
if not aoy then
