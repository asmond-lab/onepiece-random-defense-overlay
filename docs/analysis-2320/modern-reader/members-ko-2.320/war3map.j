set Dv[Goy]=GetTriggeringTrigger()
call TimerStart(Gv[Goy],0.,false,EH)
set vO=Goy
call TriggerEvaluate(XJ[GetHandleId(ev[Goy])])
call Xfy(Goy)
return Goy
endfunction
