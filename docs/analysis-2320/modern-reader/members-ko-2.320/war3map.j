call SetUnitFlyHeight(LoadUnitHandle(UO,0,Yg*$1f4+10),30.,0.)
call hFF(Yg,10,CreateUnitAtLoc(Vy,$68303755,LoadLocationHandle(lO,0,Yg*$1f4+1),LoadReal(yr,0,Yg*$1f4)+90.))
call SetUnitFlyHeight(LoadUnitHandle(UO,0,Yg*$1f4+10),175.,.0)
call SetUnitScale(LoadUnitHandle(UO,0,Yg*$1f4+10),.8,1.,1.)
call SetUnitVertexColorBJ(LoadUnitHandle(UO,0,Yg*$1f4+10),25.,75.,100.,50.)
call ndF(Yg,.02)
elseif mv[Yg]==4 then
if LoadBoolean(gr,0,Yg*$1f4+2) then
set bj_lastPlayedSound=tyy("SE\\RyougiW4.wav",null,$64,1.,true,1000.,3000.)
