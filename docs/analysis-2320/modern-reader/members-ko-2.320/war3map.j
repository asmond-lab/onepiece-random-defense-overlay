endfunction
function NkT takes nothing returns nothing
local unit nkT
if GetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_FOOD_USED)<4 then
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0.,0.,6.,"|cffff0000[오류]|r|cff1e90ff특성포인트|r가 부족합니다!")
set nkT=GetTriggerUnit()
call IssueImmediateOrder(nkT,"stop")
set nkT=null
return
endif
call UnitAddAbility(GetTriggerUnit(),$41314345)
call UnitMakeAbilityPermanent(GetTriggerUnit(),true,$41314345)
call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()),$41313239,false)
call SetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_FOOD_USED,GetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_FOOD_USED)-4)
set nkT=null
endfunction
