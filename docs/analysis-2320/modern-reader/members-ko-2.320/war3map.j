function uvy takes nothing returns nothing
local unit Jvy=GetAttacker()
local unit Hvy=GetTriggerUnit()
local integer tvy
local unit ovy
local location kvy
local location Lvy
local location jvy
if GetUnitAbilityLevel(Hvy,$41303450)==0 then
call UnitAddAbility(Hvy,$41303450)
endif
call SetUnitAbilityLevel(Hvy,$41303450,GetUnitAbilityLevel(Hvy,$41303450)+10)
call TriggerExecute(KP)
if GetUnitState(Jvy,UNIT_STATE_LIFE)<=10. then
call TriggerExecute(qP)
set Jvy=null
set Hvy=null
set ovy=null
set kvy=null
set Lvy=null
set jvy=null
return
endif
if GetUnitState(Jvy,UNIT_STATE_MANA)==150. then
call UnitAddAbility(Jvy,$41305632)
call UnitRemoveAbility(Jvy,$41305632)
call SetUnitAnimation(Jvy,"spell slam")
if GetUnitAbilityLevel(Jvy,$41305638)==2 then
call SetUnitAbilityLevel(Jvy,$41305639,3)
else
call SetUnitAbilityLevel(Jvy,$41305639,2)
endif
call TriggerExecute(et)
else
call SetUnitState(Jvy,UNIT_STATE_MANA,(GetUnitState(Jvy,UNIT_STATE_MANA)+1.)*1.)
endif
if ptT(1,$64)<=30 then
call SetUnitState(Jvy,UNIT_STATE_LIFE,(GetUnitState(Jvy,UNIT_STATE_LIFE)-4.)*1.)
set kvy=GetUnitLoc(Jvy)
set Lvy=GetUnitLoc(Hvy)
set jvy=PolarProjectionBJ(kvy,100.,AngleBetweenPoints(kvy,Lvy))
call CreateUnitAtLoc(Vy,$6530454e,kvy,AngleBetweenPoints(kvy,Lvy))
set ovy=CreateUnitAtLoc(Vy,$68304335,jvy,AngleBetweenPoints(kvy,Lvy))
call UnitApplyTimedLife(ovy,$42487765,1.)
call SetUnitAnimationByIndex(ovy,60)
call SetUnitScale(ovy,.5,1.,1.)
call SetUnitFlyHeight(ovy,60.,10000.)
call awT("Bonney_PierceB.mdx",ovy,"origin")
set ovy=CreateUnitAtLoc(Vy,$65304550,Lvy,bj_UNIT_FACING)
call UnitApplyTimedLife(ovy,$42487765,.5)
call RemoveLocation(kvy)
call RemoveLocation(Lvy)
call RemoveLocation(jvy)
if GetUnitAbilityLevel(Hvy,$41303450)==0 then
call UnitAddAbility(Hvy,$41303450)
