local real m5F=GetUnitState(c5F,V5F)
if not mR then
set mR=true
call TimerStart(dR,.25,true,g8)
endif
if FR!=m5F then
set FR=m5F
if gR<m5F then
else
set AR=AR*(m5F/gR)
endif
set gR=m5F
endif
set AR=AR+GetEventDamage()
set V5F=UNIT_STATE_MAX_LIFE
if GetUnitState(c5F,V5F)>=AR then
if GetPlayerController(d5F)==MAP_CONTROL_USER then
set cR[GetPlayerId(d5F)]=cR[GetPlayerId(d5F)]+GetEventDamage()
else
set cR[GetUnitUserData(A5F)]=cR[GetUnitUserData(A5F)]+GetEventDamage()
endif
else
set m5F=AR-m5F
set m5F=GetEventDamage()-m5F
if GetPlayerController(d5F)==MAP_CONTROL_USER then
set cR[GetPlayerId(d5F)]=cR[GetPlayerId(d5F)]+m5F
else
set cR[GetUnitUserData(A5F)]=cR[GetUnitUserData(A5F)]+m5F
endif
endif
set A5F=null
set c5F=null
set d5F=null
set V5F=null
endfunction
