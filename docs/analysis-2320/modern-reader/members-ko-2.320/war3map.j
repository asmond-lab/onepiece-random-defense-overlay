function HQb takes nothing returns nothing
local integer eQb=S2I(BlzGetTriggerSyncData())
local integer GQb=GetPlayerId(GetTriggerPlayer())
local real XQb
local integer aQb
local group PQb
local unit sQb
local integer nQb
local integer NQb
local integer iQb
local integer qQb
local integer KQb
local integer ZQb
local boolean fQb
local boolean BQb
local boolean RQb
local boolean xQb
local real MQb
local boolean vQb
local real OQb
local real rQb
local boolean QQb
local real hQb
local boolean tQb
local boolean JQb
if eQb==1 then
call YGT(GQb,Wy[GQb])
elseif eQb==2 then
call DsT(GQb,wy[GQb])
elseif eQb==3 then
call mjy(GQb,Yy[GQb])
elseif eQb==4 then
call m0y(GQb,Uy[GQb])
elseif eQb==5 then
if li[GQb]==null then
set li[GQb]=CreateTimer()
endif
set XQb=TimerGetRemaining(li[GQb])
if XQb>.0 then
if GetLocalPlayer()==Player(GQb) then
call DisplayTimedTextToPlayer(Player(GQb),0.,0.,3.,"|cffF15F5F[시스템]|r 유틸 갱신 대기시간이 |cffffcc00"+R2SW(XQb,1,1)+"초|r 남았습니다.")
endif
else
set eQb=GQb
set aQb=GQb
set PQb=CreateGroup()
set NQb=1
loop
exitwhen NQb>4
call FlushChildHashtable(JT,NQb)
call FlushChildHashtable(HT,NQb)
set NQb=NQb+1
endloop
set nQb=0
loop
exitwhen nQb>=MT
set tT[nQb]=false
