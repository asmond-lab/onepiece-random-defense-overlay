if Ruy==null or Ouy==0. then
set Quy=.0
set ruy=true
endif
if not ruy then
set Quy=vuy/Ouy*100.
set ruy=true
endif
if not ruy then
set Quy=0.
endif
set iuy=Quy*.85
endif
if not Buy then
set quy=GetUnitDefaultAcquireRange(Nuy)
endif
if not Buy then
set Kuy=R2I(quy)-2
endif
if not Buy then
call GroupRemoveUnit(Hc[Se],Nuy)
endif
if not Buy then
set huy=Nuy
call ShowUnit(huy,false)
call KillUnit(huy)
endif
if not Buy then
if Kuy>pb-7 then
if not Buy then
if Kuy==39 then
if not Buy then
set Kuy=Kuy+2
endif
endif
endif
if not Buy then
if ModuloInteger(Kuy,10)==0 and Kuy<=50 then
if not Buy then
set Kuy=Kuy+1
endif
endif
endif
if not Buy then
set tuy=Nuy
call MPT(GetUnitAbilityLevel(tuy,$41393031)-1,Kuy,iuy)
endif
endif
endif
if not Buy then
set Zuy=Zuy+1
endif
endloop
call qny(Se)
call RemoveLocation(suy)
call RemoveLocation(nuy)
set auy=null
set Puy=null
set suy=null
set nuy=null
set Nuy=null
set Ruy=null
set xuy=null
set Muy=null
set huy=null
set tuy=null
endfunction
