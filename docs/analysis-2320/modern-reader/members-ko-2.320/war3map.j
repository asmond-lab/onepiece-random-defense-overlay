if IsUnitType(GetTriggerUnit(),UNIT_TYPE_UNDEAD) then
call DLb(Iay,GetUnitTypeId(GetTriggerUnit()))
set Cay=pT
set Say=GetRectCenterY(eb[Iay])
call cZb(GetTriggerUnit(),Cay,Say)
call UnitAddAbility(GetTriggerUnit(),$41303759)
call UnitRemoveAbility(GetTriggerUnit(),GetSpellAbilityId())
call IssueImmediateOrder(GetTriggerUnit(),"holdposition")
set bPy=GetTriggerUnit()
call SelectUnit(bPy,false)
endif
set bPy=null
endfunction
function TST takes nothing returns nothing
local unit WCT=GetAttacker()
local unit wCT=GetTriggerUnit()
local integer YCT=GetPlayerId(GetOwningPlayer(WCT))
local location UCT=GetUnitLoc(WCT)
local location ECT=GetUnitLoc(wCT)
local unitstate ICT=UNIT_STATE_LIFE
local unit lCT
local player CCT
local player SCT
local unitstate bST
if GetUnitState(WCT,ICT)==75. then
call SetUnitState(WCT,UNIT_STATE_LIFE,1.)
call CreateUnitAtLoc(Vy,$65304b34,ECT,GetUnitFacing(WCT))
call OeT(WCT,wCT,5000000.,1.,1.,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
if ptT(1,$64)<=45 then
set CCT=Player(YCT)
call SetPlayerState(CCT,PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(CCT,PLAYER_STATE_RESOURCE_LUMBER)+1)
else
set SCT=Player(YCT)
call SetPlayerState(SCT,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(SCT,PLAYER_STATE_RESOURCE_GOLD)+$5dc)
endif
else
set ICT=UNIT_STATE_LIFE
set bST=UNIT_STATE_LIFE
call SetUnitState(WCT,ICT,GetUnitState(WCT,bST)+1.)
endif
if ptT(1,16)==1 then
call TriggerExecute(bi)
endif
if ptT(1,$64)<=8 then
set lCT=CreateUnitAtLoc(Vy,$68304335,UCT,bj_UNIT_FACING)
call UnitAddAbility(lCT,$41305857)
call IssueTargetOrder(lCT,"bloodlust",WCT)
call UnitApplyTimedLife(lCT,$42487765,2.)
endif
if GetUnitAbilityLevel(WCT,$42303258)>0 then
call SetUnitAnimation(WCT,"Spell channel five")
call TriggerExecute(Ti)
endif
call RemoveLocation(UCT)
call RemoveLocation(ECT)
set WCT=null
set wCT=null
set UCT=null
set ECT=null
set lCT=null
set ICT=null
set CCT=null
set SCT=null
set bST=null
endfunction
