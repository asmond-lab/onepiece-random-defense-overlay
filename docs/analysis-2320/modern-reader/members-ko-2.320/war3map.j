set IUT=CreateUnitAtLoc(Vy,$68304335,CUT,bET)
call UnitApplyTimedLife(IUT,$42487765,5.)
call UnitAddAbility(IUT,$41305144)
call IssueImmediateOrderById(ea[yET],OrderId("battleroar"))
endif
elseif AET==2 then
if dET==135. then
call SetUnitState(EUT,UNIT_STATE_LIFE,1.)
