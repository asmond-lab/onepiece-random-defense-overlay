function RQT takes nothing returns nothing
local integer nQT=GetPlayerId(GetTriggerPlayer())
local unit NQT=GetTriggerUnit()
local unit iQT=GetSpellTargetUnit()
local integer qQT=GetUnitTypeId(iQT)
local integer KQT=0
local player BQT=Player(nQT)
local real ZQT=GetStartLocationX(GetPlayerStartLocation(BQT))
local real fQT
set BQT=Player(nQT)
set fQT=GetStartLocationY(GetPlayerStartLocation(BQT))
if GetOwningPlayer(iQT)!=Player(7) then
call DisplayTimedTextToPlayer(Player(nQT),0.,0.,5.,"|cffff0000[오류]|r 조합식 유닛에게만 사용할 수 있습니다.")
set NQT=null
set iQT=null
set BQT=null
return
endif
if qQT!=$68303630 and qQT!=$68303350 and qQT!=$68303351 and qQT!=$68303358 and qQT!=$6830334c and qQT!=$68303355 then
call DisplayTimedTextToPlayer(Player(nQT),0.,0.,5.,"|cffff0000[오류]|r "+GetUnitName(NQT)+"가 건조할 수 있는 선박 유닛이 아닙니다.")
call IssueImmediateOrder(NQT,"stop")
set NQT=null
set iQT=null
set BQT=null
return
endif
if qQT==$68303630 then
set KQT=2
elseif qQT==$68303350 then
set KQT=10
elseif qQT==$68303351 then
set KQT=10
elseif qQT==$68303358 then
set KQT=15
elseif qQT==$6830334c then
set KQT=15
elseif qQT==$68303355 then
set KQT=20
endif
if KQT>0 then
if GetPlayerState(Player(nQT),PLAYER_STATE_RESOURCE_LUMBER)<KQT then
call DisplayTimedTextToPlayer(Player(nQT),0.,0.,10.,"|cffff0000[오류]|r |cff20b2aa"+GetUnitName(iQT)+"|r을 건조하려면 |cff7ad823"+I2S(KQT)+"목재|r가 필요합니다.")
call IssueImmediateOrder(NQT,"stop")
set NQT=null
set iQT=null
set BQT=null
return
endif
call SetPlayerState(Player(nQT),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(Player(nQT),PLAYER_STATE_RESOURCE_LUMBER)-KQT)
call CreateUnit(Player(nQT),qQT,ZQT,fQT,bj_UNIT_FACING)
call DisplayTimedTextToPlayer(Player(nQT),0.,0.,10.,"|cff04ffc4[알림]|r "+GetUnitName(NQT)+"가 |cff20b2aa"+GetUnitName(iQT)+"|r을 건조했습니다!")
call UnitRemoveAbility(NQT,$41304449)
set NQT=null
set iQT=null
set BQT=null
return
endif
set NQT=null
set iQT=null
set BQT=null
