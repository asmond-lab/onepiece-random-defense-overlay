call UnitDamagePointLoc(mET,.0,650.,SUT,2500000.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endif
endif
endif
call TriggerExecute(ma)
if ptT(1,$64)<=FET then
call TriggerExecute(da)
endif
