call TriggerAddAction(SGT,CGT)
set SGT=null
set bXT=null
endfunction
function TimerUtils__init takes nothing returns nothing
local integer i_1=0
if sT then
return
else
set sT=true
endif
set aT=InitHashtable()
loop
exitwhen i_1==$400
set GJ[i_1]=CreateTimer()
call SaveInteger(aT,0,GetHandleId(GJ[i_1]),$28829022)
set i_1=i_1+1
endloop
set PT=$400
endfunction
