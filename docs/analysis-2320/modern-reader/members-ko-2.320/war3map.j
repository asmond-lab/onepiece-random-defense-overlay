if ptT(1,$64)<=14 then
call SetUnitAnimation(lTT,"spell")
set CTT=CreateUnitAtLoc(Vy,$65303342,STT,GetUnitFacing(lTT))
call SetUnitAnimationByIndex(CTT,0)
call CreateUnitAtLoc(Vy,$65303349,byT,GetUnitFacing(lTT))
call Ymy(lTT,0.,350.,byT,80000.,1.,1.50,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
if GetUnitAbilityLevel(ITT,$41393032)<=0 and GetUnitAbilityLevel(ITT,$41393131)<=0 and GetUnitAbilityLevel(ITT,$41393033)<=0 and GetUnitAbilityLevel(ITT,$41393034)<=0 then
call OeT(lTT,ITT,GetUnitState(ITT,UNIT_STATE_LIFE)*.2*(.79+.01*I2R(GetUnitAbilityLevel(ITT,$41313153))),1.,1.,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_UNIVERSAL)
else
call OeT(lTT,ITT,150000.,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endif
endif
call RemoveLocation(STT)
call RemoveLocation(byT)
set lTT=null
set ITT=null
set CTT=null
set STT=null
set byT=null
endfunction
