function hnb takes integer Znb,string fnb returns nothing
local integer Bnb=0
local string xnb="ORDR2\\ORDR2_"+fnb+"\\"
local string Mnb=xnb+"(indice).txt"
local string vnb=xnb+"(attribute).txt"
local string Onb=fnb
local integer Rnb
local string rnb
local string Qnb
set Sb[Znb]=0
call FlushChildHashtable(bT,Znb)
if GetLocalPlayer()==Player(Znb) then
call BlzSetAbilityTooltip($415a5a5a,"{로드실패}",0)
call Preloader(Mnb)
set rnb=BlzGetAbilityTooltip($415a5a5a,0)
set Rnb=S2I(rnb)
if Rnb<0 or rnb=="{로드실패}" then
call BlzSendSyncData("CODE_LOAD","로드실패 : 저장소 데이터 없음")
return
endif
loop
exitwhen Bnb>=Rnb
set Qnb=xnb+I2S(Bnb)+".txt"
call BlzSetAbilityTooltip($415a5a5a,"{로드실패}",0)
call Preloader(Qnb)
set rnb=BlzGetAbilityTooltip($415a5a5a,0)
if rnb=="{로드실패}" then
call BlzSendSyncData("CODE_LOAD","로드실패 : 데이터 손상됨")
return
endif
call BlzSendSyncData("CODE_LADD",rnb)
set Onb=I2S(StringHash(Onb+rnb))
set Bnb=Bnb+1
endloop
call BlzSetAbilityTooltip($415a5a5a,"{로드실패}",0)
call Preloader(vnb)
set rnb=BlzGetAbilityTooltip($415a5a5a,0)
if rnb=="{로드실패}" or Onb!=rnb then
call BlzSendSyncData("CODE_LOAD","로드실패 : 무결성 손상됨")
return
endif
call BlzSendSyncData("CODE_LOAD","로드가 성공적으로 되었습니다.")
endif
endfunction
