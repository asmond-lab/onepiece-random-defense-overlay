function vrT takes integer xrT,integer MrT returns nothing
if LoadInteger(QO,0,xrT*$1b74+$11a6+MrT+2)-2==-2 then
call SaveInteger(QO,0,xrT*$1b74+$11a6+MrT+2,SO[xrT]+2)
set SO[xrT]=MrT
endif
endfunction
function jyy takes integer oyy,integer kyy,integer Lyy returns nothing
call vrT(oyy,kyy)
call RemoveSavedInteger(br,0,oyy*$1f4+kyy)
call SaveInteger(br,0,oyy*$1f4+kyy,Lyy)
endfunction
function fmT takes integer KmT,integer ZmT returns nothing
if LoadInteger(QO,0,KmT*$1b74+$dba+ZmT+2)-2==-2 then
call SaveInteger(QO,0,KmT*$1b74+$dba+ZmT+2,EO[KmT]+2)
