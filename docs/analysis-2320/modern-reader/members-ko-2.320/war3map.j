function WMy takes nothing returns nothing
local integer LMy=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
local real jMy
local real uMy
local unit pMy
if GetUnitTypeId(GetTriggerUnit())!=$65303138 then
set pMy=null
return
endif
set hF[LMy]=hF[LMy]+1
set pMy=GetTriggerUnit()
call ShowUnit(pMy,false)
call KillUnit(pMy)
call DLb(LMy,sx[7])
set jMy=pT
set uMy=WT
set bj_lastCreatedUnit=CreateUnit(Player(LMy),sx[7],jMy,uMy,bj_UNIT_FACING)
call IssueImmediateOrder(bj_lastCreatedUnit,"holdposition")
if cg[LMy]then
call UnitAddAbility(bj_lastCreatedUnit,$4130544a)
else
call UnitAddAbility(bj_lastCreatedUnit,$41303759)
endif
call DisplayTextToPlayer(Player(LMy),0.,0.,GetUnitName(bj_lastCreatedUnit)+" 획득!")
set pMy=null
endfunction
function WOb takes nothing returns boolean
return GetEventDamageSource()==LoadUnitHandle(UO,0,Yg*$1f4)
endfunction
function WPy takes nothing returns nothing
if GetWidgetLife(GetEnumUnit())<=.405 or IsUnitType(GetEnumUnit(),UNIT_TYPE_DEAD) then
set xT=true
endif
endfunction
function WQb takes nothing returns nothing
local unit oQb=GetTriggerUnit()
local player kQb=GetOwningPlayer(oQb)
local integer LQb=GetPlayerId(kQb)
local location jQb
local playerstate uQb
local integer pQb
if GetPlayerState(kQb,PLAYER_STATE_RESOURCE_FOOD_USED)<4 then
call DisplayTimedTextToPlayer(kQb,0.,0.,5.,"|cffff0000[오류]|r|cff1e90ff특성포인트|r가 부족합니다!")
call IssueImmediateOrder(oQb,"stop")
set oQb=null
set kQb=null
set jQb=null
set uQb=null
return
endif
set jQb=GetStartLocationLoc(LQb)
set UG[LQb]=CreateUnitAtLoc(Player(LQb),$68303456,jQb,bj_UNIT_FACING)
call UnitAddAbility(UG[LQb],$41313259)
call UnitAddAbility(oQb,$4131324c)
call UnitMakeAbilityPermanent(oQb,true,$4131324c)
call UnitMakeAbilityPermanent(oQb,true,$4131324e)
call UnitMakeAbilityPermanent(oQb,true,$4131324f)
call UnitMakeAbilityPermanent(oQb,true,$41313252)
call UnitMakeAbilityPermanent(oQb,true,$41313251)
call SetPlayerAbilityAvailable(kQb,$41304f54,false)
set wG[LQb]=0
set uQb=PLAYER_STATE_RESOURCE_FOOD_USED
set LQb=GetPlayerState(kQb,PLAYER_STATE_RESOURCE_FOOD_USED)-4
set pQb=GetPlayerState(kQb,uQb)
call AdjustPlayerStateBJ(LQb-pQb,kQb,uQb)
call RemoveLocation(jQb)
set oQb=null
set kQb=null
set jQb=null
set uQb=null
