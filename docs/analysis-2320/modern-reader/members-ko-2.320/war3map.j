function WcF takes nothing returns nothing
local unit kcF=GetEventDamageSource()
local unit LcF=GetTriggerUnit()
local player jcF=GetOwningPlayer(kcF)
local unitstate pcF=UNIT_STATE_MAX_LIFE
local real ucF=GetUnitState(LcF,pcF)
if not Nf then
set Nf=true
call TimerStart(nf,.25,true,J7)
endif
if Xf!=ucF then
set Xf=ucF
if af<ucF then
else
set Pf=Pf*(ucF/af)
endif
set af=ucF
endif
set Pf=Pf+GetEventDamage()
set pcF=UNIT_STATE_MAX_LIFE
if GetUnitState(LcF,pcF)>=Pf then
if GetPlayerController(jcF)==MAP_CONTROL_USER then
set sf[GetPlayerId(jcF)]=sf[GetPlayerId(jcF)]+GetEventDamage()
else
set sf[GetUnitUserData(kcF)]=sf[GetUnitUserData(kcF)]+GetEventDamage()
endif
else
set ucF=Pf-ucF
set ucF=GetEventDamage()-ucF
if GetPlayerController(jcF)==MAP_CONTROL_USER then
set sf[GetPlayerId(jcF)]=sf[GetPlayerId(jcF)]+ucF
else
set sf[GetUnitUserData(kcF)]=sf[GetUnitUserData(kcF)]+ucF
endif
endif
set kcF=null
set LcF=null
set jcF=null
set pcF=null
endfunction
