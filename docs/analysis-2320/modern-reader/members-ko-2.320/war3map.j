function ARb takes integer CBb,integer SBb,real bRb,real TRb,real yRb,real FRb,boolean gRb returns nothing
if gRb then
set UQ[CBb]=Ifb(SBb,"GUICommandButton__CommandButton icon")
else
set UQ[CBb]=Dfy(SBb,"GUICommandButton__CommandButton icon")
endif
call l6b(UQ[CBb],bRb,TRb)
call v2b(UQ[CBb],Tb,SBb,Tb,yRb,FRb)
set EQ[CBb]=hQT(UQ[CBb],"GUICommandButton__CommandButton text1")
call TkT(EQ[CBb],"Fonts\\esamanruMedium.ttf",20.)
call v2b(EQ[CBb],4,UQ[CBb],4,0.,0.)
call K8T(EQ[CBb],false)
if CBb==0 then
set lQ[CBb]=iqy(UQ[CBb],"GUICommandButton__CommandButton button")
else
set lQ[CBb]=KfT(UQ[CBb],"GUICommandButton__CommandButton button")
endif
call l6b(lQ[CBb],bRb,TRb)
call v2b(lQ[CBb],4,UQ[CBb],4,0.,0.)
call SaveInteger(yb,0,lQ[CBb],CBb)
call tAy(lQ[CBb],iu)
call eyF(lQ[CBb],qu)
call why(lQ[CBb],Ku)
endfunction
