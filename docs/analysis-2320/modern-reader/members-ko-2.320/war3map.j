function fby takes nothing returns nothing
local unit iby=GetAttacker()
local unit qby=GetTriggerUnit()
local unit Kby
local location Zby
if GetUnitState(iby,UNIT_STATE_MANA)>=90. then
call SetUnitState(iby,UNIT_STATE_MANA,.0)
call TriggerExecute(vP)
else
call SetUnitState(iby,UNIT_STATE_MANA,GetUnitState(iby,UNIT_STATE_MANA)+1.)
endif
if ptT(1,$64)<=11 then
set Zby=GetUnitLoc(qby)
set Kby=CreateUnitAtLoc(Vy,$65304157,Zby,GetRandomReal(0.,360.))
call SetUnitScale(Kby,.8,1.,1.)
call UnitApplyTimedLife(Kby,$42487765,1.)
set Kby=CreateUnitAtLoc(Vy,$6530415a,Zby,GetRandomReal(0.,360.))
call SetUnitScale(Kby,1.2,1.,1.)
call UnitApplyTimedLife(Kby,$42487765,1.)
call UnitDamagePointLoc(gg[GetPlayerId(GetOwningPlayer(iby))],0.,475.,Zby,220000.+I2R(GetHeroStatBJ(bj_HEROSTAT_AGI,iby,true))*2000.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
if GetUnitAbilityLevel(qby,$41393032)>0 or GetUnitAbilityLevel(qby,$41393131)>0 then
call OeT(gg[GetPlayerId(GetOwningPlayer(iby))],qby,GetUnitState(qby,UNIT_STATE_MAX_LIFE)*.02,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
elseif GetUnitAbilityLevel(qby,$41393033)>0 then
call OeT(gg[GetPlayerId(GetOwningPlayer(iby))],qby,GetUnitState(qby,UNIT_STATE_MAX_LIFE)*.01*4.4,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endif
endif
set iby=null
set qby=null
set Kby=null
set Zby=null
endfunction
