function Aay takes nothing returns nothing
local unit CXy=GetTriggerUnit()
local player SXy=GetOwningPlayer(CXy)
local location bay=GetSpellTargetLoc()
local integer Tay=GetPlayerId(SXy)
local integer yay=GetSpellAbilityId()
local integer Fay
local integer gay
if wG[Tay]>=3 then
call DisplayTimedTextToPlayer(Player(Tay),0.,0.,5.,"이미 최대치로 설치했습니다.")
call IssueImmediateOrder(CXy,"stop")
set CXy=null
set SXy=null
set bay=null
return
endif
if yay==$4131324e then
set Fay=$68303850
set gay=5
elseif yay==$4131324f then
set Fay=$6830394a
set gay=4
elseif yay==$41313252 then
set Fay=$68303950
set gay=3
elseif yay==$41313251 then
set Fay=$6830394f
set gay=3
endif
if GetPlayerState(SXy,PLAYER_STATE_RESOURCE_LUMBER)<gay then
call DisplayTimedTextToPlayer(SXy,0.,0.,5.,"|cffFF8200|cff7ad823목재|r가 부족합니다!|r")
call IssueImmediateOrder(CXy,"stop")
set CXy=null
set SXy=null
set bay=null
return
endif
set CXy=CreateUnitAtLoc(SXy,Fay,bay,bj_UNIT_FACING)
if Fay==$68303950 then
set WG=CXy
call TriggerExecute(pG)
endif
call DisplayTimedTextToPlayer(SXy,0.,0.,5.,"|cffff8200수상한 씨앗 상자|r로 |cffc0c0c0"+GetUnitName(CXy)+"|r 설치!")
call SetPlayerState(SXy,PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(SXy,PLAYER_STATE_RESOURCE_LUMBER)-gay)
set wG[Tay]=wG[Tay]+1
call RemoveLocation(bay)
set CXy=null
set SXy=null
set bay=null
endfunction
