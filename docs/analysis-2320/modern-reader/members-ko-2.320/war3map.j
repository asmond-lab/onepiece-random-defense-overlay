call OeT(mET,lUT,GetUnitState(lUT,DET)*.33,1.,1.,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
endif
endif
call RemoveLocation(CUT)
call RemoveLocation(SUT)
set EUT=null
set lUT=null
set IUT=null
set CUT=null
set SUT=null
set TET=null
set mET=null
set VET=null
set DET=null
set eET=null
endfunction
