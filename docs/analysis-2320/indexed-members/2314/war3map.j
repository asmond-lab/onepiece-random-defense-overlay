call f6N(LoadUnitHandle(gp,0,sP*$1f4),bj_lastPlayedSound)
call UnitDamagePointLoc(LoadUnitHandle(gp,0,sP*$1f4+2),.0,375.,LoadLocationHandle(yp,0,sP*$1f4+1),16000.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
call UfN(LoadUnitHandle(gp,0,sP*$1f4+2),LoadUnitHandle(gp,0,sP*$1f4+1),50000.,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
