call TriggerExecute(md)
set iGw=CreateUnit(nGw,$68303536,GetRectCenterX(Ww[GetPlayerId(nGw)]),GetRectCenterY(Ww[GetPlayerId(nGw)]),bj_UNIT_FACING)
call UnitRemoveAbility(iGw,$416d6f76)
elseif not UnitHasBuffBJ(OGw,$42303338) then
if RFN(QGw) or GetUnitAbilityLevel(QGw,$41393033)>0 then
