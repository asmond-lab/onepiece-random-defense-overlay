function VVE takes nothing returns nothing
local unit bVE=GetEventDamageSource()
local unit fVE=GetTriggerUnit()
local player xVE=GetOwningPlayer(bVE)
local real lVE=GetUnitStateSwap(UNIT_STATE_MAX_LIFE,fVE)
local real KVE
local real IVE
local integer LVE
if not Em then
set Em=true
set LVE=0
set Nm=CreateTrigger()
loop
exitwhen LVE>=4
call TriggerRegisterPlayerChatEvent(Nm,Player(LVE),"-기여도",true)
call TriggerRegisterPlayerChatEvent(Nm,Player(LVE),"-contribution",true)
call TriggerRegisterPlayerChatEvent(Nm,Player(LVE),"ㄱㅇㄷ",true)
call TriggerRegisterPlayerChatEvent(Nm,Player(LVE),"rde",true)
set LVE=LVE+1
endloop
call TriggerAddAction(Nm,jv)
endif
if iu!=lVE then
set iu=lVE
if Au<lVE then
set Au=lVE
else
set vu=vu*(lVE/Au)
set Au=lVE
endif
endif
set vu=vu+GetEventDamage()
if GetUnitStateSwap(UNIT_STATE_MAX_LIFE,fVE)>=vu then
if GetPlayerController(xVE)==MAP_CONTROL_USER then
set Gm[GetPlayerId(xVE)]=Gm[GetPlayerId(xVE)]+GetEventDamage()
else
set Gm[GetUnitUserData(bVE)]=Gm[GetUnitUserData(bVE)]+GetEventDamage()
endif
else
set KVE=vu-lVE
set IVE=GetEventDamage()-KVE
if GetPlayerController(xVE)==MAP_CONTROL_USER then
set Gm[GetPlayerId(xVE)]=Gm[GetPlayerId(xVE)]+IVE
else
set Gm[GetUnitUserData(bVE)]=Gm[GetUnitUserData(bVE)]+IVE
endif
endif
set bVE=null
set fVE=null
set xVE=null
endfunction
function V_E takes nothing returns nothing
local unit K_E=GetTriggerUnit()
local player I_E=GetOwningPlayer(K_E)
local location L_E=GetSpellTargetLoc()
