function UsG takes nothing returns nothing
local player SsG=Player(lG)
local integer JsG=IG
local integer XsG=LG
local integer csG=wE[GetPlayerId(SsG)]
local integer osG=0
local real RsG
local real BsG
local unit asG
if VN then
set RsG=ZN
set BsG=eN
else
set RsG=GetPlayerStartLocationX(SsG)
set BsG=GetPlayerStartLocationY(SsG)
endif
loop
exitwhen osG==XsG
set asG=CreateUnit(SsG,JsG,RsG,BsG,bj_UNIT_FACING)
call aQG(csG,asG)
call GroupAddUnit(DN,asG)
set osG=osG+1
endloop
set SsG=null
set asG=null
endfunction
function UuE takes nothing returns nothing
local unit cuE=GetTriggerUnit()
local player RuE=GetOwningPlayer(cuE)
local playerstate BuE
local integer auE
local integer ouE
if GetPlayerState(RuE,PLAYER_STATE_RESOURCE_FOOD_USED)<4 then
call DisplayTimedTextToPlayer(RuE,0.,0.,5.,"|cffff0000[오류]|r|cff1e90ff특성포인트|r가 부족합니다!")
call IssueImmediateOrderBJ(cuE,"stop")
set cuE=null
set RuE=null
set BuE=null
return
endif
call SetUnitAbilityLevelSwapped($4130424d,cuE,2)
call SetPlayerAbilityAvailable(RuE,$4130434b,false)
set BuE=PLAYER_STATE_RESOURCE_FOOD_USED
set auE=GetPlayerState(RuE,PLAYER_STATE_RESOURCE_FOOD_USED)-4
set ouE=GetPlayerState(RuE,BuE)
call AdjustPlayerStateBJ(auE-ouE,RuE,BuE)
set cuE=null
set RuE=null
set BuE=null
endfunction
function UuG takes nothing returns nothing
local unit XuG=GetAttacker()
local unit cuG=GetTriggerUnit()
local location auG=GetUnitLoc(cuG)
local integer ouG=GetUnitTypeId(XuG)
local unit RuG
local real BuG
if ouG==$68304242 then
if rcw(1,5)==2 then
call SWw(XuG,0.,475.,auG,200000.,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
set RuG=CreateUnitAtLoc(ON,$65303447,auG,bj_UNIT_FACING)
call UnitApplyTimedLife(RuG,$42487765,1.)
set RuG=CreateUnitAtLoc(ON,$68304335,auG,bj_UNIT_FACING)
call UnitAddAbility(RuG,$41313457)
call UnitApplyTimedLife(RuG,$42487765,1.)
call IssuePointOrderById(RuG,OrderId("dreadlordinferno"),GetLocationX(auG),GetLocationY(auG))
endif
elseif ouG==$68304241 then
if rcw(1,20)<=9 then
if RFN(cuG) then
set BuG=GetUnitStateSwap(UNIT_STATE_MAX_LIFE,cuG)*1.*.01
elseif GetUnitAbilityLevel(cuG,$41393033)>0 then
set BuG=GetUnitStateSwap(UNIT_STATE_MAX_LIFE,cuG)*4.*.01
else
set BuG=0.
endif
call UfN(XuG,cuG,BuG+100000.,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endif
endif
call RemoveLocation(auG)
set XuG=null
set cuG=null
set RuG=null
set auG=null
endfunction
