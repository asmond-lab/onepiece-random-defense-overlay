function AJE takes nothing returns nothing
local player OJE=GetTriggerPlayer()
local item QJE=GetManipulatedItem()
local unit nJE=GetTriggerUnit()
local integer YJE=GetPlayerId(OJE)
local integer iJE
if Rg[YJE]==3 then
set OJE=null
set QJE=null
set nJE=null
return
endif
call SetItemCharges(QJE,GetItemCharges(QJE)+1)
if rcw(1,5)<=2 then
set iJE=1
else
set iJE=2
endif
call SetItemCharges(QJE,GetItemCharges(QJE)+iJE)
if GetItemCharges(QJE)>=30 then
call SetItemCharges(QJE,30)
call DisplayTimedTextToPlayer(OJE,0.,0.,5.,"|cffFF0000[시스템]|r '유니언 아르마다 :: 공격력' 스택이 최대치에 도달했습니다.")
else
call DisplayTimedTextToPlayer(OJE,0.,0.,5.,"|cffFF0000[시스템]|r '유니언 아르마다 :: 공격력' 스택이 "+I2S(iJE)+"개 상승했습니다.")
endif
if Rg[YJE]==1 then
if GetItemCharges(QJE)>=15 then
call SetUnitAbilityLevel(nJE,$4130574c,2)
call SetUnitAbilityLevel(nJE,$41305751,2)
set Rg[YJE]=2
call DisplayTimedTextToPlayer(OJE,0.,0.,5.,"|cffFF0000[레벨업]|r 유니크로 등급 업!")
if DCE(YJE) then
call SetUnitAbilityLevel(nJE,$41305755,2)
call DisplayTimedTextToPlayer(OJE,0.,0.,5.,"|cffffe100[유니크]|r 모든 스킬이 유니크 달성! '데어 슈테르크슈테 스트라이크' 레벨업")
endif
endif
elseif Rg[YJE]==2 then
if GetItemCharges(QJE)>=30 then
call SetUnitAbilityLevel(nJE,$4130574c,3)
call SetUnitAbilityLevel(nJE,$41305751,3)
set Rg[YJE]=3
call DisplayTimedTextToPlayer(OJE,0.,0.,5.,"|cffFF0000[레벨업]|r 레전더리로 등급 업!")
if bMw(YJE) then
call SetUnitAbilityLevel(nJE,$41305755,3)
call DisplayTimedTextToPlayer(OJE,0.,0.,5.,"|cff5eff00[레전더리]|r 모든 스킬이 레전더리 달성! '데어 슈테르크슈테 스트라이크' 레벨업")
endif
call UnitRemoveItemFromSlot(nJE,0)
call RemoveItem(QJE)
call UnitAddItemToSlotById(nJE,$49303036,0)
endif
endif
set OJE=null
set QJE=null
set nJE=null
endfunction
