function HcE takes integer qcE returns integer
if qcE==$6830344a then
return $4130554e
elseif qcE==$68303439 then
return $41305553
elseif qcE==$68303446 then
return $41305552
elseif qcE==$68303441 then
return $4130554e
elseif qcE==$68303443 then
return $41305553
elseif qcE==$68303445 or qcE==$6830424d then
return $4130554e
elseif qcE==$68303442 then
return $41305555
elseif qcE==$68303444 then
return $41305552
elseif qcE==$68303447 then
return $41305553
elseif qcE==$6830374d or qcE==$68304144 then
return $41305556
elseif qcE==$68303451 then
return $41305557
elseif qcE==$68303831 then
return $41305552
endif
return 0
endfunction
function UHE takes integer aHE returns integer
local integer oHE=LoadInteger(J,aHE,0)
if oHE==0 then
return aHE
endif
return oHE
endfunction
function AXN takes unit kXN,integer OXN,integer QXN returns nothing
local integer nXN=0
local integer YXN
local integer iXN
loop
exitwhen nXN>=7
if LoadInteger(qP[OXN],UHE(QXN),tP[nXN])==2 then
if GetUnitAbilityLevel(kXN,$41393035)>0 then
set YXN=HcE(GetUnitTypeId(kXN))
call UnitAddAbility(kXN,YXN)
call UnitMakeAbilityPermanent(kXN,true,YXN)
else
set iXN=pP[nXN]
call UnitAddAbility(kXN,iXN)
call UnitMakeAbilityPermanent(kXN,true,iXN)
endif
endif
set nXN=nXN+1
endloop
endfunction
function YkG takes unit QkG returns nothing
local integer nkG=0
loop
exitwhen nkG>=7
if GetUnitAbilityLevel(QkG,$41393035)>0 then
call UnitRemoveAbility(QkG,HcE(GetUnitTypeId(QkG)))
else
call UnitRemoveAbility(QkG,pP[nkG])
endif
set nkG=nkG+1
endloop
endfunction
