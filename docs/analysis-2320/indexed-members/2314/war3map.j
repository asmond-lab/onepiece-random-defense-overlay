function LbN takes nothing returns nothing
local integer bbN=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
local integer fbN
local unit xbN
local player lbN
local player KbN
local integer IbN
if GetUnitTypeId(GetTriggerUnit())!=$65304958 then
set xbN=null
set lbN=null
set KbN=null
return
endif
set xbN=GetTriggerUnit()
call ShowUnit(xbN,false)
call KillUnit(xbN)
set Gw[bbN]=Gw[bbN]+1
if rcw(1,$64)>33 then
set lbN=Player(bbN)
call SetPlayerState(lbN,PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(lbN,PLAYER_STATE_RESOURCE_LUMBER)+1)
call DisplayTimedTextToPlayer(Player(bbN),0.,0.,3.,"|cff7ad8231 목재 획득!|r")
set Nw[bbN]=Nw[bbN]+1
else
set fbN=75*OG
call DisplayTimedTextToPlayer(Player(bbN),0.,0.,3.,"|cffffd700"+I2S(fbN)+" 골드 획득!|r")
set KbN=Player(bbN)
set IbN=fbN
call SetPlayerState(KbN,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(KbN,PLAYER_STATE_RESOURCE_GOLD)+IbN)
endif
set xbN=null
set lbN=null
set KbN=null
endfunction
