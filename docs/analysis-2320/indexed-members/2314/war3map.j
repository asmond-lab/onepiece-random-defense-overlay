endif
if rcw(1,$64)<=15 then
call IssueTargetOrder(sd[GetPlayerId(nGw)],"firebolt",QGw)
call UfN(YGw,QGw,102500.,1.,1.,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL)
