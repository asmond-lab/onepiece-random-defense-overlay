function GtE takes nothing returns nothing
local integer iFE=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
local integer AFE=20+R2I(I2R(OG)*1.5)
local unit vFE
if GetUnitTypeId(GetTriggerUnit())!=$65304958 then
set vFE=null
return
endif
set vFE=GetTriggerUnit()
call ShowUnit(vFE,false)
call KillUnit(vFE)
if AFE>$64 then
set AFE=$64
endif
call SetUnitState(Zw[iFE],UNIT_STATE_MANA,(GetUnitState(Zw[iFE],UNIT_STATE_MANA)+AFE)*1.)
call DisplayTimedTextToPlayer(Player(iFE),0.,0.,3.,"도움소의 현재 마나 : |cff51ddf5"+I2S(R2I(GetUnitState(Zw[iFE],UNIT_STATE_MANA)))+"|r")
set vFE=null
endfunction
