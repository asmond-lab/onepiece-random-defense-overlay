set Uy[qFN]=1
call UnitAddAbility(hFN,$4131305a)
call UnitAddAbility(hFN,$41313131)
call UnitAddAbility(hFN,$41313132)
call UnitRemoveAbility(hFN,$41305842)
call UnitRemoveAbility(hFN,$41305838)
call SetUnitAbilityLevel(hFN,$41305841,2)
if GetLocalPlayer()==Player(qFN) then
call SetCineFilterTexture("ReplaceableTextures\\CameraMasks\\Black_mask.blp")
call SetCineFilterBlendMode(BLEND_MODE_BLEND)
call SetCineFilterStartUV(0.,0.,2.,2.)
call SetCineFilterEndUV(0.,0.,2.,2.)
call SetCineFilterStartColor($ff,$ff,$ff,$ff)
call SetCineFilterEndColor($ff,$ff,$ff,0)
call SetCineFilterDuration(3.)
call DisplayCineFilter(true)
endif
call ZxG(Player(qFN),"|cffff0000당신은 죄악이 등을 타고 오르는 것을 느꼈다|r",0.,-50.,0.,3.,3.)
call StartSound(Qbw("SE\\SansAwaken2.mp3",null,$7f,1.,false,0.,0.))
else
call F9w(ay[rcw(1,29)],hFN,qFN)
call kSw(Player(qFN),"SE\\SansTalker.wav",null,$7f,1.)
endif
endfunction
