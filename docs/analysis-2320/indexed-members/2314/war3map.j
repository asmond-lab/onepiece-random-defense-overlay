function R_P takes integer G_P,string N_P,integer E_P returns nothing
local integer w_P
local string P_P
local integer M_P
local integer S_P
local integer J_P
local string X_P
local integer c_P
if E_P>1 then
if GetLocalPlayer()==Player(G_P) then
set w_P=tM[G_P]
set P_P=N_P
call BlzFrameSetText(LoadFrameHandle(wG,0,w_P),P_P)
set M_P=FM
call BlzFrameSetVisible(LoadFrameHandle(wG,0,M_P),true)
set S_P=ep
call BlzFrameSetVisible(LoadFrameHandle(wG,0,S_P),true)
endif
elseif GetLocalPlayer()==Player(G_P) then
set J_P=tM[G_P]
set X_P=N_P
call BlzFrameSetText(LoadFrameHandle(wG,0,J_P),X_P)
set c_P=FM
call BlzFrameSetVisible(LoadFrameHandle(wG,0,c_P),true)
endif
endfunction
function XTw takes integer PTw,boolean MTw returns nothing
local integer STw
local integer JTw
if MTw then
if GetLocalPlayer()==Player(PTw) then
set STw=ep
call BlzFrameSetVisible(LoadFrameHandle(wG,0,STw),true)
endif
elseif GetLocalPlayer()==Player(PTw) then
set JTw=ep
call BlzFrameSetVisible(LoadFrameHandle(wG,0,JTw),false)
endif
endfunction
function Z4w takes integer K4w,boolean I4w returns nothing
local integer L4w
local integer V4w
if I4w then
if GetLocalPlayer()==Player(K4w) then
set L4w=Lp
call BlzFrameSetVisible(LoadFrameHandle(wG,0,L4w),true)
endif
elseif GetLocalPlayer()==Player(K4w) then
set V4w=Lp
call BlzFrameSetVisible(LoadFrameHandle(wG,0,V4w),false)
endif
endfunction
function ZtN takes integer LtN,real VtN returns nothing
if GetLocalPlayer()==Player(LtN) then
call oWw(FM,600.,140.+20.*VtN)
endif
endfunction
function cyw takes integer Jyw returns nothing
local integer Xyw
if GetLocalPlayer()==Player(Jyw) then
set Xyw=FM
call BlzFrameSetVisible(LoadFrameHandle(wG,0,Xyw),false)
endif
endfunction
function yKw takes integer gKw returns nothing
local integer TKw=0
loop
exitwhen TKw>=50
if Ty[gKw*50+TKw]!=null then
call DestroyTextTag(Ty[gKw*50+TKw])
set Ty[gKw*50+TKw]=null
endif
set TKw=TKw+1
endloop
endfunction
function VQE takes nothing returns nothing
local integer mQE=GetPlayerId(GetTriggerPlayer())
local unit sQE=GetTriggerUnit()
local player qQE
local integer HQE
local integer hQE
local integer FQE
local integer tQE
local integer pQE
local integer jQE
local integer WQE
local integer CQE
local integer bQE
local integer fQE
local integer xQE
local integer lQE
local integer KQE
local string IQE
local boolean LQE
if (not IsUnitOwnedByPlayer(sQE,Player(7)))or(not HaveSavedInteger(wS,GetUnitTypeId(sQE),-1)) then
set sQE=null
set qQE=null
return
endif
if not yy[mQE]then
set yy[mQE]=true
set uy[mQE]=GetTriggerUnit()
set sQE=GetTriggerUnit()
set qQE=GetTriggerPlayer()
set LQE=false
set HQE=GetUnitTypeId(sQE)
set hQE=GetPlayerId(qQE)
set FQE=0
set tQE=LoadInteger(wS,HQE,-1)
if not FE[hQE]then
set LQE=true
endif
if not LQE then
set sy[hQE]=tQE
set qy[hQE]=tQE
loop
exitwhen LQE or((not LQE)and FQE==tQE)
if not LQE then
set pQE=HQE
set jQE=FQE
set WQE=LoadInteger(wS,HQE,FQE)
set CQE=GetPlayerId(qQE)
set bQE=0
set fQE=0
set lQE=LoadInteger(HG,WQE,3)
set IQE=GetObjectName(HQE)+"|r\n\n"
set Hy[FQE]=0
if HaveSavedInteger(wS,HQE,-2) then
set IQE=IQE+"|cff7ad823조합 타이핑|r\n"
loop
exitwhen fQE==LoadInteger(wS,pQE,-2)
set IQE=IQE+"  \""+LoadStr(wS,pQE,fQE)+"\"\n"
set Hy[jQE]=Hy[jQE]+1
set fQE=fQE+1
endloop
set IQE=IQE+"\n"
endif
loop
exitwhen bQE>=lQE
set fQE=LoadInteger(pG,WQE,bQE)
set pQE=LoadInteger(jG,WQE,bQE)
set KQE=LoadInteger(WG,WQE,bQE)
if fQE==$5049434b then
set IQE=IQE+"  |cffFFFA78▶|r  |cffFF0000랜덤전용유닛 1기\n"
set Hy[jQE]=Hy[jQE]+1
elseif fQE==$554e4954 then
set xQE=0
loop
exitwhen xQE>=KQE
set IQE=IQE+"  |cffFFFA78▶|r  "+GetObjectName(pQE)+"\n"
set xQE=xQE+1
set Hy[jQE]=Hy[jQE]+1
endloop
elseif fQE==$474f4c44 then
set IQE=IQE+"  |cffFFFA78▶|r  |cffffd700"+I2S(KQE)+"|r 골드\n"
set Hy[jQE]=Hy[jQE]+1
elseif fQE==$574f4f44 then
set IQE=IQE+"  |cffFFFA78▶|r  |cff7ad823"+I2S(KQE)+"|r 목재\n"
set Hy[jQE]=Hy[jQE]+1
elseif fQE==$49464354 then
set IQE=IQE+"  |cffFFFA78▶|r  |cff7ad823"+I2S(KQE+PE[CQE])+"|r 목재 (기본 : "+I2S(KQE)+" / 증가량 : "+I2S(PE[CQE])+")\n"
set Hy[jQE]=Hy[jQE]+1
elseif fQE==$534b5054 then
set IQE=IQE+"  |cffFFFA78▶|r  |cff1e90ff"+I2S(KQE)+"|r 특성포인트\n"
set Hy[jQE]=Hy[jQE]+1
elseif fQE==$4954454d then
set IQE=IQE+"  |cffFFFA78▶|r  아이템 : "+GetObjectName(pQE)+"\n"
set Hy[jQE]=Hy[jQE]+1
elseif fQE==$43484354 then
set IQE=IQE+"  |cffFFFA78▶|r  |cffff0080"+I2S(KQE)+"|r 변화가능 횟수\n"
set Hy[jQE]=Hy[jQE]+1
elseif fQE==$524d4158 then
set IQE=IQE+"  |cffFFFA78▶|r  |cffff0000"+I2S(KQE)+"라운드|r 까지만 조합 가능\n"
set Hy[jQE]=Hy[jQE]+1
elseif fQE==$53504543 or fQE==$5244554e then
set IQE=IQE+"  |cffFFFA78▶|r  "+GetAbilityEffectById(pQE,EFFECT_TYPE_CASTER,0)+"\n"
set Hy[jQE]=Hy[jQE]+1
elseif fQE==$4752454e then
set IQE=IQE+"  |cffFFFA78▶|r  |cffff8200기록지침 :: |r|ce32bb454[그린블러드]|r (신모드 이상에서 입수 가능)\n"
set Hy[jQE]=Hy[jQE]+1
endif
set bQE=bQE+1
endloop
set IQE=IQE+"\n|cffffdead◈|r 조합식 유닛을 |cffff0000더블클릭|r 하면\n　 하위 조합식을 눈으로 확인 가능합니다.\n"
set hy[CQE*50+jQE]=IQE
set FQE=FQE+1
endif
endloop
call ZtN(hQE,Hy[tQE-1])
call Z4w(hQE,false)
call XTw(hQE,false)
call R_P(hQE,hy[hQE*50+tQE-1],tQE)
endif
call FZw(mQE)
call TimerStart(ry[mQE],.5,false,FA)
else
if uy[mQE]!=GetTriggerUnit() then
set yy[mQE]=false
set uy[mQE]=null
set sQE=null
set qQE=null
return
endif
set yy[mQE]=false
set uy[mQE]=null
set qQE=GetTriggerPlayer()
set HQE=GetPlayerId(qQE)
if gy[HQE]==null then
set gy[HQE]=CreateGroup()
endif
call ForGroup(gy[HQE],tA)
call yKw(HQE)
call GroupClear(gy[HQE])
set sQE=GetTriggerUnit()
set qQE=GetTriggerPlayer()
set HQE=GetUnitTypeId(sQE)
set hQE=GetPlayerId(qQE)
set FQE=0
set tQE=LoadInteger(wS,HQE,-1)
set my=0
loop
exitwhen FQE==tQE
call KxN(qQE,HQE,FQE)
set FQE=FQE+1
endloop
set bj_lastCreatedUnit=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE),HQE,GetRectCenterX(bw[hQE]),GetRectCenterY(bw[hQE]),bj_UNIT_FACING)
call UnitAddAbility(bj_lastCreatedUnit,$41657468)
call SetUnitX(bj_lastCreatedUnit,GetRectCenterX(bw[hQE]))
call SetUnitY(bj_lastCreatedUnit,GetRectCenterY(bw[hQE]))
call GroupAddUnit(gy[hQE],bj_lastCreatedUnit)
call cyw(hQE)
if GetUnitAbilityLevel(GetTriggerUnit(),$41383031)==0 then
call SetCameraPositionForPlayer(GetTriggerPlayer(),GetRectCenterX(bw[mQE]),GetRectCenterY(bw[mQE]))
endif
endif
set sQE=null
set qQE=null
endfunction
