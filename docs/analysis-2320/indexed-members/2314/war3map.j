endif
if jF[sP]==1 then
if LoadInteger(sp,0,sP*$1f4)<6 then
call Y5G(sP,2,PolarProjectionBJ(LoadLocationHandle(yp,0,sP*$1f4+1),250.,60.*I2R(LoadInteger(sp,0,sP*$1f4))))
call SgN(sP,10,CreateUnitAtLoc(ON,$65304d37,LoadLocationHandle(yp,0,sP*$1f4+2),AngleBetweenPoints(LoadLocationHandle(yp,0,sP*$1f4+2),LoadLocationHandle(yp,0,sP*$1f4+1))))
