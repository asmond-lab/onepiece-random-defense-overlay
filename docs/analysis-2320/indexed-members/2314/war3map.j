function OMw takes real eMw returns real
local real kMw=.832+.168
local real DMw
if eMw<=.183 then
set DMw=Hkw(.0,1.195313,eMw/.183)
elseif eMw<=.334 then
set DMw=Hkw(1.195313,1.,(eMw-.183)/.151)
elseif eMw<=.667 then
set DMw=1.
elseif eMw<=.832 then
set DMw=Hkw(1.,1.062500,(eMw-.667)/.165)
elseif eMw<=kMw then
set DMw=Hkw(1.062500,1.,(eMw-.832)/.168)
elseif eMw<=4.333 then
set DMw=1.
elseif eMw<=4.667000294 then
set DMw=Hkw(1.,1.195313,(eMw-4.333)/.334)
elseif eMw<=4.853 then
set DMw=1.195313
else
set DMw=Hkw(1.195313,.0,(eMw-4.853)/.147)
endif
if DMw<.0 then
set DMw=.0
endif
return DMw
endfunction
function ZBN takes real VBN returns real
if VBN<=.334 then
return Hkw(.0,1.,VBN/.334)
endif
if VBN<=4.333 then
return 1.
endif
if VBN<=4.667000294 then
return Hkw(1.,.481157,(VBN-4.333)/.334)
endif
if VBN<=4.853 then
return .481157
endif
return Hkw(.481157,.0,(VBN-4.853)/.147)
endfunction
