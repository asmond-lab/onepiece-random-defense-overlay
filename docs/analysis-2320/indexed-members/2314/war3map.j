call UnitDamagePointLoc(u5G,.0,500.,s5G,13000.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endif
call RemoveLocation(s5G)
set u5G=null
set m5G=null
set s5G=null
set q5G=null
endfunction
