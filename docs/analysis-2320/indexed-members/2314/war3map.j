call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5.,GetPlayerName(Player(GfE))+"님이 |cff00ced1보물상자|r를 발견하여 |cffffd700"+GetObjectName($65304958)+"|r "+I2S(PfE)+"기 획득!|r")
call B9w(Player(GfE),PfE)
