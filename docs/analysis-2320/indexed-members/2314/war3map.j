set H3G=ZV
call GroupEnumUnitsInRangeOfLoc(GS[s3G],u3G,450.,q3G)
call ForGroup(GS[s3G],H3G)
set h3G=T3G
call GroupClear(GS[h3G])
call taG(h3G)
endif
call RemoveLocation(u3G)
call RemoveLocation(m3G)
set y3G=null
set r3G=null
set u3G=null
set m3G=null
set q3G=null
endfunction
