function U1N takes nothing returns nothing
local integer R1N=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
local real B1N=GetPlayerStartLocationX(Player(R1N))
local real a1N=GetPlayerStartLocationY(Player(R1N))
local unit o1N
if GetUnitTypeId(GetTriggerUnit())!=$65303141 then
set o1N=null
return
endif
set o1N=GetTriggerUnit()
call ShowUnit(o1N,false)
call KillUnit(o1N)
set bj_lastCreatedUnit=CreateUnit(Player(R1N),$68303453,B1N,a1N,bj_UNIT_FACING)
call IssueImmediateOrder(bj_lastCreatedUnit,"holdposition")
call DisplayTextToPlayer(Player(R1N),0.,0.,GetUnitName(bj_lastCreatedUnit)+" 획득!")
set o1N=null
endfunction
function U1P takes nothing returns nothing
local unit R1P=GetAttacker()
local unit B1P=GetTriggerUnit()
local location o1P=GetUnitLoc(B1P)
local unit a1P
if rcw(1,$64)<=17 then
call UfN(R1P,B1P,177777.,1.,4.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
call YvG("AZ_Zeusking_Impact-red.mdx",R1P,"hand right")
call SetUnitAnimation(R1P,"spell")
if RFN(B1P) or GetUnitAbilityLevel(B1P,$41393033)>0 then
call UfN(R1P,B1P,GetUnitState(B1P,UNIT_STATE_LIFE)*.01*2.5,1.,1.,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
endif
endif
if rcw(1,$64)<=10 then
set a1P=CreateUnitAtLoc(ON,$65303250,o1P,bj_UNIT_FACING)
call IssuePointOrderById(a1P,OrderId("dreadlordinferno"),GetLocationX(o1P),GetLocationY(o1P))
call UnitDamagePointLoc(R1P,0.,515.,o1P,215000.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endif
call RemoveLocation(o1P)
set R1P=null
set B1P=null
set a1P=null
set o1P=null
endfunction
function U2N takes nothing returns boolean
return GetUnitRace(GetTriggerUnit())==RACE_ORC
endfunction
function U2P takes nothing returns boolean
return IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(LoadUnitHandle(gp,0,sP*$1f4)))
endfunction
function U2w takes nothing returns nothing
local boolean o2w
call GroupAddUnit(HN,GetEnumUnit())
if pN<=0 then
return
endif
set o2w=jN
set jN=false
call ForForce(bj_FORCE_PLAYER[0],FN)
if not jN then
set tN=tN+1
set pN=pN-1
endif
set jN=o2w
endfunction
