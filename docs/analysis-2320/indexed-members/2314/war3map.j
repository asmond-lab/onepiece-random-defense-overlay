call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5.,GetPlayerName(Player(GfE))+"님이 |cff00ced1보물상자|r를 발견하여 |cffff8200"+GetObjectName($65303138)+"|r "+I2S(PfE)+"기 획득!|r")
