function KVw takes nothing returns nothing
local unit jVw=GetEventDamageSource()
local unit WVw=GetTriggerUnit()
local player CVw=GetOwningPlayer(jVw)
local real bVw=GetUnitStateSwap(UNIT_STATE_MAX_LIFE,WVw)
local real fVw
local real xVw
local integer lVw
if not qs then
set qs=true
set lVw=0
set ss=CreateTrigger()
loop
exitwhen lVw>=4
call TriggerRegisterPlayerChatEvent(ss,Player(lVw),"-기여도",true)
