function wcw takes unit Gcw,integer Ncw,real Ecw returns nothing
if GetUnitAbilityLevel(Gcw,$416c6f63)>0 then
call UnitApplyTimedLife(Gcw,Ncw,Ecw)
endif
endfunction
function F5E takes nothing returns nothing
local integer m5E
local unit s5E
local integer q5E
local unit H5E
local integer h5E
call TyG(0)
if jF[sP]==0 then
call SgN(sP,0,GetAttacker())
call SgN(sP,1,GetTriggerUnit())
call Y5G(sP,0,GetUnitLoc(LoadUnitHandle(gp,0,sP*$1f4)))
call Y5G(sP,1,GetUnitLoc(LoadUnitHandle(gp,0,sP*$1f4+1)))
call UkN(sP,0,AngleBetweenPoints(LoadLocationHandle(yp,0,sP*$1f4),LoadLocationHandle(yp,0,sP*$1f4+1)))
call n_N(sP,0,1)
set m5E=sP
call P1P(m5E,.1,jF[m5E]+1)
elseif jF[sP]==1 then
call SgN(sP,10,CreateUnitAtLoc(ON,$68304335,LoadLocationHandle(yp,0,sP*$1f4),LoadReal(Hp,0,sP*$1f4)))
set s5E=LoadUnitHandle(gp,0,sP*$1f4+10)
call SetUnitScale(s5E,1.5,100.*.01,100.*.01)
call SetUnitFlyHeight(LoadUnitHandle(gp,0,sP*$1f4+10),100.,10000.)
call wcw(LoadUnitHandle(gp,0,sP*$1f4+10),$42487765,1.)
call SetUnitAnimationByIndex(LoadUnitHandle(gp,0,sP*$1f4+10),1)
call UnitAddAbility(LoadUnitHandle(gp,0,sP*$1f4+10),$4130554f)
call YvG("SuperBigExplosion.mdx",LoadUnitHandle(gp,0,sP*$1f4+10),"origin")
call IssueTargetOrder(LoadUnitHandle(gp,0,sP*$1f4+10),"firebolt",LoadUnitHandle(gp,0,sP*$1f4+1))
call SgN(sP,2,CreateUnitAtLoc(ON,$65304142,LoadLocationHandle(yp,0,sP*$1f4),LoadReal(Hp,0,sP*$1f4)))
call PauseUnit(LoadUnitHandle(gp,0,sP*$1f4+2),true)
call SetUnitTimeScale(LoadUnitHandle(gp,0,sP*$1f4+2),3.)
if GetUnitAbilityLevelSwapped($41304854,LoadUnitHandle(gp,0,sP*$1f4))==2 then
call UnitDamagePointLoc(LoadUnitHandle(gp,0,sP*$1f4),0.,750.,LoadLocationHandle(yp,0,sP*$1f4+1),1200000.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endif
call UnitDamagePointLoc(LoadUnitHandle(gp,0,sP*$1f4),0.,750.,LoadLocationHandle(yp,0,sP*$1f4+1),1150000.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
set q5E=sP
call P1P(q5E,.1,jF[q5E]+1)
elseif jF[sP]==2 then
call Y5G(sP,2,PolarProjectionBJ(LoadLocationHandle(yp,0,sP*$1f4),340.*I2R(LoadInteger(sp,0,sP*$1f4)),LoadReal(Hp,0,sP*$1f4)))
call SgN(sP,10,CreateUnitAtLoc(ON,$68304335,LoadLocationHandle(yp,0,sP*$1f4+2),LoadReal(Hp,0,sP*$1f4)))
call SetUnitAnimationByIndex(LoadUnitHandle(gp,0,sP*$1f4+10),0)
set H5E=LoadUnitHandle(gp,0,sP*$1f4+10)
call SetUnitScale(H5E,3.25,100.*.01,100.*.01)
call SetUnitFlyHeight(LoadUnitHandle(gp,0,sP*$1f4+10),150.,10000.)
call UnitApplyTimedLife(LoadUnitHandle(gp,0,sP*$1f4+10),$42487765,2.)
call YvG("flamestrike3.mdx",LoadUnitHandle(gp,0,sP*$1f4+10),"origin")
if LoadInteger(sp,0,sP*$1f4)==3 then
set h5E=sP
call P1P(h5E,.03,jF[h5E]+1)
else
call n_N(sP,0,LoadInteger(sp,0,sP*$1f4)+1)
call P1P(sP,.1,2)
endif
elseif jF[sP]==3 then
call PauseUnit(LoadUnitHandle(gp,0,sP*$1f4+2),false)
call AnN(sP)
endif
set s5E=null
set H5E=null
endfunction
function F5P takes nothing returns nothing
local unit u5P=GetAttacker()
local unit m5P=GetTriggerUnit()
local player q5P=GetOwningPlayer(u5P)
local location H5P=GetUnitLoc(u5P)
local location h5P=GetUnitLoc(m5P)
local unit s5P
if rcw(1,$64)<=17 then
call CreateUnitAtLoc(q5P,$65304c44,h5P,GetUnitFacing(u5P))
set s5P=CreateUnitAtLoc(q5P,$65304c45,h5P,GetUnitFacing(u5P))
call IssueTargetOrderById(s5P,OrderId("faeriefire"),m5P)
call dQG(m5P,15)
call UnitDamagePointLoc(u5P,0.,375.,h5P,1500000.,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL)
endif
call RemoveLocation(H5P)
call RemoveLocation(h5P)
set u5P=null
set m5P=null
set s5P=null
set q5P=null
set H5P=null
set h5P=null
endfunction
function F6w takes nothing returns boolean
return IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(LoadUnitHandle(gp,0,sP*$1f4)))
endfunction
