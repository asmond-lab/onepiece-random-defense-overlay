function pSE takes nothing returns nothing
local unit sSE=GetAttacker()
local unit qSE=GetTriggerUnit()
local location hSE=GetUnitLoc(sSE)
local location FSE=GetUnitLoc(qSE)
local real tSE=AngleBetweenPoints(hSE,FSE)
local unit HSE
if rcw(1,$190)<=57 then
set HSE=CreateUnitAtLoc(ON,$6530354b,hSE,tSE)
call YvG("Effect Mythic_Heal Orange.mdx",HSE,"origin")
call YvG("Effect Mythic_Heal Orange.mdx",HSE,"origin")
set HSE=CreateUnitAtLoc(ON,$65303550,FSE,tSE)
call SetUnitUserData(HSE,GetPlayerId(GetOwningPlayer(sSE)))
call IssueTargetOrder(HSE,"acidbomb",qSE)
call CreateUnitAtLoc(ON,$65303551,FSE,tSE)
call SWw(sSE,.0,450.,FSE,200000.,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endif
call RemoveLocation(hSE)
call RemoveLocation(FSE)
set sSE=null
set qSE=null
set HSE=null
set hSE=null
set FSE=null
endfunction
function pUN takes nothing returns nothing
local integer uUN
local integer mUN
local integer sUN
local integer qUN
local location HUN
local boolexpr hUN
local code FUN
local integer tUN
call TyG(0)
if jF[sP]==0 then
