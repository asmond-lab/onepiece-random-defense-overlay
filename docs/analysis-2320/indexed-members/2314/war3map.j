call IncUnitAbilityLevel(TYG,$41304c45)
set rYG=GetUnitAbilityLevel(TYG,$41304c45)
if rYG==3 then
call IncUnitAbilityLevel(TYG,$41304c39)
elseif rYG==5 then
call UnitAddAbility(TYG,$41304c46)
elseif rYG==7 then
call IncUnitAbilityLevel(TYG,$41304c43)
elseif rYG==10 then
call SetUnitAbilityLevel(TYG,$41304c46,2)
call SetPlayerAbilityAvailable(yYG,$41304c44,false)
endif
call UnitRemoveAbility(TYG,$4131324d)
call SetPlayerState(yYG,PLAYER_STATE_RESOURCE_FOOD_USED,GetPlayerState(yYG,PLAYER_STATE_RESOURCE_FOOD_USED)-4)
set TYG=null
set yYG=null
endfunction
