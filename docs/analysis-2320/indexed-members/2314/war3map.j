function AOE takes nothing returns nothing
local integer DOE=GetPlayerId(GetTriggerPlayer())
local integer kOE=S2I(BlzGetTriggerSyncData())
local integer OOE=LoadInteger(HP,kOE,3)
local player QOE
local integer nOE
local integer YOE
local player iOE
if OOE==0 then
call n3E(DOE,kOE)
set QOE=Player(DOE)
set t=QOE
call TriggerEvaluate(F)
set QOE=Player(DOE)
set nOE=c2E()
call GroupEnumUnitsOfPlayer(GS[nOE],QOE,Filter(hL))
set YOE=nOE
call GroupClear(GS[YOE])
call taG(YOE)
call VNN(DOE)
elseif OOE==1 then
if bE[DOE]<LoadInteger(HP,kOE,1) then
call ZxG(Player(DOE),"|cffFF0000베리가 부족합니다.|r",sS,-50.,0.,2.,1.)
else
set bE[DOE]=bE[DOE]-LoadInteger(HP,kOE,1)
call n3E(DOE,kOE)
set iOE=Player(DOE)
set t=iOE
call TriggerEvaluate(F)
call VNN(DOE)
endif
endif
set QOE=null
set iOE=null
endfunction
function ARw takes integer ORw,integer QRw,integer nRw returns integer
local integer YRw
local integer iRw
if nRw==AM then
set YRw=nM[ORw]-1
set iRw=QM[ORw*$1f4+QRw]
set QM[ORw*$1f4+QRw]=QM[ORw*$1f4+YRw]
set nM[ORw]=YRw
else
set YRw=iM[ORw]-1
set iRw=YM[ORw*$1f4+QRw]
set YM[ORw*$1f4+QRw]=YM[ORw*$1f4+YRw]
set iM[ORw]=YRw
endif
return iRw
endfunction
