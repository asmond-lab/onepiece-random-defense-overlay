function CuE takes nothing returns nothing
call TyG(0)
if jF[sP]==0 then
call SgN(sP,0,GetAttacker())
call SgN(sP,1,GetTriggerUnit())
call Y5G(sP,0,GetUnitLoc(LoadUnitHandle(gp,0,sP*$1f4)))
call Y5G(sP,1,GetUnitLoc(LoadUnitHandle(gp,0,sP*$1f4+1)))
call SgN(sP,10,CreateUnitAtLoc(ON,$65303239,LoadLocationHandle(yp,0,sP*$1f4+1),GetRandomDirectionDeg()))
call SgN(sP,10,CreateUnitAtLoc(ON,$65303239,LoadLocationHandle(yp,0,sP*$1f4+1),GetRandomDirectionDeg()))
call UnitDamagePointLoc(LoadUnitHandle(gp,0,sP*$1f4),.0,450.,LoadLocationHandle(yp,0,sP*$1f4+1),100000.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
call SWw(LoadUnitHandle(gp,0,sP*$1f4),.0,450.,LoadLocationHandle(yp,0,sP*$1f4+1),250000.,.70,1.50,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL)
call AnN(sP)
endif
endfunction
function eOE takes player IOE,integer LOE returns nothing
local player VOE
local integer ZOE
if (not HaveSavedBoolean(ZM,GetPlayerId(IOE),LOE))or(not LoadBoolean(ZM,GetPlayerId(IOE),LOE)) then
call BJDebugMsg("|cffff0000[오류] 아이템이 존재하지 않는데 사용하려 했습니다")
set VOE=null
return
endif
set VOE=IOE
set ZOE=LOE
call SetPlayerAbilityAvailable(VOE,ZOE,false)
call SaveBoolean(ZM,GetPlayerId(VOE),ZOE,false)
set VOE=null
endfunction
function CvE takes nothing returns nothing
local unit qvE
local unit HvE
local integer hvE
local integer FvE
local integer tvE
local integer pvE
local integer jvE
local location WvE
if GetOwningPlayer(GetTriggerUnit())!=GetOwningPlayer(GetSpellTargetUnit()) then
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0.,0.,5.,"|cffFF8200내 소유 유닛에게만 사용할 수 있습니다.|r")
call IssueImmediateOrderBJ(GetTriggerUnit(),"stop")
set qvE=null
set HvE=null
set WvE=null
return
endif
if GetUnitTypeId(GetSpellTargetUnit())==$48304254 then
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0.,0.,5.,"|cffFF8200이미 '조로 초월' 을 강화했습니다.|r")
call IssueImmediateOrderBJ(GetTriggerUnit(),"stop")
set qvE=null
set HvE=null
set WvE=null
return
endif
if GetUnitTypeId(GetSpellTargetUnit())==$48303946 then
if GetUnitAbilityLevelSwapped($41305142,GetSpellTargetUnit())!=2 then
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0.,0.,5.,"|cffFF8200'조로 초월' 의 특성강화가 필요합니다.|r")
set qvE=null
set HvE=null
set WvE=null
return
endif
set HvE=GetSpellTargetUnit()
set hvE=GetHeroXP(HvE)
set jvE=GetPlayerId(GetOwningPlayer(HvE))
set FvE=GetHeroStatBJ(bj_HEROSTAT_STR,HvE,false)
set tvE=GetHeroStatBJ(bj_HEROSTAT_AGI,HvE,false)
set pvE=GetHeroStatBJ(bj_HEROSTAT_INT,HvE,false)
set WvE=GetUnitLoc(HvE)
call StartSound(Qbw("SE\\Zoro_2.mp3",null,$7f,1.,false,0.,0.))
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,3.,"|cffc0c0c0롤로노아 조로 : |r|cff00fa9a지옥의 왕이 되어주겠다!|r")
set qvE=CreateUnitAtLoc(GetTriggerPlayer(),$48304254,WvE,bj_UNIT_FACING)
call eOE(GetTriggerPlayer(),$41493033)
call UnitAddItemToSlotById(qvE,$49303033,0)
call SetHeroXP(qvE,hvE,false)
call GroupAddUnit(GS[oP[jvE]],qvE)
call ModifyHeroStat(bj_HEROSTAT_STR,qvE,bj_MODIFYMETHOD_SET,FvE)
call ModifyHeroStat(bj_HEROSTAT_AGI,qvE,bj_MODIFYMETHOD_SET,tvE)
call ModifyHeroStat(bj_HEROSTAT_INT,qvE,bj_MODIFYMETHOD_SET,pvE)
call SetUnitAbilityLevelSwapped($41305143,qvE,3)
call SetUnitAbilityLevelSwapped($41305145,qvE,3)
call SetUnitAbilityLevelSwapped($41305142,qvE,2)
call juG(qvE)
call RemoveUnit(HvE)
call RemoveLocation(WvE)
else
if GetUnitTypeId(GetSpellTargetUnit())==$6830434a then
else
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0.,0.,5.,"|cffFF8200'조로 초월' 또는 '류마 영원' 에게만 사용할 수 있습니다.|r")
endif
call IssueImmediateOrderBJ(GetTriggerUnit(),"stop")
endif
set qvE=null
set HvE=null
set WvE=null
endfunction
function Cvw takes nothing returns nothing
local unit Wvw=GetTriggerUnit()
if GetUnitAbilityLevel(Wvw,$416e6532)==0 then
call UnitAddAbility(Wvw,$416e6532)
endif
call BlzPauseUnitEx(Wvw,true)
set Wvw=null
endfunction
function CyE takes nothing returns nothing
call TriggerExecute(oR)
endfunction
function CyG takes nothing returns nothing
local real jyG=GetRectCenterX(OJ)
local real WyG=GetRectCenterY(OJ)
call IssuePointOrder(GetTriggerUnit(),"move",jyG,WyG)
endfunction
function D1w takes nothing returns boolean
return GetUnitRace(GetTriggerUnit())==RACE_ORC
endfunction
function D2N takes nothing returns nothing
local real Z2N=GetRectCenterX(wX)
local real e2N=GetRectCenterY(wX)
call IssuePointOrder(GetTriggerUnit(),"move",Z2N,e2N)
endfunction
