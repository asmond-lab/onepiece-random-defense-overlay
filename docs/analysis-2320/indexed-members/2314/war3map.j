elseif wfE==2 then
set Rw[GfE]=Rw[GfE]+1
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5.,GetPlayerName(Player(GfE))+"님이 |cff00ced1보물상자|r를 발견하여 |cff9553ec"+GetObjectName($65303137)+"|r "+I2S(PfE)+"기 획득!|r")
call G5E(Player(GfE),PfE)
endif
call TriggerEvaluate(u)
set MfE=null
set JfE=null
