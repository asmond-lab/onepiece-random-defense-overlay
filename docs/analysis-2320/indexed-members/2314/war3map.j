function vEN takes string nEN,integer YEN returns integer
local integer iEN=LoadInteger(mG,StringHash(nEN),0)
local integer AEN=LoadInteger(mG,StringHash(nEN),-2)
if LoadStr(mG,StringHash(nEN),-1)!=nEN then
return 0
endif
if YEN>=iEN then
return 0
endif
if YEN<AEN then
set YEN=AEN-1
endif
return iEN-YEN
endfunction
