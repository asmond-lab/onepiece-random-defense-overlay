function ODN takes nothing returns nothing
local integer fDN=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
local real xDN=GetUnitX(GetTriggerUnit())
local real lDN=GetUnitY(GetTriggerUnit())
local integer KDN=GetUnitTypeId(GetTriggerUnit())
local string LDN=GetUnitName(GetTriggerUnit())
local boolean ZDN=false
local integer bDN
local integer IDN
local integer VDN
local unit eDN
local integer DDN
local unit kDN
if XP[fDN]!=2 then
set ZDN=true
endif
if ZDN then
set bDN=c2E()
call GroupEnumUnitsOfPlayer(GS[bDN],Player(fDN),Filter(H0))
set VDN=FPE(bDN)
if VDN<=0 then
call DisplayTimedTextToPlayer(Player(fDN),0.,0.,5.,"|cffff0000[오류]|r |cffFF8200행운의 토큰|r이 부족합니다. 필요 개수 : |cffFF00001개|r")
call IssueImmediateOrder(GetTriggerUnit(),"stop")
set eDN=null
set kDN=null
return
endif
set eDN=qHE(bDN)
call ShowUnit(eDN,false)
call KillUnit(eDN)
set DDN=bDN
call GroupClear(GS[DDN])
call taG(DDN)
endif
set kDN=GetTriggerUnit()
call ShowUnit(kDN,false)
call KillUnit(kDN)
loop
set IDN=rcw(0,13)
exitwhen QH[IDN]!=KDN
endloop
set bj_lastCreatedUnit=CreateUnit(Player(fDN),QH[IDN],xDN,lDN,bj_UNIT_FACING)
call IssueImmediateOrder(bj_lastCreatedUnit,"holdposition")
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5.,GetPlayerName(Player(fDN))+"님이 |cffff8200랜덤유닛 리롤|r 을(를) 사용하여 \n"+LDN+" → "+GetUnitName(bj_lastCreatedUnit)+" 으로 변환되었습니다!")
set eDN=null
set kDN=null
endfunction
function yNN takes integer dNN returns boolean
