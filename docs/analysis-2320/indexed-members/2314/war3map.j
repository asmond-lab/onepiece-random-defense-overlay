function PIN takes nothing returns boolean
return true
endfunction
function PLG takes nothing returns nothing
call UfN(GetAttacker(),GetEnumUnit(),1000.,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endfunction
function PMw takes nothing returns nothing
if GetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_FOOD_USED)<4 then
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0.,0.,6.,"|cffff0000[오류]|r|cff1e90ff특성포인트|r가 부족합니다!")
call IssueImmediateOrder(GetTriggerUnit(),"stop")
return
endif
call IncUnitAbilityLevelSwapped($41305638,GetTriggerUnit())
call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()),$41305648,false)
call SetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_FOOD_USED,GetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_FOOD_USED)-4)
endfunction
function PPN takes nothing returns nothing
local integer nwN
local integer YwN
local integer iwN
local integer AwN
local integer vwN
local location GPN
local boolexpr NPN
local code EPN
local integer wPN
call TyG(0)
if jF[sP]==0 then
call SgN(sP,0,GetAttacker())
call SgN(sP,1,GetTriggerUnit())
call SgN(sP,3,Vw[GetPlayerId(GetOwningPlayer(LoadUnitHandle(gp,0,sP*$1f4)))])
call Y5G(sP,0,GetUnitLoc(LoadUnitHandle(gp,0,sP*$1f4)))
call Y5G(sP,1,GetUnitLoc(LoadUnitHandle(gp,0,sP*$1f4+1)))
call UkN(sP,0,AngleBetweenPoints(LoadLocationHandle(yp,0,sP*$1f4),LoadLocationHandle(yp,0,sP*$1f4+1)))
