function O_P takes nothing returns nothing
local unit I_P=GetTriggerUnit()
local unit L_P=GetSpellTargetUnit()
local player V_P=GetTriggerPlayer()
local integer Z_P=GetPlayerId(V_P)
local real e_P=GetPlayerStartLocationX(Player(Z_P))
local real D_P=GetPlayerStartLocationY(Player(Z_P))
local integer k_P=GetUnitAbilityLevel(I_P,$41303943)
if GetOwningPlayer(L_P)!=Player(7) and GetOwningPlayer(L_P)!=V_P then
call DisplayTimedTextToPlayer(Player(Z_P),0.,0.,5.,"|cffff0000[오류]|r 조합식 유닛 또는 자신의 유닛에게만 사용할 수 있습니다.")
set I_P=null
set L_P=null
set V_P=null
return
endif
if GetUnitAbilityLevel(L_P,$41304241)<=0 and GetUnitTypeId(L_P)!=$68303143 and GetUnitTypeId(L_P)!=$68303135 then
call DisplayTimedTextToPlayer(Player(Z_P),0.,0.,5.,"|cffff0000[오류]|r 해당 와일드 카드는 '특별' 유닛에게만 사용 가능합니다.")
set I_P=null
set L_P=null
set V_P=null
return
endif
set bj_lastCreatedUnit=CreateUnit(Player(Z_P),GetUnitTypeId(L_P),e_P,D_P,bj_UNIT_FACING)
call IssueImmediateOrder(bj_lastCreatedUnit,"holdposition")
call DisplayTimedTextToPlayer(Player(Z_P),0.,0.,5.,"|r|cffff8200기록지침 :: |r|ce32bb454[와일드카드]|r "+GetUnitName(bj_lastCreatedUnit)+" 획득")
if k_P>1 then
call SetUnitAbilityLevel(I_P,$41303943,k_P-1)
else
call UnitRemoveAbility(I_P,$41303943)
endif
call DisplayTimedTextToPlayer(Player(Z_P),0.,0.,5.,"|cff04ffc4[알림]|r |r|cffff8200기록지침 :: |r|ce32bb454[와일드카드]|r 횟수가 "+I2S(k_P-1)+"회 남았습니다.")
set I_P=null
set L_P=null
set V_P=null
endfunction
function F9w takes string r9w,unit u9w,integer m9w returns nothing
local texttag s9w
local real q9w
local real H9w
local real h9w
set bj_lastCreatedTextTag=CreateTextTagUnitBJ(r9w,u9w,8.,9.,100.,100.,100.,15.)
call SetTextTagPermanent(bj_lastCreatedTextTag,false)
call SetTextTagLifespan(bj_lastCreatedTextTag,1.50)
call SetTextTagFadepoint(bj_lastCreatedTextTag,.45)
set s9w=bj_lastCreatedTextTag
set q9w=TextTagSpeed2Velocity(45.)
set H9w=q9w*Cos(90.*bj_DEGTORAD)
set h9w=q9w*Sin(90.*bj_DEGTORAD)
call SetTextTagVelocity(s9w,H9w,h9w)
call SetTextTagVisibility(bj_lastCreatedTextTag,GetLocalPlayer()==Player(m9w))
set s9w=null
endfunction
function FFN takes integer qFN,integer HFN,unit hFN returns nothing
