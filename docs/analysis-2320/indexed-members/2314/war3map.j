function Zaw takes nothing returns nothing
local unit faw=GetEventDamageSource()
local unit xaw=GetTriggerUnit()
local player law=GetOwningPlayer(faw)
local real Kaw=GetUnitStateSwap(UNIT_STATE_MAX_LIFE,xaw)
local real Iaw
local real Law
local integer Vaw
if not Lm then
set Lm=true
set Vaw=0
set Im=CreateTrigger()
loop
exitwhen Vaw>=4
call TriggerRegisterPlayerChatEvent(Im,Player(Vaw),"-기여도",true)
call TriggerRegisterPlayerChatEvent(Im,Player(Vaw),"-contribution",true)
call TriggerRegisterPlayerChatEvent(Im,Player(Vaw),"ㄱㅇㄷ",true)
call TriggerRegisterPlayerChatEvent(Im,Player(Vaw),"rde",true)
set Vaw=Vaw+1
endloop
call TriggerAddAction(Im,Lv)
endif
if fm!=Kaw then
set fm=Kaw
if xm<Kaw then
set xm=Kaw
else
set lm=lm*(Kaw/xm)
set xm=Kaw
endif
endif
set lm=lm+GetEventDamage()
if GetUnitStateSwap(UNIT_STATE_MAX_LIFE,xaw)>=lm then
if GetPlayerController(law)==MAP_CONTROL_USER then
set Km[GetPlayerId(law)]=Km[GetPlayerId(law)]+GetEventDamage()
else
set Km[GetUnitUserData(faw)]=Km[GetUnitUserData(faw)]+GetEventDamage()
endif
else
set Iaw=lm-Kaw
set Law=GetEventDamage()-Iaw
if GetPlayerController(law)==MAP_CONTROL_USER then
set Km[GetPlayerId(law)]=Km[GetPlayerId(law)]+Law
else
set Km[GetUnitUserData(faw)]=Km[GetUnitUserData(faw)]+Law
endif
endif
set faw=null
set xaw=null
set law=null
endfunction
