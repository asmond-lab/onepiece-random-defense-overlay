function Vlw takes nothing returns nothing
local unit blw=GetEventDamageSource()
local unit flw=GetTriggerUnit()
local player xlw=GetOwningPlayer(blw)
local real llw=GetUnitStateSwap(UNIT_STATE_MAX_LIFE,flw)
local real Klw
local real Ilw
local integer Llw
if not uq then
set uq=true
set Llw=0
set rq=CreateTrigger()
loop
exitwhen Llw>=4
call TriggerRegisterPlayerChatEvent(rq,Player(Llw),"-기여도",true)
call TriggerRegisterPlayerChatEvent(rq,Player(Llw),"-contribution",true)
call TriggerRegisterPlayerChatEvent(rq,Player(Llw),"ㄱㅇㄷ",true)
call TriggerRegisterPlayerChatEvent(rq,Player(Llw),"rde",true)
set Llw=Llw+1
endloop
call TriggerAddAction(rq,X0)
endif
if dq!=llw then
set dq=llw
if gq<llw then
set gq=llw
else
set Tq=Tq*(llw/gq)
set gq=llw
endif
endif
set Tq=Tq+GetEventDamage()
if GetUnitStateSwap(UNIT_STATE_MAX_LIFE,flw)>=Tq then
if GetPlayerController(xlw)==MAP_CONTROL_USER then
set yq[GetPlayerId(xlw)]=yq[GetPlayerId(xlw)]+GetEventDamage()
else
set yq[GetUnitUserData(blw)]=yq[GetUnitUserData(blw)]+GetEventDamage()
endif
else
set Klw=Tq-llw
set Ilw=GetEventDamage()-Klw
if GetPlayerController(xlw)==MAP_CONTROL_USER then
set yq[GetPlayerId(xlw)]=yq[GetPlayerId(xlw)]+Ilw
else
set yq[GetUnitUserData(blw)]=yq[GetUnitUserData(blw)]+Ilw
endif
endif
set blw=null
set flw=null
set xlw=null
endfunction
