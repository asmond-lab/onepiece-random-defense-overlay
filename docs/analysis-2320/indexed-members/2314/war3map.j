function yiG takes nothing returns nothing
local unit BiG=GetEventDamageSource()
local unit aiG=GetTriggerUnit()
local player oiG=GetOwningPlayer(BiG)
local real UiG=GetUnitStateSwap(UNIT_STATE_MAX_LIFE,aiG)
local real diG
local real giG
local integer TiG
if not vm then
set vm=true
set TiG=0
set Am=CreateTrigger()
loop
exitwhen TiG>=4
call TriggerRegisterPlayerChatEvent(Am,Player(TiG),"-기여도",true)
call TriggerRegisterPlayerChatEvent(Am,Player(TiG),"-contribution",true)
call TriggerRegisterPlayerChatEvent(Am,Player(TiG),"ㄱㅇㄷ",true)
call TriggerRegisterPlayerChatEvent(Am,Player(TiG),"rde",true)
set TiG=TiG+1
endloop
call TriggerAddAction(Am,ev)
endif
if Qm!=UiG then
set Qm=UiG
if nm<UiG then
set nm=UiG
else
set Ym=Ym*(UiG/nm)
set nm=UiG
endif
endif
set Ym=Ym+GetEventDamage()
if GetUnitStateSwap(UNIT_STATE_MAX_LIFE,aiG)>=Ym then
if GetPlayerController(oiG)==MAP_CONTROL_USER then
set im[GetPlayerId(oiG)]=im[GetPlayerId(oiG)]+GetEventDamage()
else
set im[GetUnitUserData(BiG)]=im[GetUnitUserData(BiG)]+GetEventDamage()
endif
else
set diG=Ym-UiG
set giG=GetEventDamage()-diG
if GetPlayerController(oiG)==MAP_CONTROL_USER then
set im[GetPlayerId(oiG)]=im[GetPlayerId(oiG)]+giG
else
set im[GetUnitUserData(BiG)]=im[GetUnitUserData(BiG)]+giG
endif
endif
set BiG=null
set aiG=null
set oiG=null
endfunction
