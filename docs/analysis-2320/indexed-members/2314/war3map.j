local unit eFN
local location kFN
if wg[DFN]then
call DisplayTextToPlayer(GetTriggerPlayer(),0.,0.,"'빅맘 - 불멸' 은 한개만 조합할 수 있습니다.")
set eFN=null
set kFN=null
return
endif
if not yNN($494d3035) then
set eFN=null
set kFN=null
return
endif
set eFN=FirstOfGroup(DN)
set kFN=GetStartLocationLoc(DFN)
call StartSound(Qbw("SE\\bigmam.mp3",null,$7f,1.,false,0.,0.))
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10.,"|c00ff8f79빅 맘 : |r|c00cc3337마~마마~마마!")
set Pg[DFN]=CreateItemLoc($49303042,GetStartLocationLoc(GetPlayerStartLocation(Player(DFN))))
call SetItemUserData(GetLastCreatedItem(),DFN)
call SetItemCharges(GetLastCreatedItem(),1)
call UnitAddItemSwapped(Pg[DFN],eFN)
if not aNN(Eg[DFN]) then
set Eg[DFN]=CreateUnitAtLoc(GetOwningPlayer(eFN),$68303456,kFN,bj_UNIT_FACING)
call UnitAddAbility(Eg[DFN],$41313453)
call UnitAddAbility(Eg[DFN],$41313138)
endif
set wg[DFN]=true
call RemoveLocation(kFN)
set eFN=null
set kFN=null
endfunction
function OGP takes nothing returns nothing
local integer ZGP=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
local real eGP=GetPlayerStartLocationX(Player(ZGP))
local real DGP=GetPlayerStartLocationY(Player(ZGP))
local unit kGP
if GetUnitTypeId(GetTriggerUnit())!=$65303136 then
set kGP=null
return
endif
set kGP=GetTriggerUnit()
call ShowUnit(kGP,false)
call KillUnit(kGP)
set bj_lastCreatedUnit=PlaceRandomUnit(JH,Player(ZGP),eGP,DGP,bj_UNIT_FACING)
call IssueImmediateOrder(bj_lastCreatedUnit,"holdposition")
call DisplayTextToPlayer(Player(ZGP),0.,0.,GetUnitName(bj_lastCreatedUnit)+" 획득!")
set kGP=null
endfunction
function hGE takes integer sGE returns boolean
local real qGE
local real HGE
call KvN()
set KN=GetTriggerPlayer()
set lN=sGE
set qGE=GetPlayerStartLocationX(GetTriggerPlayer())
set HGE=GetPlayerStartLocationY(GetTriggerPlayer())
set ZN=qGE
set eN=HGE
set VN=true
return H0N()
endfunction
function OMN takes nothing returns nothing
if not hGE($59593233) then
return
endif
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10.,"|cffFF0000킬러 : |r|cffFA8072...죽인다!|r")
if GetLocalPlayer()==GetTriggerPlayer() then
call StartSound(yP)
endif
endfunction
function OOG takes nothing returns nothing
local integer DOG=LoadInteger(EG,0,yoE(BlzGetTriggerFrame()))
local integer kOG=aW[DOG]
call BlzFrameSetTexture(LoadFrameHandle(wG,0,kOG),"ReplaceableTextures\\CommandButtons\\BTNSkillz.blp",0,true)
endfunction
