set FLN=null
set bLN=null
return
endif
set FLN=qHE(iR)
set tLN=GetUnitStatePercent(FLN,UNIT_STATE_LIFE,UNIT_STATE_MAX_LIFE)*.85
set pLN=GetUnitDefaultAcquireRange(FLN)
set jLN=R2I(pLN)-2
