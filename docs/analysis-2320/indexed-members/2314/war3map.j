call UfN(LoadUnitHandle(gp,0,sP*$1f4+2),GetEnumUnit(),LoadReal(Hp,0,sP*$1f4+1),1.,1.,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL)
endfunction
function Nxw takes nothing returns nothing
if GetOwningPlayer(GetTriggerUnit())!=GetOwningPlayer(GetSpellTargetUnit()) then
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0.,0.,5.,"|cffFF8200내 소유 유닛에게만 사용할 수 있습니다.|r")
call IssueImmediateOrderBJ(GetTriggerUnit(),"stop")
return
endif
if GetUnitTypeId(GetSpellTargetUnit())==$6830434a then
if GetUnitAbilityLevelSwapped($41314249,GetSpellTargetUnit())==2 then
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0.,0.,5.,"|cffFF8200이미 '류마 영원' 을 강화했습니다.|r")
call IssueImmediateOrderBJ(GetTriggerUnit(),"stop")
return
endif
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,3.,"|cffFF0000도신 류마 : |r|cffFA8072내 시체가 부서지더라도... 검사의 긍지는 절대 지울 수 없다!|r")
call IncUnitAbilityLevelSwapped($41314249,GetSpellTargetUnit())
call AddSpecialEffectTarget("Windwalk_dark.mdx",GetSpellTargetUnit(),"origin")
call eOE(GetOwningPlayer(GetTriggerUnit()),$41493033)
call UnitAddItemToSlotById(GetSpellTargetUnit(),$49303033,0)
else
if GetUnitTypeId(GetSpellTargetUnit())==$48303946 then
else
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0.,0.,5.,"|cffFF8200'조로 초월' 또는 '류마 영원' 에게만 사용할 수 있습니다.|r")
endif
call IssueImmediateOrderBJ(GetTriggerUnit(),"stop")
endif
endfunction
function Nyw takes nothing returns nothing
local unit nTw=GetAttacker()
local unit YTw=GetTriggerUnit()
local player ATw=GetOwningPlayer(nTw)
local location vTw=GetUnitLoc(nTw)
local location Gyw=PolarProjectionBJ(vTw,200.,GetUnitFacing(nTw)+ZsE(150.,210.))
local unit iTw
if rcw(1,$64)<=9 then
set iTw=CreateUnitAtLoc(ATw,$68303738,Gyw,GetUnitFacing(nTw))
call UnitApplyTimedLife(iTw,$426d6563,3.)
call SetUnitVertexColor(iTw,$ff,$ff,$ff,$c8)
call IssueTargetOrder(iTw,"attack",YTw)
endif
if rcw(1,$64)<=5 then
set iTw=CreateUnitAtLoc(ATw,$68303737,Gyw,GetUnitFacing(nTw))
call SetUnitVertexColor(iTw,$ff,$ff,$ff,$c8)
call UnitApplyTimedLife(iTw,$426d6563,3.)
endif
call RemoveLocation(Gyw)
set Gyw=PolarProjectionBJ(vTw,150.,GetUnitFacing(nTw)+60.)
if rcw(1,$190)<=17 then
set iTw=CreateUnitAtLoc(ATw,$68303736,Gyw,GetUnitFacing(nTw))
call SetUnitVertexColor(iTw,$ff,$ff,$ff,$c8)
call UnitApplyTimedLife(iTw,$426d6563,4.)
endif
if rcw(1,$7d0)<=51 then
set iTw=CreateUnitAtLoc(ATw,$68303739,Gyw,GetUnitFacing(nTw))
call SetUnitVertexColor(iTw,$ff,$ff,$ff,$c8)
call UnitApplyTimedLife(iTw,$426d6563,4.)
call IssueTargetOrder(iTw,"attack",YTw)
endif
if rcw(1,$3e8)<=45 then
set iTw=CreateUnitAtLoc(ON,$65304b56,vTw,GetUnitFacing(nTw))
call UnitApplyTimedLife(iTw,$42487765,1.)
call IssueImmediateOrder(iTw,"howlofterror")
endif
call RemoveLocation(vTw)
call RemoveLocation(Gyw)
set nTw=null
set YTw=null
set iTw=null
set ATw=null
set vTw=null
set Gyw=null
endfunction
function i2P takes unit n2P,integer Y2P returns nothing
if Y2P>0 and GetUnitAbilityLevel(n2P,$41303451)==0 then
call UnitAddAbility(n2P,$41303451)
endif
call SetUnitAbilityLevel(n2P,$41303451,GetUnitAbilityLevel(n2P,$41303451)+Y2P)
endfunction
function O0E takes nothing returns nothing
call i2P(GetEnumUnit(),18)
call UfN(LoadUnitHandle(gp,0,sP*$1f4),GetEnumUnit(),4500000.+GetUnitStateSwap(UNIT_STATE_MAX_LIFE,GetEnumUnit())*2.*.01,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endfunction
function O0w takes nothing returns nothing
local real D0w=GetRectCenterX(LJ)
local real k0w=GetRectCenterY(LJ)
call IssuePointOrder(GetTriggerUnit(),"move",D0w,k0w)
endfunction
function O1w takes nothing returns nothing
local unit k1w=GetTriggerUnit()
if GetUnitAbilityLevel(k1w,$41304259)==2 then
call UfN(k1w,k1w,GetUnitState(k1w,UNIT_STATE_MAX_LIFE)*.1,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
else
call UfN(k1w,k1w,GetUnitState(k1w,UNIT_STATE_MAX_LIFE)*.07,1.,1.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
endif
set k1w=null
endfunction
function O2E takes nothing returns boolean
return IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(LoadUnitHandle(gp,0,sP*$1f4)))
endfunction
function O4N takes nothing returns boolean
return IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(LoadUnitHandle(gp,0,sP*$1f4)))
endfunction
function BtE takes nothing returns nothing
local integer ctE=0
local boolean RtE=false
loop
set ctE=ctE+1
exitwhen ctE>3
if YN[ctE]then
set YN[ctE]=false
set RtE=true
endif
endloop
if RtE then
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,2.,"|cff04ffc4[알림]|r 난이도를 변경하여 선택된 모드가 취소되었습니다.")
endif
endfunction
function GrG takes unit QyG returns nothing
local integer YyG=c2E()
local integer iyG=YyG
local integer AyG=WH
local unit nyG
local integer vyG
set bj_groupAddGroupDest=GS[iyG]
call ForGroup(GS[AyG],function GroupAddGroupEnum)
call GroupRemoveUnit(GS[YyG],QyG)
loop
set nyG=FirstOfGroup(GS[YyG])
exitwhen nyG==null
call GroupRemoveUnit(GS[YyG],nyG)
call SetUnitAnimation(nyG,"Stand")
endloop
set vyG=YyG
call GroupClear(GS[vyG])
call taG(vyG)
set nyG=null
endfunction
function SNN takes string NNN,real ENN,real wNN returns texttag
local real PNN=GetRectCenterX(bS)+370.
local real MNN=GetRectCenterY(bS)
set bj_lastCreatedTextTag=CreateTextTag()
call SetTextTagText(bj_lastCreatedTextTag,NNN,.023)
call SetTextTagPos(bj_lastCreatedTextTag,PNN+ENN,MNN+wNN,0.)
call SetTextTagColor(bj_lastCreatedTextTag,$ff,$ff,$ff,$ff)
call SetTextTagPermanent(bj_lastCreatedTextTag,true)
call SetTextTagVisibility(bj_lastCreatedTextTag,true)
return bj_lastCreatedTextTag
endfunction
function mdG takes nothing returns player
local integer udG=0
loop
exitwhen udG>=4
if GetPlayerSlotState(Player(udG))==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(udG))==MAP_CONTROL_USER then
return Player(udG)
endif
set udG=udG+1
endloop
return null
endfunction
function WKG takes player jKG returns boolean
return mdG()==jKG
endfunction
function gsE takes unit csE,string RsE returns nothing
local integer asE=c2E()
local integer osE=asE
local integer UsE=CH
local unit BsE
local integer dsE
set bj_groupAddGroupDest=GS[osE]
call ForGroup(GS[UsE],function GroupAddGroupEnum)
call GroupRemoveUnit(GS[asE],csE)
loop
set BsE=FirstOfGroup(GS[asE])
exitwhen BsE==null
call GroupRemoveUnit(GS[asE],BsE)
call SetUnitAnimation(BsE,RsE)
endloop
set dsE=asE
call GroupClear(GS[dsE])
call taG(dsE)
set BsE=null
endfunction
function O5P takes nothing returns nothing
if oH or(not WKG(GetTriggerPlayer())) then
return
endif
if GetTriggerUnit()!=rH and GetTriggerUnit()!=uH and GetTriggerUnit()!=mH and GetTriggerUnit()!=sH and GetTriggerUnit()!=qH and GetTriggerUnit()!=HH then
return
endif
call DestroyTextTag(FH)
if GetTriggerUnit()==rH then
call SetUnitAnimation(GetTriggerUnit(),"Stand Alternate")
set AN=1
call GrG(GetTriggerUnit())
call SetUnitAnimationByIndex(yH,0)
set FH=SNN("보스를 죽이지 못해도 패배하지 않으며 스토리의 체력이 20% 감소합니다.\n모든 라운드 유닛들의 체력이 15% 감소합니다.\n|cffffd70041라운드|r 진입시 클리어합니다.",0.,70.)
elseif GetTriggerUnit()==uH then
call SetUnitAnimation(GetTriggerUnit(),"Stand Alternate")
set AN=2
call GrG(GetTriggerUnit())
call SetUnitAnimationByIndex(yH,1)
set FH=SNN("|cffffd70050라운드|r 센고쿠 처치시 클리어합니다.",0.,215.)
elseif GetTriggerUnit()==mH then
