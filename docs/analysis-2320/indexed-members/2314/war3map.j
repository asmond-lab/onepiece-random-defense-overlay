function BAE takes nothing returns nothing
if GetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_FOOD_USED)<4 then
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0.,0.,5.,"|cffff0000[오류]|r|cff1e90ff특성포인트|r가 부족합니다!")
call IssueImmediateOrder(GetTriggerUnit(),"stop")
return
endif
call UnitAddAbility(GetTriggerUnit(),$41313838)
call UnitMakeAbilityPermanent(GetTriggerUnit(),true,$41313838)
call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()),$41304736,false)
call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()),$41313244,false)
call SetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_FOOD_USED,GetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_FOOD_USED)-4)
endfunction
function dDE takes unit XDE,unit cDE,integer RDE returns nothing
local real BDE=GetUnitX(XDE)-GetUnitX(cDE)
local real aDE=GetUnitY(XDE)-GetUnitY(cDE)
local real oDE=SquareRoot(BDE*BDE+aDE*aDE)
local real UDE=GetUnitAcquireRange(XDE)+200.
if RDE==0 or oDE>UDE or RDE==OrderId("holdposition") then
call IssueImmediateOrder(XDE,"holdposition")
return
endif
if (not IsUnitType(cDE,UNIT_TYPE_DEAD))and GetWidgetLife(cDE)>.405 and RDE==OrderId("attack") or(RDE==OrderId("smart") and IsUnitEnemy(cDE,GetOwningPlayer(XDE))) then
call IssueTargetOrder(XDE,"attack",cDE)
return
endif
call IssueImmediateOrder(XDE,"holdposition")
endfunction
function BAw takes nothing returns nothing
local integer EAw
local integer wAw
local integer PAw
local integer MAw
local location SAw
local boolexpr JAw
local code XAw
local integer cAw
local integer RAw
call TyG(0)
if jF[sP]==0 then
call SgN(sP,0,GetAttacker())
call SgN(sP,1,GetTriggerUnit())
call Y5G(sP,0,GetUnitLoc(LoadUnitHandle(gp,0,sP*$1f4)))
call Y5G(sP,1,GetUnitLoc(LoadUnitHandle(gp,0,sP*$1f4+1)))
call UkN(sP,0,AngleBetweenPoints(LoadLocationHandle(yp,0,sP*$1f4),LoadLocationHandle(yp,0,sP*$1f4+1)))
call n_N(sP,10,GetUnitCurrentOrder(LoadUnitHandle(gp,0,sP*$1f4)))
call BlzPauseUnitEx(LoadUnitHandle(gp,0,sP*$1f4),true)
set wAw=sP
call P1P(wAw,.03,jF[wAw]+1)
elseif jF[sP]==1 then
call SetUnitAnimation(LoadUnitHandle(gp,0,sP*$1f4),"spell")
set PAw=sP
call P1P(PAw,.03,jF[PAw]+1)
elseif jF[sP]==2 then
call SgN(sP,10,CreateUnitAtLoc(ON,$65303430,LoadLocationHandle(yp,0,sP*$1f4+1),LoadReal(Hp,0,sP*$1f4)))
set EAw=c2E()
set MAw=EAw
set SAw=LoadLocationHandle(yp,0,sP*$1f4+1)
set JAw=Condition(aZ)
set XAw=oZ
call GroupEnumUnitsInRangeOfLoc(GS[MAw],SAw,600.,JAw)
call ForGroup(GS[MAw],XAw)
set cAw=EAw
call GroupClear(GS[cAw])
call taG(cAw)
call UfN(LoadUnitHandle(gp,0,sP*$1f4),LoadUnitHandle(gp,0,sP*$1f4+1),2000000.+GetUnitStateSwap(UNIT_STATE_MAX_LIFE,LoadUnitHandle(gp,0,sP*$1f4+1))*.05,1.,1.,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
set RAw=sP
call P1P(RAw,.36,jF[RAw]+1)
elseif jF[sP]==3 then
call BlzPauseUnitEx(LoadUnitHandle(gp,0,sP*$1f4),false)
call dDE(LoadUnitHandle(gp,0,sP*$1f4),LoadUnitHandle(gp,0,sP*$1f4+1),LoadInteger(sp,0,sP*$1f4+10))
call AnN(sP)
endif
set SAw=null
set JAw=null
endfunction
function BBE takes nothing returns nothing
call yoE(BlzGetTriggerFrame())
endfunction
function BDG takes nothing returns nothing
local unit EDG=GetTriggerUnit()
local player wDG=GetOwningPlayer(EDG)
local integer PDG=GetPlayerId(wDG)
local integer MDG=$68303035
local integer XDG=0
local integer cDG=rcw(2,3)
local real SDG
local real JDG
local unit RDG
call ShowUnit(EDG,false)
call KillUnit(EDG)
call GXN(PDG,$68303035)
set SDG=CN
set JDG=bN
if cDG==2 then
call DisplayTimedTextToPlayer(wDG,0.,0.,5.,"버기 |cff00ff002개|r로 분해 !")
else
call DisplayTimedTextToPlayer(wDG,0.,0.,5.,"버기 |cff00ff003개|r로 분해 !")
endif
loop
exitwhen XDG>=cDG
set RDG=CreateUnit(wDG,MDG,SDG,JDG,bj_UNIT_FACING)
call IssueImmediateOrder(RDG,"holdposition")
if ew[PDG]then
call UnitAddAbility(RDG,$4130544a)
else
call UnitAddAbility(RDG,$41303759)
endif
set XDG=XDG+1
endloop
set EDG=null
set wDG=null
set RDG=null
endfunction
function BEE takes nothing returns nothing
local integer EEE
local unit wEE
local integer PEE
local integer MEE
local integer SEE
local location JEE
local boolexpr XEE
local code cEE
local integer REE
call TyG(0)
if jF[sP]==0 then
call SgN(sP,0,GetAttacker())
call SgN(sP,1,GetTriggerUnit())
call Y5G(sP,0,GetUnitLoc(LoadUnitHandle(gp,0,sP*$1f4)))
call Y5G(sP,1,GetUnitLoc(LoadUnitHandle(gp,0,sP*$1f4+1)))
call UkN(sP,0,AngleBetweenPoints(LoadLocationHandle(yp,0,sP*$1f4),LoadLocationHandle(yp,0,sP*$1f4+1)))
call Y5G(sP,2,PolarProjectionBJ(LoadLocationHandle(yp,0,sP*$1f4+1),-525.,LoadReal(Hp,0,sP*$1f4)+41.))
