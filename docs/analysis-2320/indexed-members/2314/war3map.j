call SetUnitVertexColor(LoadUnitHandle(gp,0,sP*$1f4+10),$ff,$ff,$ff,80)
call SetUnitScale(LoadUnitHandle(gp,0,sP*$1f4+10),1.,1.,1.)
call n_N(sP,0,LoadInteger(sp,0,sP*$1f4)+1)
call P1P(sP,.04,1)
else
