function Hhw takes string rhw,string uhw returns nothing
local integer shw=0
local integer qhw=StringLength(rhw)
local string mhw
set dN[0]=""
set gN=0
loop
exitwhen shw>=qhw
set mhw=SubString(rhw,shw,shw+1)
if mhw==uhw then
set gN=gN+1
set dN[gN]=""
else
set dN[gN]=dN[gN]+mhw
endif
set shw=shw+1
endloop
set gN=gN+1
endfunction
