call SetPlayerAbilityAvailable(ZWN,eWN,true)
call SaveBoolean(ZM,GetPlayerId(ZWN),eWN,true)
call AbE(ZWN,eWN)
set j=ZWN
call TriggerEvaluate(p)
return eWN
endfunction
