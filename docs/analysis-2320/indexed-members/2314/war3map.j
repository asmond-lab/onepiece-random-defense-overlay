local unit JdE=GetSoldUnit()
call ShowUnit(JdE,false)
call UnitApplyTimedLife(JdE,$42487765,.5)
if rcw(1,$64)<=99 then
set bj_lastCreatedUnit=PlaceRandomUnit(Cy,Player(PdE),MdE,SdE,bj_UNIT_FACING)
if GetUnitTypeId(bj_lastCreatedUnit)!=$68303558 then
call UnitAddAbility(bj_lastCreatedUnit,$41305945)
endif
else
set bj_lastCreatedUnit=PlaceRandomUnit(by,Player(PdE),MdE,SdE,bj_UNIT_FACING)
endif
call IssueImmediateOrder(bj_lastCreatedUnit,"holdposition")
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5.,GetPlayerName(Player(PdE))+"|r 님이 |cffff6a00고급유닛 생성|r으로 "+GetUnitName(bj_lastCreatedUnit)+" 획득!")
set JdE=null
endfunction
