function bSw takes nothing returns nothing
local unit hSw=GetEventDamageSource()
local unit FSw=GetTriggerUnit()
local player tSw=GetOwningPlayer(hSw)
local real pSw=GetUnitStateSwap(UNIT_STATE_MAX_LIFE,FSw)
local real jSw
local real WSw
local integer CSw
if not Bs then
set Bs=true
set CSw=0
set Rs=CreateTrigger()
loop
exitwhen CSw>=4
call TriggerRegisterPlayerChatEvent(Rs,Player(CSw),"-기여도",true)
call TriggerRegisterPlayerChatEvent(Rs,Player(CSw),"-contribution",true)
call TriggerRegisterPlayerChatEvent(Rs,Player(CSw),"ㄱㅇㄷ",true)
call TriggerRegisterPlayerChatEvent(Rs,Player(CSw),"rde",true)
set CSw=CSw+1
endloop
call TriggerAddAction(Rs,Ov)
endif
if Ss!=pSw then
set Ss=pSw
if Js<pSw then
set Js=pSw
else
set Xs=Xs*(pSw/Js)
set Js=pSw
endif
endif
set Xs=Xs+GetEventDamage()
if GetUnitStateSwap(UNIT_STATE_MAX_LIFE,FSw)>=Xs then
if GetPlayerController(tSw)==MAP_CONTROL_USER then
set cs[GetPlayerId(tSw)]=cs[GetPlayerId(tSw)]+GetEventDamage()
else
set cs[GetUnitUserData(hSw)]=cs[GetUnitUserData(hSw)]+GetEventDamage()
endif
else
set jSw=Xs-pSw
set WSw=GetEventDamage()-jSw
if GetPlayerController(tSw)==MAP_CONTROL_USER then
set cs[GetPlayerId(tSw)]=cs[GetPlayerId(tSw)]+WSw
else
set cs[GetUnitUserData(hSw)]=cs[GetUnitUserData(hSw)]+WSw
endif
endif
set hSw=null
set FSw=null
set tSw=null
endfunction
