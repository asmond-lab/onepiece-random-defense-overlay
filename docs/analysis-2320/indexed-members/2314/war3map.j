function W1w takes unit p1w,integer j1w returns boolean
return RectContainsUnit(aG[j1w],p1w)
endfunction
function WCG takes unit pCG,integer jCG returns nothing
if ew[jCG]then
call SetUnitAnimation(pCG,"death")
call DisplayTimedTextToPlayer(Player(jCG),0.,0.,3.,"|cffff0000[자동꺼내기 OFF]|r 흔함 유닛이 창고로 들어갑니다.")
else
call SetUnitAnimation(pCG,"stand")
call DisplayTimedTextToPlayer(Player(jCG),0.,0.,3.,"|cff00ff22[자동꺼내기 ON]|r 흔함 유닛이 창고로 들어가지 않습니다.")
endif
endfunction
function PCw takes nothing returns nothing
local integer wCw=GetPlayerId(GetTriggerPlayer())
if not W1w(GetTriggerUnit(),wCw) then
return
endif
set ew[wCw]=not ew[wCw]
call WCG(GetTriggerUnit(),wCw)
endfunction
function PGN takes nothing returns boolean
return GetManipulatedItem()==GetItemOfTypeFromUnitBJ(GetTriggerUnit(),$49303931)
endfunction
function PGP takes nothing returns nothing
local unit NGP=GetTriggerUnit()
local player EGP=GetOwningPlayer(NGP)
local integer wGP=GetPlayerId(EGP)
call DisplayTimedTextToPlayer(Player(wGP),0.,0.,5.,"|cffc0c0c0"+GetUnitName(NGP)+"|r를 제거합니다.")
call ShowUnit(NGP,false)
call KillUnit(NGP)
set eB[wGP]=eB[wGP]-1
set NGP=null
set EGP=null
endfunction
