call nME(JWE)
endfunction
function RWN takes nothing returns nothing
local integer JWN=0
local string cWN="|cff00fa9a[실시간 스토리 기여도]|r\n"
local real XWN
if ks<=0. then
return
endif
loop
exitwhen JWN>=4
if SE[JWN]then
set XWN=100.*(Qs[JWN]/ks)
set cWN=cWN+GetPlayerName(Player(JWN))+" : "+R2SW(XWN,1,2)+"%\n"
endif
set JWN=JWN+1
endloop
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0.,0.,7.,cWN)
endfunction
