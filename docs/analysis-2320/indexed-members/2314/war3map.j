call G_E(sP,0,GetOwningPlayer(LoadUnitHandle(gp,0,sP*$1f4)))
call Y5G(sP,0,GetUnitLoc(LoadUnitHandle(gp,0,sP*$1f4)))
call Y5G(sP,1,GetUnitLoc(LoadUnitHandle(gp,0,sP*$1f4+1)))
call n_N(sP,0,0)
call n_N(sP,2,GetPlayerState(GetOwningPlayer(LoadUnitHandle(gp,0,sP*$1f4)),PLAYER_STATE_RESOURCE_GOLD))
if LoadInteger(sp,0,sP*$1f4+2)>$3d090 then
