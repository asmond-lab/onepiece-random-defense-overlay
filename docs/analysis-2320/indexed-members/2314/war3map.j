function xpN takes nothing returns nothing
local unit tpN=GetEventDamageSource()
local unit ppN=GetTriggerUnit()
local player jpN=GetOwningPlayer(tpN)
local real WpN=GetUnitStateSwap(UNIT_STATE_MAX_LIFE,ppN)
local real CpN
local real bpN
local integer fpN
if not bq then
set bq=true
set fpN=0
set Cq=CreateTrigger()
loop
exitwhen fpN>=4
call TriggerRegisterPlayerChatEvent(Cq,Player(fpN),"-기여도",true)
call TriggerRegisterPlayerChatEvent(Cq,Player(fpN),"-contribution",true)
call TriggerRegisterPlayerChatEvent(Cq,Player(fpN),"ㄱㅇㄷ",true)
call TriggerRegisterPlayerChatEvent(Cq,Player(fpN),"rde",true)
set fpN=fpN+1
endloop
call TriggerAddAction(Cq,B0)
endif
if tq!=WpN then
set tq=WpN
if pq<WpN then
set pq=WpN
else
set jq=jq*(WpN/pq)
set pq=WpN
endif
endif
set jq=jq+GetEventDamage()
if GetUnitStateSwap(UNIT_STATE_MAX_LIFE,ppN)>=jq then
if GetPlayerController(jpN)==MAP_CONTROL_USER then
set Wq[GetPlayerId(jpN)]=Wq[GetPlayerId(jpN)]+GetEventDamage()
else
set Wq[GetUnitUserData(tpN)]=Wq[GetUnitUserData(tpN)]+GetEventDamage()
endif
else
set CpN=jq-WpN
set bpN=GetEventDamage()-CpN
if GetPlayerController(jpN)==MAP_CONTROL_USER then
set Wq[GetPlayerId(jpN)]=Wq[GetPlayerId(jpN)]+bpN
else
set Wq[GetUnitUserData(tpN)]=Wq[GetUnitUserData(tpN)]+bpN
endif
endif
set tpN=null
set ppN=null
set jpN=null
endfunction
