local real TNN
call KvN()
set KN=GetTriggerPlayer()
set lN=dNN
set gNN=GetPlayerStartLocationX(GetTriggerPlayer())
set TNN=GetPlayerStartLocationY(GetTriggerPlayer())
set ZN=gNN
set eN=TNN
set VN=true
return H0N()
endfunction
function OFN takes nothing returns nothing
