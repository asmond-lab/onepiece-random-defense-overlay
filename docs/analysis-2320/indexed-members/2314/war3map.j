function IoN takes nothing returns nothing
local integer poN=GetPlayerId(GetTriggerPlayer())
local real joN=GetPlayerStartLocationX(Player(poN))
local real WoN=GetPlayerStartLocationY(Player(poN))
local integer CoN=50
