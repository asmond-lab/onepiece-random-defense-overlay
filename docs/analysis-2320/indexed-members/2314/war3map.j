function XGE takes integer NGE returns nothing
local real EGE
local integer wGE
local integer PGE
local string MGE
local integer SGE
local integer JGE
if lP[NGE]>=VP[NGE]then
set ZP[NGE]=false
if GetLocalPlayer()==Player(NGE) then
set wGE=xP
call BlzFrameSetAlpha(LoadFrameHandle(wG,0,wGE),0)
endif
return
endif
if lP[NGE]==0 then
if GetLocalPlayer()==Player(NGE) then
set PGE=xP
set MGE=DP[NGE]
call BlzFrameSetText(LoadFrameHandle(wG,0,PGE),MGE)
endif
endif
if lP[NGE]<KP[NGE]then
set EGE=255.*lP[NGE]/KP[NGE]
elseif lP[NGE]<KP[NGE]+IP[NGE]then
set EGE=255.
elseif lP[NGE]<VP[NGE]then
set EGE=255.-255.*(lP[NGE]-IP[NGE]-KP[NGE])/LP[NGE]
else
set EGE=0.
endif
if GetLocalPlayer()==Player(NGE) then
set SGE=xP
set JGE=R2I(EGE)
call BlzFrameSetAlpha(LoadFrameHandle(wG,0,SGE),JGE)
endif
endfunction
function mQN takes integer dQN,integer gQN,integer TQN,integer yQN,real rQN,real uQN returns nothing
call BlzFrameSetPoint(LoadFrameHandle(wG,0,dQN),ConvertFramePointType(gQN),LoadFrameHandle(wG,0,TQN),ConvertFramePointType(yQN),rQN/1920.*.8,-(uQN/1080.*.6))
endfunction
function yoE takes framehandle ToE returns integer
call SaveFrameHandle(wG,0,GetHandleId(ToE),ToE)
return GetHandleId(ToE)
endfunction
function ZxG takes player CxG,string bxG,real fxG,real xxG,real lxG,real KxG,real IxG returns nothing
local integer LxG=yoE(BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI,0))
local integer VxG=GetPlayerId(CxG)
set ZP[VxG]=true
set lP[VxG]=0
set KP[VxG]=R2I(lxG/.02)
set IP[VxG]=R2I(KxG/.02)
set LP[VxG]=R2I(IxG/.02)
set VP[VxG]=KP[VxG]+IP[VxG]+LP[VxG]
set DP[VxG]=bxG
call mQN(xP,4,LxG,4,fxG,xxG)
call XGE(VxG)
call EnableTrigger(eP)
endfunction
function aZN takes string cZN returns string
local integer RZN=0
local integer BZN=StringLength(cZN)
loop
exitwhen RZN>=BZN
if SubString(cZN,RZN,RZN+1)=="#" then
return SubString(cZN,0,RZN)
endif
set RZN=RZN+1
endloop
return cZN
endfunction
function n3E takes integer Z3E,integer e3E returns nothing
