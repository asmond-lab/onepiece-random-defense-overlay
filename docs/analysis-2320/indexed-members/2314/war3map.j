function IdN takes nothing returns nothing
local unit WdN=GetEventDamageSource()
local unit CdN=GetTriggerUnit()
local player bdN=GetOwningPlayer(WdN)
local real fdN=GetUnitStateSwap(UNIT_STATE_MAX_LIFE,CdN)
local real xdN
local real ldN
local integer KdN
if not Ys then
set Ys=true
set KdN=0
set ns=CreateTrigger()
loop
exitwhen KdN>=4
call TriggerRegisterPlayerChatEvent(ns,Player(KdN),"-기여도",true)
call TriggerRegisterPlayerChatEvent(ns,Player(KdN),"-contribution",true)
call TriggerRegisterPlayerChatEvent(ns,Player(KdN),"ㄱㅇㄷ",true)
call TriggerRegisterPlayerChatEvent(ns,Player(KdN),"rde",true)
set KdN=KdN+1
endloop
call TriggerAddAction(ns,E0)
endif
if Ds!=fdN then
set Ds=fdN
if ks<fdN then
set ks=fdN
else
set Os=Os*(fdN/ks)
set ks=fdN
endif
endif
set Os=Os+GetEventDamage()
if GetUnitStateSwap(UNIT_STATE_MAX_LIFE,CdN)>=Os then
if GetPlayerController(bdN)==MAP_CONTROL_USER then
set Qs[GetPlayerId(bdN)]=Qs[GetPlayerId(bdN)]+GetEventDamage()
else
set Qs[GetUnitUserData(WdN)]=Qs[GetUnitUserData(WdN)]+GetEventDamage()
endif
else
set xdN=Os-fdN
set ldN=GetEventDamage()-xdN
if GetPlayerController(bdN)==MAP_CONTROL_USER then
set Qs[GetPlayerId(bdN)]=Qs[GetPlayerId(bdN)]+ldN
else
set Qs[GetUnitUserData(WdN)]=Qs[GetUnitUserData(WdN)]+ldN
endif
endif
set WdN=null
set CdN=null
set bdN=null
endfunction
