function H_N takes nothing returns nothing
local unit T_N=GetEventDamageSource()
local unit y_N=GetTriggerUnit()
local player r_N=GetOwningPlayer(T_N)
local real u_N=GetUnitStateSwap(UNIT_STATE_MAX_LIFE,y_N)
local real m_N
local real s_N
local integer q_N
if not Xq then
set Xq=true
set q_N=0
set Jq=CreateTrigger()
loop
exitwhen q_N>=4
call TriggerRegisterPlayerChatEvent(Jq,Player(q_N),"-기여도",true)
call TriggerRegisterPlayerChatEvent(Jq,Player(q_N),"-contribution",true)
call TriggerRegisterPlayerChatEvent(Jq,Player(q_N),"ㄱㅇㄷ",true)
call TriggerRegisterPlayerChatEvent(Jq,Player(q_N),"rde",true)
set q_N=q_N+1
endloop
call TriggerAddAction(Jq,M0)
endif
if wq!=u_N then
set wq=u_N
if Pq<u_N then
set Pq=u_N
else
set Mq=Mq*(u_N/Pq)
set Pq=u_N
endif
endif
set Mq=Mq+GetEventDamage()
if GetUnitStateSwap(UNIT_STATE_MAX_LIFE,y_N)>=Mq then
if GetPlayerController(r_N)==MAP_CONTROL_USER then
set Sq[GetPlayerId(r_N)]=Sq[GetPlayerId(r_N)]+GetEventDamage()
else
set Sq[GetUnitUserData(T_N)]=Sq[GetUnitUserData(T_N)]+GetEventDamage()
endif
else
set m_N=Mq-u_N
set s_N=GetEventDamage()-m_N
if GetPlayerController(r_N)==MAP_CONTROL_USER then
set Sq[GetPlayerId(r_N)]=Sq[GetPlayerId(r_N)]+s_N
else
set Sq[GetUnitUserData(T_N)]=Sq[GetUnitUserData(T_N)]+s_N
endif
endif
set T_N=null
set y_N=null
set r_N=null
endfunction
