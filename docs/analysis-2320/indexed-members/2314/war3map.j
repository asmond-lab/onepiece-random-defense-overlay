local timer yXw=XVw(0)
local integer RXw
local location BXw
local real aXw
local real oXw
local real UXw
local string dXw
local integer rXw
call TimerStart(yXw,gXw,false,aI)
set rXw=GetHandleId(yXw)
call SaveInteger(uP,rXw,13,MXw)
call SaveInteger(uP,rXw,14,0)
if TXw!=null then
call SaveUnitHandle(uP,rXw,15,TXw)
endif
call SaveStr(uP,rXw,16,"보물찾기")
set gXw=GetLocationX(SXw)
set aXw=GetLocationY(SXw)
if cXw then
call Yvw(MXw,gXw,aXw)
endif
set RXw=0
loop
exitwhen RXw>=nP
set oXw=YP[RXw]
set UXw=iP[RXw]
