function GxG takes nothing returns nothing
local real nfG=GetRectCenterX(iX)
local real YfG=GetRectCenterY(iX)
local real ifG
local real AfG
local integer vfG
set bj_lastCreatedTextTag=CreateTextTag()
call SetTextTagText(bj_lastCreatedTextTag,"'흔함' 유닛 랜덤획득\n0.24% 확률로 해적선 획득",.023)
call SetTextTagPos(bj_lastCreatedTextTag,nfG,YfG,50.)
call SetTextTagColor(bj_lastCreatedTextTag,$ff,$ff,$ff,$ff)
call SetTextTagPermanent(bj_lastCreatedTextTag,true)
call SetTextTagVisibility(bj_lastCreatedTextTag,true)
set nfG=GetRectCenterX(AX)
set YfG=GetRectCenterY(AX)
set ifG=nfG-250.
set AfG=YfG+70.
set bj_lastCreatedTextTag=CreateTextTag()
call SetTextTagText(bj_lastCreatedTextTag,"'목재 도박'\n67% 확률로 1 목재\n실패시 (현재 라운드 x 75) 골드",.023)
call SetTextTagPos(bj_lastCreatedTextTag,ifG,AfG,50.)
call SetTextTagColor(bj_lastCreatedTextTag,$ff,$ff,$ff,$ff)
call SetTextTagPermanent(bj_lastCreatedTextTag,true)
call SetTextTagVisibility(bj_lastCreatedTextTag,true)
set nfG=GetRectCenterX(YX)
set YfG=GetRectCenterY(YX)
set bj_lastCreatedTextTag=CreateTextTag()
call SetTextTagText(bj_lastCreatedTextTag,"'도움소 마나 회복'\n20 + (현재 라운드 x 1.5)\n최대 100 마나 회복",.023)
call SetTextTagPos(bj_lastCreatedTextTag,nfG,YfG,50.)
call SetTextTagColor(bj_lastCreatedTextTag,$ff,$ff,$ff,$ff)
call SetTextTagPermanent(bj_lastCreatedTextTag,true)
call SetTextTagVisibility(bj_lastCreatedTextTag,true)
set nfG=GetRectCenterX(bX)
set YfG=GetRectCenterY(bX)
set bj_lastCreatedTextTag=CreateTextTag()
call SetTextTagText(bj_lastCreatedTextTag,"스토리존 퇴장",.023)
call SetTextTagPos(bj_lastCreatedTextTag,nfG,YfG,50.)
call SetTextTagColor(bj_lastCreatedTextTag,$ff,$ff,$ff,$ff)
call SetTextTagPermanent(bj_lastCreatedTextTag,true)
call SetTextTagVisibility(bj_lastCreatedTextTag,true)
set vfG=0
loop
