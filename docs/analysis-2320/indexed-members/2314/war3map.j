set jLN=jLN+2
endif
if ModuloInteger(jLN,10)==0 and jLN<=50 then
set jLN=jLN+1
endif
call dvN(GetUnitAbilityLevelSwapped($41393031,FLN)-1,jLN,tLN)
endif
set WLN=WLN+1
endloop
set FLN=null
set bLN=null
endfunction
