function rLN takes unit oLN,unit ULN,real dLN returns real
local real gLN=dLN
local real TLN=BlzGetUnitArmor(oLN)
local real yLN
if TLN>=0. then
set yLN=1./(1.+TLN*.02)
else
set yLN=2.-Pow(.94,-TLN)
if yLN>1.71 then
set yLN=1.71
endif
endif
if UnitHasBuffBJ(oLN,$4230364a) then
set gLN=dLN/1.1
elseif UnitHasBuffBJ(oLN,$42303457) then
set gLN=dLN/1.25
elseif UnitHasBuffBJ(oLN,$42303753) then
set gLN=dLN/1.2
endif
if yLN>0. then
set gLN=gLN/yLN
endif
return gLN
endfunction
