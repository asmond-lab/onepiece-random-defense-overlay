function OQE takes nothing returns boolean
return IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(LoadUnitHandle(gp,0,sP*$1f4)))
endfunction
function OQN takes nothing returns nothing
local integer IQN
local integer LQN
local location VQN
local boolexpr ZQN
local code eQN
local integer DQN
local integer kQN
call TyG(0)
if jF[sP]==0 then
call SgN(sP,0,GetAttacker())
call SgN(sP,1,GetTriggerUnit())
call Y5G(sP,1,GetUnitLoc(LoadUnitHandle(gp,0,sP*$1f4+1)))
call UkN(sP,1,GetRandomDirectionDeg())
call n_N(sP,0,0)
call SgN(sP,10,CreateUnitAtLoc(ON,$65303836,LoadLocationHandle(yp,0,sP*$1f4+1),LoadReal(Hp,0,sP*$1f4+1)))
call SgN(sP,10,CreateUnitAtLoc(ON,$65303837,LoadLocationHandle(yp,0,sP*$1f4+1),LoadReal(Hp,0,sP*$1f4+1)))
call SgN(sP,10,CreateUnitAtLoc(ON,$65303838,LoadLocationHandle(yp,0,sP*$1f4+1),LoadReal(Hp,0,sP*$1f4+1)))
call SgN(sP,10,CreateUnitAtLoc(ON,$65303837,LoadLocationHandle(yp,0,sP*$1f4+1),LoadReal(Hp,0,sP*$1f4+1)))
set bj_lastPlayedSound=Qbw("SE\\king_sound.wav",null,$7f,1.1,true,1000.,1400.)
call f6N(LoadUnitHandle(gp,0,sP*$1f4),bj_lastPlayedSound)
call lkE(LoadUnitHandle(gp,0,sP*$1f4+1),3)
set IQN=c2E()
set LQN=IQN
set VQN=LoadLocationHandle(yp,0,sP*$1f4+1)
set ZQN=Condition(He)
set eQN=he
call GroupEnumUnitsInRangeOfLoc(GS[LQN],VQN,675.,ZQN)
call ForGroup(GS[LQN],eQN)
set DQN=IQN
call GroupClear(GS[DQN])
call taG(DQN)
if YnE(LoadUnitHandle(gp,0,sP*$1f4+1)) then
call UfN(LoadUnitHandle(gp,0,sP*$1f4),LoadUnitHandle(gp,0,sP*$1f4+1),10000000.,1.,1.,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
else
call UfN(LoadUnitHandle(gp,0,sP*$1f4),LoadUnitHandle(gp,0,sP*$1f4+1),100000.,1.,1.,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
endif
set kQN=sP
call P1P(kQN,.04,jF[kQN]+1)
elseif jF[sP]==1 then
call UkN(sP,1,LoadReal(Hp,0,sP*$1f4+1)+ZsE(30.,90.))
if LoadInteger(sp,0,sP*$1f4)==1 then
call AnN(sP)
else
call n_N(sP,0,LoadInteger(sp,0,sP*$1f4)+1)
