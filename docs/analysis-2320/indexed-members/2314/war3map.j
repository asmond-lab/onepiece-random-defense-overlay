function Gxw takes nothing returns nothing
call TyG(0)
if jF[sP]==0 then
call SgN(sP,0,GetAttacker())
call SgN(sP,1,GetTriggerUnit())
call Y5G(sP,0,GetUnitLoc(LoadUnitHandle(gp,0,sP*$1f4)))
call Y5G(sP,1,GetUnitLoc(LoadUnitHandle(gp,0,sP*$1f4+1)))
call n_N(sP,0,bU[GetPlayerId(GetOwningPlayer(LoadUnitHandle(gp,0,sP*$1f4)))])
call n_N(sP,1,0)
call n_N(sP,2,0)
call n_N(sP,3,0)
if LoadInteger(sp,0,sP*$1f4)<1 or LoadInteger(sp,0,sP*$1f4)>3 then
call P1P(sP,.1,4)
elseif LoadInteger(sp,0,sP*$1f4)==1 then
call P1P(sP,.1,1)
elseif LoadInteger(sp,0,sP*$1f4)==2 then
call P1P(sP,.1,2)
elseif LoadInteger(sp,0,sP*$1f4)==3 then
call P1P(sP,.1,3)
endif
elseif jF[sP]==1 then
if LoadInteger(sp,0,sP*$1f4+1)<10 then
call n_N(sP,5,bU[GetPlayerId(GetOwningPlayer(LoadUnitHandle(gp,0,sP*$1f4)))])
if LoadInteger(sp,0,sP*$1f4+5)!=1 then
call AnN(sP)
endif
call UnitDamagePointLoc(LoadUnitHandle(gp,0,sP*$1f4),0.,750.,LoadLocationHandle(yp,0,sP*$1f4+1),120000.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
call n_N(sP,1,LoadInteger(sp,0,sP*$1f4+1)+1)
call P1P(sP,.2,1)
else
call P1P(sP,.2,4)
endif
elseif jF[sP]==2 then
if LoadInteger(sp,0,sP*$1f4+2)<8 then
call n_N(sP,5,bU[GetPlayerId(GetOwningPlayer(LoadUnitHandle(gp,0,sP*$1f4)))])
if LoadInteger(sp,0,sP*$1f4+5)>2 then
call AnN(sP)
endif
call UnitDamagePointLoc(LoadUnitHandle(gp,0,sP*$1f4),0.,500.,LoadLocationHandle(yp,0,sP*$1f4+1),200000.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
call n_N(sP,2,LoadInteger(sp,0,sP*$1f4+2)+1)
call P1P(sP,.2,2)
else
call P1P(sP,.2,4)
endif
elseif jF[sP]==3 then
if LoadInteger(sp,0,sP*$1f4+3)<15 then
call UnitDamagePointLoc(LoadUnitHandle(gp,0,sP*$1f4),0.,850.,LoadLocationHandle(yp,0,sP*$1f4+1),250000.,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL)
call n_N(sP,3,LoadInteger(sp,0,sP*$1f4+3)+1)
call P1P(sP,.2,3)
else
call P1P(sP,.2,4)
endif
elseif jF[sP]==4 then
set bU[GetPlayerId(GetOwningPlayer(LoadUnitHandle(gp,0,sP*$1f4)))]=0
call AnN(sP)
endif
endfunction
function H2P takes nothing returns nothing
local integer q2P
call TyG(0)
if jF[sP]==0 then
call SgN(sP,0,GetAttacker())
call SgN(sP,1,GetTriggerUnit())
call Y5G(sP,0,GetUnitLoc(LoadUnitHandle(gp,0,sP*$1f4)))
call Y5G(sP,1,GetUnitLoc(LoadUnitHandle(gp,0,sP*$1f4+1)))
call UkN(sP,0,AngleBetweenPoints(LoadLocationHandle(yp,0,sP*$1f4),LoadLocationHandle(yp,0,sP*$1f4+1)))
call n_N(sP,8,GetPlayerId(GetOwningPlayer(LoadUnitHandle(gp,0,sP*$1f4))))
call Y5G(sP,2,PolarProjectionBJ(LoadLocationHandle(yp,0,sP*$1f4),500.,LoadReal(Hp,0,sP*$1f4)))
call SgN(sP,2,CreateUnitAtLoc(GetOwningPlayer(LoadUnitHandle(gp,0,sP*$1f4)),$68304344,LoadLocationHandle(yp,0,sP*$1f4),LoadReal(Hp,0,sP*$1f4)-180.))
call UnitApplyTimedLife(LoadUnitHandle(gp,0,sP*$1f4+2),$42487765,25.)
call SetUnitVertexColorBJ(LoadUnitHandle(gp,0,sP*$1f4+2),100.,100.,100.,30.)
call s3E(LoadUnitHandle(gp,0,sP*$1f4+2),LoadLocationHandle(yp,0,sP*$1f4+2),.40,.01)
call IssueImmediateOrderBJ(LoadUnitHandle(gp,0,sP*$1f4+2),"holdposition")
call IssueTargetOrder(YT[LoadInteger(sp,0,sP*$1f4+8)],"frostarmor",LoadUnitHandle(gp,0,sP*$1f4))
call SgN(sP,10,CreateUnitAtLoc(ON,$68304335,LoadLocationHandle(yp,0,sP*$1f4),LoadReal(Hp,0,sP*$1f4)-180.))
call YvG("55.mdx",LoadUnitHandle(gp,0,sP*$1f4+10),"origin")
call UnitApplyTimedLife(LoadUnitHandle(gp,0,sP*$1f4+10),$42487765,1.)
set q2P=sP
call P1P(q2P,1.,jF[q2P]+1)
elseif jF[sP]==1 then
call Y5G(sP,0,GetUnitLoc(LoadUnitHandle(gp,0,sP*$1f4+2)))
call Y5G(sP,1,GetUnitLoc(LoadUnitHandle(gp,0,sP*$1f4)))
call Y5G(sP,2,PolarProjectionBJ(LoadLocationHandle(yp,0,sP*$1f4+1),100.,GetRandomDirectionDeg()))
call UkN(sP,0,DistanceBetweenPoints(LoadLocationHandle(yp,0,sP*$1f4),LoadLocationHandle(yp,0,sP*$1f4+1)))
if LoadReal(Hp,0,sP*$1f4)>800. then
call SetUnitX(LoadUnitHandle(gp,0,sP*$1f4+2),GetLocationX(LoadLocationHandle(yp,0,sP*$1f4+2)))
call SetUnitY(LoadUnitHandle(gp,0,sP*$1f4+2),GetLocationY(LoadLocationHandle(yp,0,sP*$1f4+2)))
call SgN(sP,10,CreateUnitAtLoc(ON,$68304335,LoadLocationHandle(yp,0,sP*$1f4+2),bj_UNIT_FACING))
call YvG("Effect Dust Wave Rune.mdx",LoadUnitHandle(gp,0,sP*$1f4+10),"origin")
call UnitApplyTimedLife(LoadUnitHandle(gp,0,sP*$1f4+10),$42487765,1.)
call IssueImmediateOrderBJ(LoadUnitHandle(gp,0,sP*$1f4+2),"holdposition")
endif
if aNN(LoadUnitHandle(gp,0,sP*$1f4+2)) then
call P1P(sP,.33,1)
else
call AnN(sP)
endif
endif
endfunction
function H3N takes nothing returns nothing
local integer o3N
local integer U3N
local integer d3N
local unit g3N
local unit T3N
local integer y3N
local location r3N
local boolexpr u3N
local code m3N
local integer s3N
local integer q3N
call TyG(0)
if jF[sP]==0 then
call SgN(sP,0,GetAttacker())
call SgN(sP,1,GetTriggerUnit())
call G_E(sP,0,GetOwningPlayer(LoadUnitHandle(gp,0,sP*$1f4)))
call Y5G(sP,0,GetUnitLoc(LoadUnitHandle(gp,0,sP*$1f4)))
call Y5G(sP,1,GetUnitLoc(LoadUnitHandle(gp,0,sP*$1f4+1)))
call UkN(sP,0,AngleBetweenPoints(LoadLocationHandle(yp,0,sP*$1f4),LoadLocationHandle(yp,0,sP*$1f4+1)))
call SetUnitAnimation(LoadUnitHandle(gp,0,sP*$1f4),"spell one")
call Y5G(sP,2,PolarProjectionBJ(LoadLocationHandle(yp,0,sP*$1f4),185.,LoadReal(Hp,0,sP*$1f4)))
set U3N=sP
call P1P(U3N,.03,jF[U3N]+1)
elseif jF[sP]==1 then
call SetUnitAnimation(LoadUnitHandle(gp,0,sP*$1f4),"spell one")
if rcw(1,4)<2 then
call SgN(sP,10,CreateUnitAtLoc(ON,$6530324d,LoadLocationHandle(yp,0,sP*$1f4+2),GetRandomDirectionDeg()))
endif
set d3N=sP
call P1P(d3N,.25,jF[d3N]+1)
elseif jF[sP]==2 then
call SgN(sP,10,CreateUnitAtLoc(ON,$68304335,LoadLocationHandle(yp,0,sP*$1f4+2),LoadReal(Hp,0,sP*$1f4)))
call SetUnitAnimationByIndex(LoadUnitHandle(gp,0,sP*$1f4+10),1)
set g3N=LoadUnitHandle(gp,0,sP*$1f4+10)
call SetUnitScale(g3N,1.599999905,100.*.01,100.*.01)
call UnitApplyTimedLife(LoadUnitHandle(gp,0,sP*$1f4+10),$42487765,2.)
call SetUnitFlyHeight(LoadUnitHandle(gp,0,sP*$1f4+10),150.,0.)
call YvG("flamestrike3.mdx",LoadUnitHandle(gp,0,sP*$1f4+10),"origin")
call SgN(sP,10,CreateUnitAtLoc(ON,$68304335,LoadLocationHandle(yp,0,sP*$1f4+2),LoadReal(Hp,0,sP*$1f4)-180.))
set T3N=LoadUnitHandle(gp,0,sP*$1f4+10)
call SetUnitScale(T3N,200.*.01,100.*.01,100.*.01)
call UnitApplyTimedLife(LoadUnitHandle(gp,0,sP*$1f4+10),$42487765,1.)
call SetUnitFlyHeight(LoadUnitHandle(gp,0,sP*$1f4+10),135.,.0)
call SetUnitAnimationByIndex(LoadUnitHandle(gp,0,sP*$1f4+10),1)
call YvG("E_WarStompCaster.mdx",LoadUnitHandle(gp,0,sP*$1f4+10),"origin")
set o3N=c2E()
set y3N=o3N
set r3N=LoadLocationHandle(yp,0,sP*$1f4+1)
set u3N=Condition(eV)
set m3N=kV
call GroupEnumUnitsInRangeOfLoc(GS[y3N],r3N,425.,u3N)
call ForGroup(GS[y3N],m3N)
set s3N=o3N
call GroupClear(GS[s3N])
call taG(s3N)
set q3N=sP
call P1P(q3N,.65,jF[q3N]+1)
endif
if jF[sP]==3 then
call AnN(sP)
endif
set g3N=null
set T3N=null
set r3N=null
set u3N=null
endfunction
function H4E takes nothing returns nothing
local boolean s4E=false
local integer q4E=0
loop
exitwhen q4E>=4
if ZP[q4E]then
set s4E=true
set lP[q4E]=lP[q4E]+1
call XGE(q4E)
endif
set q4E=q4E+1
endloop
if s4E then
return
endif
call DisableTrigger(eP)
endfunction
function H5G takes nothing returns nothing
local unit u5G=GetAttacker()
