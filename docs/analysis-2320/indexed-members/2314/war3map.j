set AN=3
call GrG(GetTriggerUnit())
call SetUnitAnimationByIndex(yH,2)
set FH=SNN("유닛 카운트가 80으로 줄어듭니다.\n모든 적들의 체력이 증가하며 보스 유닛들의 체력이 40% 증가합니다.\n모든 적 유닛들의 이동속도가 30% 증가합니다.\n|cffffd70035라운드|r까지 |cffff00009. 어인섬|r을 파괴하지 못하면 패배합니다.",0.,0.)
elseif GetTriggerUnit()==sH then
call SetUnitAnimation(GetTriggerUnit(),"Stand Alternate")
set AN=4
call GrG(GetTriggerUnit())
call SetUnitAnimationByIndex(yH,3)
set FH=SNN("유닛 카운트가 70으로 줄어듭니다.\n모든 적의 |cff87cefa마법방어력|r이 5% 증가하며 보스 유닛들의 체력이 125% 증가합니다.\n모든 적 유닛들의 이동속도가 30% 증가합니다.\n|cffffd70035라운드|r까지 |cffff000011. 드레스로자|r를 파괴하지 못하면 패배합니다.",0.,0.)
elseif GetTriggerUnit()==qH then
call SetUnitAnimation(GetTriggerUnit(),"Stand Alternate")
set AN=5
call GrG(GetTriggerUnit())
call SetUnitAnimationByIndex(yH,4)
set FH=SNN("유닛 카운트가 70으로 줄어들며 41라운드부터 유닛 카운트가 55로 감소합니다.\n모든 적의 |cff87cefa마법방어력|r이 5% 증가하며 보스 유닛들의 체력이 200% 증가합니다.\n모든 적 유닛들의 이동속도가 50% 증가합니다.\n|cffffd70035라운드|r까지 |cffff000012. 홀케이크섬|r을 파괴하지 못하면 패배합니다.",0.,-70.)
elseif GetTriggerUnit()==HH then
call SetUnitAnimation(GetTriggerUnit(),"Stand Alternate")
set AN=6
call GrG(GetTriggerUnit())
call SetUnitAnimationByIndex(yH,5)
set FH=SNN("유닛 카운트가 70으로 줄어들며 41라운드부터 유닛 카운트가 50으로 감소합니다.\n모든 적의 |cff87cefa마법방어력|r이 10% 증가하며 보스 유닛들의 체력이 200% 증가합니다.\n모든 적 유닛들의 이동속도가 50% 증가합니다.\n|cffffd70035라운드|r까지 |cffff000013. 와노쿠니|r를 파괴하지 못하면 패배합니다.\n클리어시|cff00d9ff1 베리|r 추가 획득",0.,-70.)
endif
call BtE()
if AN<4 then
call gsE(null,"Death")
else
