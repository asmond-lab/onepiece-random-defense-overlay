call TriggerRegisterPlayerChatEvent(ss,Player(lVw),"rde",true)
set lVw=lVw+1
endloop
call TriggerAddAction(ss,Yv)
endif
if ys!=bVw then
set ys=bVw
if rs<bVw then
set rs=bVw
else
set us=us*(bVw/rs)
set rs=bVw
endif
endif
set us=us+GetEventDamage()
if GetUnitStateSwap(UNIT_STATE_MAX_LIFE,WVw)>=us then
if GetPlayerController(CVw)==MAP_CONTROL_USER then
set ms[GetPlayerId(CVw)]=ms[GetPlayerId(CVw)]+GetEventDamage()
else
set ms[GetUnitUserData(jVw)]=ms[GetUnitUserData(jVw)]+GetEventDamage()
endif
else
set fVw=us-bVw
set xVw=GetEventDamage()-fVw
if GetPlayerController(CVw)==MAP_CONTROL_USER then
set ms[GetPlayerId(CVw)]=ms[GetPlayerId(CVw)]+xVw
else
set ms[GetUnitUserData(jVw)]=ms[GetUnitUserData(jVw)]+xVw
endif
endif
set jVw=null
set WVw=null
set CVw=null
endfunction
