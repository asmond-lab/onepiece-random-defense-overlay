function I9G takes nothing returns nothing
local integer f9G=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
local real x9G
local real l9G
local unit K9G
if GetUnitTypeId(GetTriggerUnit())!=$65303138 then
set K9G=null
return
endif
set gw[f9G]=gw[f9G]+1
set K9G=GetTriggerUnit()
call ShowUnit(K9G,false)
call KillUnit(K9G)
call GXN(f9G,lH[4])
set x9G=CN
set l9G=bN
set bj_lastCreatedUnit=CreateUnit(Player(f9G),lH[4],x9G,l9G,bj_UNIT_FACING)
call IssueImmediateOrder(bj_lastCreatedUnit,"holdposition")
if ew[f9G]then
call UnitAddAbility(bj_lastCreatedUnit,$4130544a)
else
call UnitAddAbility(bj_lastCreatedUnit,$41303759)
endif
call DisplayTextToPlayer(Player(f9G),0.,0.,GetUnitName(bj_lastCreatedUnit)+" 획득!")
set K9G=null
endfunction
function IAw takes nothing returns boolean
return GetUnitRace(GetTriggerUnit())==RACE_ORC and GetUnitAbilityLevel(GetTriggerUnit(),$41393033)>0 or GetUnitAbilityLevel(GetTriggerUnit(),$41304946)>0
endfunction
