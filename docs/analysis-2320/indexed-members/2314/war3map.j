call XNE(sP,LoadUnitHandle(gp,0,sP*$1f4+1),EVENT_UNIT_DAMAGED,Condition(Bn),2)
set YwN=sP
call P1P(YwN,.5,jF[YwN]+1)
elseif jF[sP]==1 then
set iwN=sP
call YUN(At[iwN])
set At[iwN]=0
call AnN(sP)
elseif jF[sP]==2 then
set AwN=sP
call YUN(At[AwN])
set At[AwN]=0
call UkN(sP,2,GetEventDamage())
call n_N(sP,0,0)
if GetUnitAbilityLevel(LoadUnitHandle(gp,0,sP*$1f4),$41304950)>=2 then
call SgN(sP,10,CreateUnitAtLoc(ON,$65304851,LoadLocationHandle(yp,0,sP*$1f4+2),LoadReal(Hp,0,sP*$1f4)))
call SetUnitVertexColor(LoadUnitHandle(gp,0,sP*$1f4+10),$ff,$ff,$ff,$96)
call SetUnitAnimation(LoadUnitHandle(gp,0,sP*$1f4+10),"spell throw")
call SetUnitTimeScale(LoadUnitHandle(gp,0,sP*$1f4+10),1.5)
call UnitApplyTimedLife(LoadUnitHandle(gp,0,sP*$1f4+10),$42487765,.66)
call SgN(sP,10,CreateUnitAtLoc(ON,$6530484e,LoadLocationHandle(yp,0,sP*$1f4+2),LoadReal(Hp,0,sP*$1f4)))
call SetUnitTimeScale(LoadUnitHandle(gp,0,sP*$1f4+10),1.5)
call UnitApplyTimedLife(LoadUnitHandle(gp,0,sP*$1f4+10),$42487765,.66)
endif
set bj_lastPlayedSound=Qbw("SE\\gaban_axewind_5.wav",null,$7f,1.,false,1000.,1500.)
call StopSound(bj_lastPlayedSound,false,false)
call f6N(LoadUnitHandle(gp,0,sP*$1f4),bj_lastPlayedSound)
call SgN(sP,10,CreateUnitAtLoc(ON,$6530484d,LoadLocationHandle(yp,0,sP*$1f4+1),270.))
call SetUnitVertexColor(LoadUnitHandle(gp,0,sP*$1f4+10),$ff,$ff,$ff,$96)
call SgN(sP,10,CreateUnitAtLoc(ON,$6530484f,LoadLocationHandle(yp,0,sP*$1f4+1),270.))
call SetUnitVertexColor(LoadUnitHandle(gp,0,sP*$1f4+10),$ff,$ff,$ff,$96)
call UkN(sP,3,8750000.*ZsE(1.,1.5))
if GetUnitAbilityLevel(LoadUnitHandle(gp,0,sP*$1f4),$41304950)>=2 then
call n_N(sP,2,R2I(RMinBJ(LoadReal(Hp,0,sP*$1f4+2)/300000.,8.)))
call oJE(LoadUnitHandle(gp,0,sP*$1f4),LoadReal(Hp,0,sP*$1f4+2),"X",17.,12.,22.,182.,265.,true)
else
call n_N(sP,2,1)
endif
if (not RFN(LoadUnitHandle(gp,0,sP*$1f4+1)))and GetUnitAbilityLevel(LoadUnitHandle(gp,0,sP*$1f4+1),$41393034)<=0 then
