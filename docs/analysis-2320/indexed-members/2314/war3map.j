function XoG takes nothing returns nothing
local unit MoG=GetTriggerUnit()
local player JoG=GetOwningPlayer(MoG)
local integer SoG
if GetPlayerState(JoG,PLAYER_STATE_RESOURCE_FOOD_USED)<4 then
call DisplayTimedTextToPlayer(JoG,0.,0.,5.,"|cffff0000[오류]|r|cff1e90ff특성포인트|r가 부족합니다!")
call IssueImmediateOrder(MoG,"stop")
set MoG=null
set JoG=null
return
endif
if Jh!=null then
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10.,"|cff04ffc4[알림]|r 해왕류가 시라호시의 부름에 응답해 물러납니다.")
call UfN(MoG,Jh,GetUnitState(Jh,UNIT_STATE_MAX_LIFE),2.,2.,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
endif
set Ka[GetPlayerId(JoG)]=MoG
set SoG=GetHeroXP(MoG)
call TriggerRegisterUnitEvent(xa,MoG,EVENT_UNIT_HERO_LEVEL)
set SoG=SoG+$10e*dP[GetPlayerId(JoG)]
call SetHeroXP(MoG,SoG,false)
set dP[GetPlayerId(JoG)]=-11
