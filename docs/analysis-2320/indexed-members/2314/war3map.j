endfunction
function nME takes integer TME returns nothing
local integer yME=GetPlayerId(GetTriggerPlayer())
local integer rME
local integer uME
local integer mME
local integer sME
local integer qME
local integer HME
local integer hME
local integer FME
local integer tME
local integer pME
local string jME
local integer WME
local string CME
local integer bME
local integer fME
local integer xME
local integer lME
local integer KME
local integer IME
local string LME
local integer VME
local integer ZME
local integer eME
local string DME
local integer kME
local string OME
local integer QME
if TME<=5 then
if GetLocalPlayer()==Player(yME) then
set mME=yS
call BlzFrameSetVisible(LoadFrameHandle(wG,0,mME),false)
set sME=gS
call BlzFrameSetVisible(LoadFrameHandle(wG,0,sME),false)
set qME=TS
call BlzFrameSetVisible(LoadFrameHandle(wG,0,qME),false)
set HME=RS
call BlzFrameSetVisible(LoadFrameHandle(wG,0,HME),false)
set hME=BS
call BlzFrameSetVisible(LoadFrameHandle(wG,0,hME),false)
set FME=aS
call BlzFrameSetVisible(LoadFrameHandle(wG,0,FME),true)
set uME=1
loop
exitwhen uME>40
set HS[uME]=LoadInteger(jS,TME,uME)
if HS[uME]==0 then
set tME=LW[uME]
call BlzFrameSetVisible(LoadFrameHandle(wG,0,tME),false)
else
set pME=LW[uME]
set jME=LoadStr(WS,0,HS[uME])
call BlzFrameSetTexture(LoadFrameHandle(wG,0,pME),jME,0,true)
set WME=VW[uME]
set CME=I2S(LoadInteger(cG,fE[yME],HS[uME]))+"회"
call BlzFrameSetText(LoadFrameHandle(wG,0,WME),CME)
set bME=LW[uME]
call BlzFrameSetVisible(LoadFrameHandle(wG,0,bME),true)
endif
set uME=uME+1
endloop
endif
elseif TME<=14 then
if GetLocalPlayer()==Player(yME) then
set fME=gS
call BlzFrameSetVisible(LoadFrameHandle(wG,0,fME),false)
set xME=TS
call BlzFrameSetVisible(LoadFrameHandle(wG,0,xME),false)
set lME=yS
call BlzFrameSetVisible(LoadFrameHandle(wG,0,lME),true)
if TME==6 then
set qS=qS+1
elseif TME==7 then
set qS=qS+2
elseif TME==8 then
set qS=qS+3
elseif TME==9 then
set qS=qS+4
elseif TME==10 then
set qS=qS+5
elseif TME==11 then
set qS=qS+6
elseif TME==12 then
set qS=qS+7
elseif TME==13 then
set qS=qS+8
elseif TME==14 then
set qS=qS+9
endif
set rME=hS[qS]
set uME=1
loop
exitwhen uME>45
set HS[uME]=LoadInteger(jS,rME,uME)
if HS[uME]==0 then
set KME=tW[uME]
call BlzFrameSetVisible(LoadFrameHandle(wG,0,KME),false)
else
set IME=tW[uME]
set LME=LoadStr(WS,0,HS[uME])
call BlzFrameSetTexture(LoadFrameHandle(wG,0,IME),LME,0,true)
set VME=tW[uME]
call BlzFrameSetVisible(LoadFrameHandle(wG,0,VME),true)
call D9P(yME)
endif
set uME=uME+1
endloop
endif
elseif TME<=19 then
if GetLocalPlayer()==Player(yME) then
set rME=TME-14
set uME=1
loop
exitwhen uME>35
set HS[uME]=LoadInteger(jS,rME,uME)
if HS[uME]==0 then
set ZME=LW[uME]
call BlzFrameSetVisible(LoadFrameHandle(wG,0,ZME),false)
else
set eME=LW[uME]
set DME=LoadStr(WS,0,HS[uME])
call BlzFrameSetTexture(LoadFrameHandle(wG,0,eME),DME,0,true)
set kME=VW[uME]
set OME=I2S(LoadInteger(cG,fE[yME],HS[uME]))+"회"
call BlzFrameSetText(LoadFrameHandle(wG,0,kME),OME)
set QME=LW[uME]
call BlzFrameSetVisible(LoadFrameHandle(wG,0,QME),true)
endif
set uME=uME+1
endloop
endif
endif
endfunction
function RWE takes nothing returns nothing
