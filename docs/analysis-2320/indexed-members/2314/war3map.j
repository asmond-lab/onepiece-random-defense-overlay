local player foN
local player xoN
local player loN
local player KoN
call ShowUnit(boN,false)
call KillUnit(boN)
set kE[poN]=kE[poN]+1
if rcw(1,$64)<=30 then
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5.,GetPlayerName(Player(poN))+"|r 님이 |cffff8200고급유닛 도박|r을 |cffff0000실패|r 하셨습니다.")
set bj_lastCreatedUnit=CreateUnit(Player(poN),$68303647,joN,WoN,bj_UNIT_FACING)
