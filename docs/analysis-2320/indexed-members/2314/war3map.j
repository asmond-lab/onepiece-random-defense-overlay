call SetPlayerState(Player(poN),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(Player(poN),PLAYER_STATE_RESOURCE_LUMBER)+1)
call DisplayTimedTextToPlayer(Player(poN),0.,0.,5.,"|cffF15F5F[시스템]|r |cffffae00도박광 :: 리스크헷지|r 항법효과로 |cff7ad823목재 1개|r, "+GetUnitName(bj_lastCreatedUnit)+" 1개 추가 획득")
endif
set foN=Player(poN)
set C=foN
call TriggerEvaluate(W)
set boN=null
set foN=null
set xoN=null
set loN=null
set KoN=null
return
endif
if rcw(1,$64)<=4 then
set nE[poN]=nE[poN]+1
set bj_lastCreatedUnit=CreateUnit(Player(poN),$68303558,joN,WoN,bj_UNIT_FACING)
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5.,GetPlayerName(Player(poN))+"|r 님이 |cffff8200고급유닛 도박|r으로 "+GetUnitName(bj_lastCreatedUnit)+" 획득!")
set xoN=Player(poN)
set C=xoN
call TriggerEvaluate(W)
set boN=null
set foN=null
set xoN=null
set loN=null
set KoN=null
return
endif
if iN and XP[poN]==1 then
if rcw(1,$64)==1 then
set nE[poN]=nE[poN]+1
set bj_lastCreatedUnit=PlaceRandomUnit(ly,Player(poN),joN,WoN,bj_UNIT_FACING)
call UnitAddAbility(bj_lastCreatedUnit,$4130595a)
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5.,GetPlayerName(Player(poN))+"|r 님이 |cffff8200고급유닛 도박|r으로 "+GetUnitName(bj_lastCreatedUnit)+" 획득!")
set loN=Player(poN)
set C=loN
call TriggerEvaluate(W)
set boN=null
set foN=null
set xoN=null
set loN=null
set KoN=null
return
endif
endif
if XP[poN]==1 then
set CoN=0
endif
if rcw(1,$64)<=CoN then
set QE[poN]=QE[poN]+1
set bj_lastCreatedUnit=PlaceRandomUnit(fy,Player(poN),joN,WoN,bj_UNIT_FACING)
call IssueImmediateOrder(bj_lastCreatedUnit,"holdposition")
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5.,GetPlayerName(Player(poN))+"|r 님이 |cffff8200고급유닛 도박|r으로 "+GetUnitName(bj_lastCreatedUnit)+" 획득!")
else
set nE[poN]=nE[poN]+1
set bj_lastCreatedUnit=PlaceRandomUnit(xy,Player(poN),joN,WoN,bj_UNIT_FACING)
call UnitAddAbility(bj_lastCreatedUnit,$41305945)
call IssueImmediateOrder(bj_lastCreatedUnit,"holdposition")
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5.,GetPlayerName(Player(poN))+"|r 님이 |cffff8200고급유닛 도박|r으로 "+GetUnitName(bj_lastCreatedUnit)+" 획득!")
endif
