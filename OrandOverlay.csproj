<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OrandOverlay</AssemblyName>
    <RootNamespace>OrandOverlay</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 자동 업데이트가 릴리스 태그(v0.2.0)와 비교하는 버전 — 릴리스마다 올린다. -->
    <Version>0.6.69</Version>
    <InformationalVersion>0.6.69</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OrandOverlay.Tests" />
    <InternalsVisibleTo Include="PlannerEvidenceCapture" />
    <InternalsVisibleTo Include="OrandSimulator" />
    <Content Include="Data\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Compile Remove="SmokeTests\**\*.cs" />
    <Compile Remove="MemoryDiagnostics\**\*.cs" />
    <Compile Remove="OrandOverlay.Tests\**\*.cs" />
    <Compile Remove="Tools\**\*.cs" />
  </ItemGroup>
</Project>
