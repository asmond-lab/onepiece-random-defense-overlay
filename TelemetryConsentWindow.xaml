<Window x:Class="OrandOverlay.TelemetryConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OrandOverlay"
        Title="랜디픽 · 플레이 기록 수집 동의" Width="540" Height="740"
        MinWidth="375" MinHeight="480" WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic" FontSize="{x:Static local:OverlayTheme.CoachBodyTypeSize}"
        Background="{x:Static local:OverlayTheme.RowBrush}"
        Foreground="{StaticResource TextPrimaryBrush}" UseLayoutRounding="True"
        PreviewKeyDown="Window_OnPreviewKeyDown">
  <Window.Resources>
    <Style x:Key="NoticeText" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="{x:Static local:OverlayTheme.CoachSectionSpacing}"/>
    </Style>
    <Style x:Key="NoticeHeading" TargetType="TextBlock" BasedOn="{StaticResource NoticeText}">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{x:Static local:OverlayTheme.GoldBrush}"/>
    </Style>
    <Style x:Key="ConsentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="{x:Static local:OverlayTheme.CoachIconSize}"/>
      <Setter Property="Padding" Value="{x:Static local:OverlayTheme.PlannerBlockPadding}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" Background="{TemplateBinding Background}"
                    BorderBrush="{StaticResource BorderTintBrush}"
                    BorderThickness="{x:Static local:OverlayTheme.WellBorderThickness}"
                    CornerRadius="{x:Static local:OverlayTheme.WellCornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Body" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Body" Property="Background" Value="{StaticResource ControlPressedBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Body" Property="BorderBrush" Value="{x:Static local:OverlayTheme.FocusBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="{x:Static local:OverlayTheme.CoachPanelPadding}" KeyboardNavigation.TabNavigation="Cycle">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="필수 동의" Style="{StaticResource NoticeHeading}"/>
      <TextBlock Text="플레이 기록과 오류 진단" Style="{StaticResource NoticeText}"
                 FontSize="{x:Static local:OverlayTheme.CoachTitleTypeSize}" FontWeight="Bold"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  AutomationProperties.Name="플레이 기록 수집 안내" AutomationProperties.AutomationId="consent-notice">
      <StackPanel>
        <Border Style="{StaticResource CurrentCraftWell}" Margin="{x:Static local:OverlayTheme.CoachSectionSpacing}">
          <TextBlock Text="동의하면 플레이 기록을 자동으로 모아 서버에 보냅니다.&#10;추천을 개선하고 유닛 인식 오류를 해결하는 데 사용합니다."
                     TextWrapping="Wrap"/>
        </Border>
        <TextBlock Text="수집하는 기록" Style="{StaticResource NoticeHeading}"/>
        <TextBlock Text="선택한 맵에서 인식한 유닛 종류·수량·패 변화&#10;확인된 라운드와 앱에서 고른 조합 목표&#10;앱에 표시된 추천 단계와 추천 유닛"
                   Style="{StaticResource NoticeText}"/>
        <TextBlock Text="유닛 인식 성공·실패·일시정지·복구 상태&#10;인식에 걸린 시간과 끊긴 시간&#10;앱·게임·맵 데이터 버전"
                   Style="{StaticResource NoticeText}"/>
        <TextBlock Text="수집 범위와 전송 방식" Style="{StaticResource NoticeHeading}"/>
        <TextBlock Text="닉네임·채팅·화면 사진은 보내지 않습니다.&#10;파일 경로·메모리 주소도 제외합니다.&#10;PC를 계속 식별하는 번호는 만들지 않습니다.&#10;인식한 유닛은 참고용으로 기록합니다.&#10;조합·승패·행동은 확인된 내용만 기록합니다."
                   Style="{StaticResource NoticeText}"/>
        <TextBlock Text="앱을 실행할 때와 게임 구간마다&#10;임의 번호로 기록을 묶습니다.&#10;전송 대상: 랜디픽 수집 서버&#10;orand-telemetry.epic42121.workers.dev"
                   Style="{StaticResource NoticeText}"/>
        <TextBlock Text="보내지 못한 기록은 PC에 임시로 보관하고&#10;인터넷에 다시 연결되면 보냅니다.&#10;저장 공간 한도 내에서 최대 30일 보관합니다."
                   Style="{StaticResource NoticeText}"/>
        <TextBlock Text="서버의 자세한 기록은 30일 보관합니다.&#10;추천을 개선하기 위해 합친 통계는&#10;30일 뒤에도 보관할 수 있습니다."
                   Style="{StaticResource NoticeText}"/>
        <TextBlock Text="이용 조건" Style="{StaticResource NoticeHeading}"/>
        <TextBlock Text="앱을 사용하려면 동의가 필요합니다.&#10;거절하거나 창을 닫으면 앱이 종료됩니다.&#10;수집 내용이 바뀌면 다시 동의를 받습니다."
                   Style="{StaticResource NoticeText}"/>
      </StackPanel>
    </ScrollViewer>
    <UniformGrid Grid.Row="2" Columns="2">
      <Button x:Name="DeclineButton" Content="거절하고 종료" Style="{StaticResource ConsentButton}"
              Click="Decline_OnClick" IsCancel="True" AutomationProperties.AutomationId="consent-decline"/>
      <Button x:Name="AgreeButton" Content="동의하고 시작" Style="{StaticResource ConsentButton}"
              Click="Agree_OnClick" AutomationProperties.AutomationId="consent-agree"/>
    </UniformGrid>
  </Grid>
</Window>
