<local:OverlayWindowBase x:Class="OrandOverlay.StatsOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OrandOverlay"
        Width="326" Height="440" Top="48" Left="820"
        FontFamily="Malgun Gothic" Foreground="{x:Static local:RandyPickTheme.Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
  <local:OverlayWindowBase.Resources>
    <Style x:Key="StatsDisclosureStyle" TargetType="Expander">
      <Setter Property="Foreground" Value="{x:Static local:RandyPickTheme.Secondary}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Margin" Value="0,7,0,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <Border BorderBrush="{x:Static local:RandyPickTheme.Border}" BorderThickness="0,1,0,0" Padding="0,7,0,0">
              <StackPanel>
                <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}"
                              FontSize="{TemplateBinding FontSize}" HorizontalContentAlignment="Stretch">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border Background="Transparent" Padding="0,0,0,1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <Path x:Name="Arrow" Data="M 0 0 L 4 3 L 0 6 Z" Fill="{x:Static local:RandyPickTheme.Secondary}" Width="4" Height="6"
                                VerticalAlignment="Center" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5"/>
                          <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{x:Static local:RandyPickTheme.Text}"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="Expansion" ContentSource="Content" Visibility="Collapsed" Margin="0,7,0,0"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Expansion" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </local:OverlayWindowBase.Resources>
  <Border x:Name="StatsChrome" CornerRadius="12" Background="{DynamicResource OverlayShellBrush}" BorderBrush="{x:Static local:RandyPickTheme.Border}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0">
        <Grid x:Name="DragArea" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="DragArea_OnMouseLeftButtonDown" Margin="13,11,13,7">
          <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Image Source="/OrandOverlay;component/Assets/randypick-logo-64.png" Width="22" Height="22" Stretch="Uniform" AutomationProperties.AutomationId="stats-logo"/>
          <TextBlock Grid.Column="1" Margin="7,0,0,0" Text="현재 능력치" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{x:Static local:RandyPickBrand.ProductLabel}" Foreground="{x:Static local:RandyPickTheme.Muted}" FontSize="8"/>
            <Border x:Name="ClickThroughBadge" Visibility="Collapsed" BorderBrush="{x:Static local:RandyPickTheme.Border}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,3,0,0">
              <TextBlock Text="게임 조작" Foreground="{x:Static local:RandyPickTheme.Muted}" FontSize="8"/>
            </Border>
          </StackPanel>
        </Grid>
        <Grid Margin="13,0,13,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="ObservationText" Text="패 확인 대기" FontSize="10" Foreground="{x:Static local:RandyPickTheme.Secondary}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="stats-observation"/>
          <Border Grid.Column="1" Padding="5,2,0,2" Margin="5,0,0,0">
            <TextBlock x:Name="SourceEvidenceText" Text="출처 대기" FontSize="9" Foreground="{x:Static local:RandyPickTheme.Muted}" AutomationProperties.AutomationId="stats-source"/>
          </Border>
        </Grid>
        <TextBlock x:Name="ReadinessSummaryText" FontSize="9" Margin="15,0,15,8" TextWrapping="Wrap" Visibility="Collapsed"/>
      </StackPanel>
      <TextBlock x:Name="UnknownStateText" Grid.Row="1" Text="현재 패를 기다리고 있어요.&#x0a;패를 확인하기 전에는 합계나 목표 충족 여부를 판단하지 않아요."
                 Margin="14,12" TextWrapping="Wrap" Foreground="{x:Static local:RandyPickTheme.Muted}" FontSize="11" AutomationProperties.AutomationId="stats-unknown"/>
      <ScrollViewer x:Name="StatsScroll" Grid.Row="1" Margin="12,0,12,7" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    CanContentScroll="False" PanningMode="VerticalOnly" Visibility="Collapsed" AutomationProperties.AutomationId="stats-scroll">
        <StackPanel>
          <Border x:Name="MetricsFrame" Background="{DynamicResource OverlayRaisedBrush}" BorderBrush="{x:Static local:RandyPickTheme.Border}" BorderThickness="1" CornerRadius="8"
                  AutomationProperties.AutomationId="stats-metric-frame">
            <UniformGrid x:Name="CoreKpiPanel" Columns="3" Rows="1" AutomationProperties.AutomationId="stats-primary-columns"/>
          </Border>
          <StackPanel x:Name="CurrentStatsPanel"/>
          <Expander x:Name="StatsDetailsExpander" Header="수치 자세히" IsExpanded="False" Style="{StaticResource StatsDisclosureStyle}" AutomationProperties.AutomationId="stats-details">
            <StackPanel>
          <TextBlock x:Name="SourceDetailsText" TextWrapping="Wrap" FontSize="10" LineHeight="16" Foreground="{x:Static local:RandyPickTheme.Muted}" AutomationProperties.AutomationId="stats-source-details"/>
          <Expander x:Name="ConditionalExpander" Header="조건에 따른 효과" IsExpanded="False" Style="{StaticResource StatsDisclosureStyle}"
                    AutomationProperties.AutomationId="stats-conditional-details">
            <StackPanel x:Name="ConditionalStatsPanel"/>
          </Expander>
          <Expander Header="추가 지원 효과" Style="{StaticResource StatsDisclosureStyle}">
            <StackPanel x:Name="NonCoreSectionsPanel">
              <UniformGrid x:Name="AdditionalStatsPanel" Columns="2"/>
              <WrapPanel x:Name="AdditionalRolesPanel"/>
              <TextBlock x:Name="EmergencyHeader" Text="긴급소집" Foreground="{x:Static local:RandyPickTheme.Secondary}" FontSize="9" Visibility="Collapsed"/>
              <WrapPanel x:Name="EmergencyPanel" Visibility="Collapsed"/>
              <WrapPanel x:Name="RareRerollPanel"/>
              <TextBlock x:Name="SpecialHeader" Text="특수함" Foreground="{x:Static local:RandyPickTheme.Muted}" FontSize="9" Visibility="Collapsed"/>
              <WrapPanel x:Name="SpecialPanel" Visibility="Collapsed"/>
              <TextBlock x:Name="GreenBloodHeader" Text="그린블러드" Foreground="{x:Static local:RandyPickTheme.Secondary}" FontSize="9" Visibility="Collapsed"/>
              <WrapPanel x:Name="GreenBloodPanel" Visibility="Collapsed"/>
            </StackPanel>
          </Expander>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Background="{DynamicResource OverlayWellBrush}" BorderBrush="{x:Static local:RandyPickTheme.Border}" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="13,8">
        <TextBlock x:Name="StatsFooterText" Text="현재 패 확인 대기"
                   TextWrapping="Wrap" FontSize="9" LineHeight="14" Foreground="{x:Static local:RandyPickTheme.Muted}" AutomationProperties.AutomationId="stats-footer"/>
      </Border>
    </Grid>
  </Border>
</local:OverlayWindowBase>
