<local:OverlayWindowBase x:Class="OrandOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OrandOverlay"
        Title="랜디픽 · 게임 안내창" Width="540" Height="740" Top="48" Left="1360"
        FontFamily="Malgun Gothic"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResize">
  <Border CornerRadius="16" Background="{DynamicResource OverlayShellBrush}" BorderBrush="{x:Static local:RandyPickTheme.Border}" BorderThickness="1">
    <Grid Margin="4">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"
                       MinHeight="{x:Static local:OverlayLayoutPolicy.ScrollableBoardMinimumHeight}"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="DragArea_OnMouseLeftButtonDown"
            Margin="10,8,10,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/randypick-logo-64.png" Width="26" Height="26" Margin="4,0,8,0"/><TextBlock x:Name="GoalText" Text="랜디픽" Foreground="{x:Static local:RandyPickTheme.Text}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"/><Border BorderBrush="{x:Static local:RandyPickTheme.Border}" BorderThickness="1" CornerRadius="3" Padding="5,3" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="{x:Static local:RandyPickBrand.BetaLabel}" Foreground="{x:Static local:RandyPickTheme.Secondary}" FontSize="9"/></Border></StackPanel>
          <TextBlock x:Name="PhaseHintText" Foreground="{x:Static local:RandyPickTheme.Secondary}" FontSize="11"
                     TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"
                     AutomationProperties.AutomationId="planner-phase"
                     AutomationProperties.Name="판단 단계"/>
          <TextBlock x:Name="NavigationCandidateText" Foreground="{x:Static local:OverlayTheme.MutedBrush}"
                     FontSize="{x:Static local:OverlayTheme.PlannerValueTypeSize}" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="navigation-candidate" Visibility="Collapsed"/>
          <TextBlock x:Name="CarryModeText" Foreground="{x:Static local:RandyPickTheme.Text}" FontSize="10.5"
                     FontWeight="SemiBold" Margin="0,3,0,0" Visibility="Collapsed"/>
          <TextBlock x:Name="ReadinessText" Foreground="{x:Static local:RandyPickTheme.Warning}" FontSize="10.5"
                     TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>
        </StackPanel>
        <local:PendingUpdateNotice x:Name="OverlayPendingUpdate" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"/>
        <Border x:Name="OverlayModeBar" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource OverlayWellBrush}" BorderBrush="{x:Static local:RandyPickTheme.Border}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,12,0,5" AutomationProperties.AutomationId="overlay-mode-segment"><UniformGrid x:Name="OverlayModeTabs" Columns="4"/></Border>
        <StackPanel x:Name="ExpertToolbar" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="정산" Click="SettlementButton_OnClick"
                  Style="{StaticResource SubtleButton}" Margin="0,0,6,0"
                  ToolTip="게임이 끝난 직후 인식한 유닛을 등급별로 세어 보여줘요."/>
          <Button Content="다시 추천" Click="ReRecommendButton_OnClick"
                  Style="{StaticResource SubtleButton}" Margin="0,0,6,0"
                  ToolTip="현재 인식한 유닛과 이전 클리어 기록을 바탕으로 다음 목표를 다시 추천해요."/>
          <Border x:Name="ClickThroughBadge" Visibility="Collapsed"
                  Background="{DynamicResource OverlayRaisedBrush}" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
            <TextBlock Text="게임 조작" Foreground="{x:Static local:RandyPickTheme.Muted}" FontSize="10"/>
          </Border>
        </StackPanel>
      </Grid>
      <Border x:Name="NowWell" Grid.Row="1" Style="{StaticResource CurrentCraftWell}"
              Margin="10,8,10,0">
        <StackPanel x:Name="NowPanel"/>
      </Border>
      <Border x:Name="FlowWell" Grid.Row="2" Background="{DynamicResource OverlayWellBrush}" CornerRadius="12"
              Margin="10,6,10,0" Padding="8,6">
        <ScrollViewer MaxHeight="178" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="FlowPanel"/>
        </ScrollViewer>
      </Border>
      <Border x:Name="BoardWell" Grid.Row="3" Background="{DynamicResource OverlayWellBrush}" CornerRadius="12" Margin="10,6,10,0" Padding="8,6">
        <ScrollViewer x:Name="BoardScrollViewer" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.AutomationId="candidate-board-scroll"
                      AutomationProperties.Name="추천 후보와 추천 이유">
          <StackPanel>
            <TextBlock Text="추천 유닛 · 누르면 조합 순서를 볼 수 있어요" Foreground="{x:Static local:RandyPickTheme.Muted}" FontSize="10"
                       FontWeight="SemiBold" Margin="0,0,0,8"/>
            <StackPanel x:Name="BoardPanel"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <local:BeginnerCoachView x:Name="CoachView" Grid.Row="1" Grid.RowSpan="3"
                              Margin="10,8,10,0" Visibility="Collapsed"/>
      <local:NormalCandidateView x:Name="NormalBrowserView" Grid.Row="1" Grid.RowSpan="3" Margin="10,8,10,0" Visibility="Collapsed"/>
      <Grid Grid.Row="4" Margin="12,6,12,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Foreground="{x:Static local:RandyPickTheme.Muted}" FontSize="11" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="overlay-status"/>
        <TextBlock Grid.Column="1" x:Name="OverlayVersionText" Foreground="{x:Static local:RandyPickTheme.Muted}" FontSize="10.5"
                   VerticalAlignment="Bottom" Margin="10,0,0,0"
                   AutomationProperties.AutomationId="overlay-version"/>
      </Grid>
      <ResizeGrip Grid.RowSpan="5" Width="18" Height="18" HorizontalAlignment="Right"
                  VerticalAlignment="Bottom" Margin="0,0,2,2" Foreground="{x:Static local:RandyPickTheme.Secondary}"
                  PreviewMouseLeftButtonDown="ResizeGrip_OnMouseLeftButtonDown"
                  AutomationProperties.AutomationId="overlay-resize-grip"
                  AutomationProperties.Name="유닛 확인 창 크기 조절"
                  ToolTip="드래그하여 유닛 확인 창 크기 조절"/>
    </Grid>
  </Border>
</local:OverlayWindowBase>
