<Window x:Class="OrandOverlay.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:OrandOverlay" Title="{x:Static local:RandyPickBrand.ProductLabel}" Width="{x:Static local:MainPlanTheme.DefaultWidth}" Height="{x:Static local:MainPlanTheme.DefaultHeight}" MinWidth="920" MinHeight="620"
 FontFamily="Malgun Gothic" Background="{x:Static local:RandyPickTheme.Canvas}" Foreground="{x:Static local:OverlayTheme.PlanText}" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Geometry x:Key="BPlanIcon">M1,1 L11,1 11,11 1,11 Z M4,1 L4,11 M6,4 L9,4 M6,7 L9,7</Geometry>
  <Geometry x:Key="BInventoryIcon">M3,1 L10,1 10,9 M1,3 L8,3 8,11 1,11 Z</Geometry>
  <Geometry x:Key="BJournalIcon">M1,1 L1,11 11,11 M3,8 L5,5 7,7 10,2</Geometry>
  <Geometry x:Key="BProfileIcon">M6,2 C4,0 1,1 1,2 L1,10 C3,9 4,9 6,11 C8,9 9,9 11,10 L11,2 C9,0 7,1 6,2 L6,11</Geometry>
  <Geometry x:Key="BSettingsIcon">M6,3 A3,3 0 1 1 5.99,3 M6,0 L6,2 M10.2,1.8 L8.8,3.2 M12,6 L10,6 M10.2,10.2 L8.8,8.8 M6,12 L6,10 M1.8,10.2 L3.2,8.8 M0,6 L2,6 M1.8,1.8 L3.2,3.2</Geometry>
  <Style x:Key="MainNavButton" TargetType="Button">
   <Setter Property="FontSize" Value="{x:Static local:MainPlanTheme.BodySize}"/>
   <Setter Property="Foreground" Value="{x:Static local:OverlayTheme.PlanSecondary}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Padding" Value="12,7"/>
   <Setter Property="Margin" Value="0,0,4,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="NavBody" Background="{TemplateBinding Background}" CornerRadius="{x:Static local:MainPlanTheme.ButtonRadius}" Padding="{TemplateBinding Padding}"
     BorderThickness="{x:Static local:OverlayTheme.WellBorderThickness}" BorderBrush="Transparent"><StackPanel Orientation="Horizontal"><Path Data="{TemplateBinding Tag}" Width="12" Height="12" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,8,0" VerticalAlignment="Center"/><ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/></StackPanel></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBody" Property="Background" Value="{x:Static local:OverlayTheme.PlanRaised}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavBody" Property="BorderBrush" Value="{x:Static local:OverlayTheme.FocusBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border x:Name="MainShell" Loaded="MainShell_OnLoaded" Background="{x:Static local:RandyPickTheme.Canvas}" BorderBrush="{x:Static local:RandyPickTheme.Border}" BorderThickness="1" CornerRadius="12">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="0"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border MinHeight="60" Grid.ColumnSpan="2" Background="{x:Static local:RandyPickTheme.Surface}" BorderBrush="{x:Static local:OverlayTheme.PlanLine}" BorderThickness="{x:Static local:MainPlanTheme.BottomLine}" Padding="{x:Static local:MainPlanTheme.ChromeInset}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/randypick-logo-64.png" Width="28" Height="28" Margin="0,0,8,0"/><TextBlock x:Name="BrandText" Text="랜디픽" Foreground="{x:Static local:RandyPickTheme.Text}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/><Border Background="{x:Static local:RandyPickTheme.Raised}" BorderBrush="{x:Static local:RandyPickTheme.Border}" BorderThickness="1" CornerRadius="3" Padding="5,3" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="{x:Static local:RandyPickBrand.BetaLabel}" Foreground="{x:Static local:RandyPickTheme.Text}" FontSize="9"/></Border></StackPanel>
     <TextBlock x:Name="BrandSubtitle" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Right" FontSize="{x:Static local:MainPlanTheme.MetaSize}" Foreground="{x:Static local:OverlayTheme.PlanSecondary}" VerticalAlignment="Center"/>
     <StackPanel x:Name="MainNavigationTabs" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
      <Button x:Name="PlanNavigationButton" Tag="{StaticResource BPlanIcon}" Content="조합 계획" Click="PlanNavigation_OnClick" Style="{StaticResource MainNavButton}" Background="{x:Static local:RandyPickTheme.Selection}" Foreground="{x:Static local:RandyPickTheme.Text}" FontWeight="Bold" AutomationProperties.AutomationId="main-plan-navigation"/>
      <Button x:Name="InventoryNavigationButton" Tag="{StaticResource BInventoryIcon}" Content="보유 패" Click="InventoryNavigation_OnClick" Style="{StaticResource MainNavButton}" AutomationProperties.AutomationId="main-inventory-navigation"/>
      <Button Tag="{StaticResource BJournalIcon}" Content="이번 판 기록" Click="ReviewNavigation_OnClick" Style="{StaticResource MainNavButton}" AutomationProperties.AutomationId="main-journal-navigation"/>
      <Button x:Name="ProfileNavigationButton" Tag="{StaticResource BProfileIcon}" Content="공략 설정" Click="ProfileNavigation_OnClick" Style="{StaticResource MainNavButton}" AutomationProperties.AutomationId="main-profile-navigation"/>
      <Button x:Name="SettingsNavigationButton" Tag="{StaticResource BSettingsIcon}" Content="설정" Click="SettingsNavigation_OnClick" Style="{StaticResource MainNavButton}" AutomationProperties.AutomationId="main-settings-navigation"/>
     </StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="ExpertSettlementButton" Content="정산" Click="Settlement_OnClick" Visibility="Collapsed"/>
      <Button x:Name="ExpertReRecommendButton" Content="다시 추천" Click="ReRecommend_OnClick" Visibility="Collapsed"/>
      <local:PendingUpdateNotice x:Name="MainPendingUpdate" Margin="0,0,12,0"/>
      <Button x:Name="OverlayButton" Content="오버레이" Click="ToggleOverlay_OnClick" Style="{StaticResource SubtleButton}" Margin="0" Padding="0" Background="Transparent"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid x:Name="BWorkspaceContent" Grid.Row="2" Grid.Column="1" Margin="20,16,20,12">
    <TextBlock x:Name="BoardHeadingText" Visibility="Collapsed"/><TextBlock x:Name="BoardSubheadingText" Visibility="Collapsed"/>
      <Grid x:Name="ExpertBoard" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*" MinHeight="220"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource CurrentCraftWell}">
          <StackPanel x:Name="NowPanel"/>
        </Border>
        <Border Grid.Row="1" Background="{x:Static local:OverlayTheme.PlanSurface}" CornerRadius="12" Padding="10,8" Margin="0,10,0,0">
          <ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="FlowPanel"/>
          </ScrollViewer>
        </Border>
        <Border Grid.Row="2" Background="{x:Static local:OverlayTheme.PlanSurface}" CornerRadius="12" Padding="10,8" Margin="0,10,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="추천 유닛 · 누르면 조합 순서를 볼 수 있어요" Foreground="{x:Static local:OverlayTheme.PlanSecondary}" FontSize="{x:Static local:MainPlanTheme.CaptionSize}"
                         FontWeight="SemiBold" Margin="0,0,0,8"/>
              <StackPanel x:Name="BoardPanel"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="BWorkspaceHeader" Margin="0,0,0,14"><StackPanel><TextBlock x:Name="BWorkspaceTitle" Text="조합 계획" FontSize="24" FontWeight="Bold" Foreground="{x:Static local:RandyPickTheme.Text}"/><TextBlock x:Name="BWorkspaceSubtitle" Text="목표와 다음 행동을 한곳에서 확인하세요." Foreground="{x:Static local:RandyPickTheme.Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel><Border Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{x:Static local:RandyPickTheme.Raised}" BorderBrush="{x:Static local:RandyPickTheme.Border}" BorderThickness="1" CornerRadius="14" Padding="10,5"><TextBlock x:Name="MainObservationStatus" Text="게임의 유닛을 확인하고 있어요" FontSize="10" Foreground="{x:Static local:RandyPickTheme.Secondary}"/></Border></Grid>
      <Border x:Name="BWorkspaceModes" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" Width="430" MaxWidth="430" Background="{x:Static local:RandyPickTheme.Surface}" BorderBrush="{x:Static local:RandyPickTheme.Border}" BorderThickness="1" CornerRadius="9" Padding="3" Margin="0,0,0,14"><StackPanel x:Name="MainModeTabs" Orientation="Horizontal"/></Border>
      <local:BeginnerCoachView x:Name="MainCoachView" Grid.Row="2" IsPlanWorkspace="True" Visibility="Collapsed"/>
      <local:NormalCandidateView x:Name="NormalBrowserView" Grid.Row="2" IsMainWorkspace="True" Visibility="Collapsed"/>
    </Grid>
   </Grid>
   <Border Grid.Row="2" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Left" Width="{x:Static local:MainPlanTheme.DrawerWidth}" Background="{x:Static local:RandyPickTheme.Surface}" BorderBrush="{x:Static local:OverlayTheme.PlanLine}" BorderThickness="{x:Static local:OverlayTheme.WellBorderThickness}" Padding="{x:Static local:OverlayTheme.CoachPanelPadding}">

    <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Expander x:Name="ExpertSettings" IsExpanded="True"
                Foreground="{x:Static local:OverlayTheme.WhiteBrush}">
      <Expander.Header><TextBlock Text="목표와 인식 설정"
                                  Foreground="{x:Static local:OverlayTheme.WhiteBrush}"/></Expander.Header>
      <StackPanel x:Name="AuxiliaryParking">
      <StackPanel x:Name="ProfilePane" AutomationProperties.AutomationId="aux-profile-content">
      <ComboBox x:Name="PlayModeCombo" DisplayMemberPath="BetaName"
                SelectionChanged="PlayMode_OnChanged" AutomationProperties.AutomationId="play-mode"
                AutomationProperties.Name="플레이 모드">
        <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="IsEnabled" Value="{Binding IsBetaAvailable}"/><Setter Property="ToolTip" Value="{x:Static local:BetaPlayModes.LockedReason}"/></Style></ComboBox.ItemContainerStyle>
      </ComboBox>

      <TextBlock x:Name="BeginnerModeHint" Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                 Text="추천을 한 단계씩 따라가세요. 목표와 항법은 자동으로 추천합니다."/>

      <Border Background="{x:Static local:OverlayTheme.PlanSurface}" BorderBrush="{x:Static local:OverlayTheme.PlanLine}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="이번 판 설정" FontSize="{x:Static local:MainPlanTheme.BodySize}" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <StackPanel x:Name="ManualGoalsPanel">
          <TextBlock x:Name="GoalSelectLabel" Text="목표 1" Style="{StaticResource FieldLabel}"/>
          <Grid x:Name="GoalSelectRow" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" x:Name="GoalCategoryCombo" DisplayMemberPath="Name" MinWidth="110"
                      SelectionChanged="GoalCategoryCombo_OnSelectionChanged" Margin="0,0,3,0"/>
            <ComboBox Grid.Column="1" x:Name="GoalCombo" DisplayMemberPath="Name"
                      SelectionChanged="GoalCombo_OnSelectionChanged" Margin="3,0,0,0"/>
          </Grid>
          <TextBlock Text="목표 2 · 선택 사항" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="SecondaryGoalCombo" SelectionChanged="SecondaryGoal_OnChanged"
                    AutomationProperties.AutomationId="secondary-goal" AutomationProperties.Name="두 번째 상위 목표">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock><TextBlock.Text><MultiBinding StringFormat="{}{0} · {1}">
                  <Binding Path="Name"/><Binding Path="Tier"/>
                </MultiBinding></TextBlock.Text></TextBlock>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="두 번째 목표 해제" Click="ClearSecondaryGoal_OnClick"
                  AutomationProperties.AutomationId="clear-secondary-goal"/>
          </StackPanel>
          <CheckBox x:Name="AutoStartCheck" Content="유닛 자동 추천" Margin="3,8,0,0"
                    Visibility="Collapsed"
                    Checked="AutoStart_OnChanged" Unchecked="AutoStart_OnChanged"
                    ToolTip="첫 희귀함과 스토리 보상을 확인하며 현재 패에 맞는 상위를 추천합니다. 클리어 기록이 없어도 후보에 포함하고, 판이 끝나면 다시 대기합니다."/>
          <TextBlock x:Name="BuildVariantLabel" Text="빌드 방향" Style="{StaticResource FieldLabel}"
                     Margin="0,12,0,0" Visibility="Collapsed"/>
          <ComboBox x:Name="BuildVariantCombo" DisplayMemberPath="Name"
                    SelectionChanged="BuildVariantCombo_OnSelectionChanged" Margin="0,6,0,0"
                    Visibility="Collapsed"/>
          <TextBlock x:Name="BuildVariantSummaryText" Style="{StaticResource FieldHint}"
                     Margin="3,5,3,0" Visibility="Collapsed"/>
          <TextBlock x:Name="NavigationLabel" Text="항법" Style="{StaticResource FieldLabel}"
                     Margin="0,12,0,0"/>
          <Grid x:Name="NavigationSelectRow" Margin="0,6,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" x:Name="NavigationCategoryCombo" DisplayMemberPath="Name"
                      SelectionChanged="NavigationCategoryCombo_OnSelectionChanged" Margin="0,0,3,0"/>
            <ComboBox Grid.Column="1" x:Name="NavigationCombo" DisplayMemberPath="Name"
                      SelectionChanged="NavigationCombo_OnSelectionChanged" Margin="3,0,0,0"/>
          </Grid>
          <CheckBox x:Name="AutoNavigationCheck" Content="항법 자동 추천" Margin="3,8,0,0"
                    Visibility="Collapsed" IsChecked="True"
                    Checked="AutoNavigation_OnChanged" Unchecked="AutoNavigation_OnChanged"
                    AutomationProperties.Name="항법 자동 추천"
                    ToolTip="라운드 20에는 후보를 미리 보여주고, 21~23에는 안전한 추천을 설정에 자동 반영합니다. 워크래프트 안의 항법 선택은 직접 해야 합니다."/>
          <TextBlock x:Name="NavigationStatusText" Style="{StaticResource FieldHint}" TextWrapping="Wrap"/>
          <TextBlock x:Name="NavigationCandidateText" Style="{StaticResource FieldHint}" TextWrapping="Wrap"/>
          <Button x:Name="ConfirmNavigationButton" Content="게임 내 선택 완료 확인" Click="ConfirmNavigation_OnClick" Style="{StaticResource SubtleButton}"/>
          <Button x:Name="ClearNavigationButton" Content="항법 선택 기록 지우기" Click="ClearNavigation_OnClick"
                  Style="{StaticResource SubtleButton}" AutomationProperties.AutomationId="navigation-clear"/>
          <TextBlock Text="이번 판 항로개척 진행 상황" Style="{StaticResource FieldLabel}"/>
          <TextBlock x:Name="RouteQuestStatusText" Style="{StaticResource FieldHint}" TextWrapping="Wrap" AutomationProperties.AutomationId="route-quest-status" AutomationProperties.Name="항로개척 자동 확인 상태"/>
          <CheckBox x:Name="BothRouteQuestsCheck" Content="초월·제한 두 퀘스트 완료 목표 (최상위 2기)" Checked="RouteQuest_OnChanged" Unchecked="RouteQuest_OnChanged"/>
          <TextBlock Text="오로성 · 게임에서 확인되지 않으면 직접 선택해 주세요" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
          <ComboBox x:Name="GoroseiCombo" DisplayMemberPath="Name"
                    SelectionChanged="GoroseiCombo_OnSelectionChanged" Margin="0,6,0,0"/>
          <TextBlock x:Name="GoroseiSummaryText" Style="{StaticResource FieldHint}" Margin="3,5,3,0"/>
        </StackPanel>
      </Border>

      </StackPanel>
      <Grid x:Name="InventoryPane" AutomationProperties.AutomationId="aux-inventory-content">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="InventoryOriginText" Text="유닛 확인 중 · 여기서는 변경할 수 없어요" Style="{StaticResource FieldHint}" AutomationProperties.AutomationId="inventory-origin"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" x:Name="RecognitionStatus" Text="게임의 유닛을 기다리고 있어요" Foreground="{x:Static local:OverlayTheme.PlanSecondary}" FontSize="{x:Static local:MainPlanTheme.CaptionSize}"/>
        <ListBox x:Name="InventoryList" Grid.Row="2" Margin="{x:Static local:OverlayTheme.PlanTopGap}" Background="{x:Static local:OverlayTheme.PlanRaised}"
                   BorderThickness="0" Foreground="{x:Static local:OverlayTheme.PlanText}" FontSize="{x:Static local:MainPlanTheme.RecipeSize}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style></ListBox.ItemContainerStyle>
      </ListBox>
      </Grid>
      <StackPanel x:Name="SettingsPane" AutomationProperties.AutomationId="aux-settings-content">

      <Border Background="{x:Static local:OverlayTheme.PlanSurface}" BorderBrush="{x:Static local:OverlayTheme.PlanLine}" BorderThickness="1" CornerRadius="12" Padding="14">
        <StackPanel>
          <TextBlock Text="설정" FontSize="{x:Static local:MainPlanTheme.BodySize}" FontWeight="SemiBold"/>
          <CheckBox x:Name="AutoScanCheck" Content="게임의 유닛 자동 확인" Margin="3,10,0,5" IsChecked="True" Checked="AutoScan_OnChanged" Unchecked="AutoScan_OnChanged"/>
          <CheckBox x:Name="ClickThroughCheck" Content="안내창 위를 눌러 게임 조작" Margin="3,5" IsChecked="False" Checked="ClickThrough_OnChanged" Unchecked="ClickThrough_OnChanged"/>
          <TextBlock Text="오버레이 표시" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
          <ComboBox x:Name="OverlayModeCombo" Margin="0,6,0,2"
                    SelectionChanged="OverlayModeCombo_OnSelectionChanged">
            <ComboBoxItem Content="전체" Tag="Full"/>
            <ComboBoxItem Content="유닛 수치만" Tag="StatsOnly"/>
            <ComboBoxItem Content="숨김" Tag="Hidden"/>
          </ComboBox>
          <CheckBox x:Name="ApplicationUpdateCheck" Content="새 업데이트 자동 확인" Margin="3,5" IsChecked="True" Checked="ApplicationUpdate_OnChanged" Unchecked="ApplicationUpdate_OnChanged" AutomationProperties.AutomationId="app-auto-update"/>
          <TextBlock Text="현재 설치된 종류와 서명이 같은 업데이트만 확인해요. 게임 중이거나 게임 종료 여부를 모르면 설치하지 않아요." Style="{StaticResource FieldHint}" Margin="3,0,3,5" TextWrapping="Wrap"/>
          <CheckBox x:Name="ClearDataRefreshCheck" Content="신+ 클리어 기록 자동 업데이트" Margin="3,5" IsChecked="True" Checked="ClearDataRefresh_OnChanged" Unchecked="ClearDataRefresh_OnChanged"/>
          <TextBlock Text="동의한 범위에서만 플레이 기록을 수집하고 보냅니다." Style="{StaticResource FieldHint}" Margin="3,5"/>
          <Button Content="오버레이 이동" Click="EnableOverlayMove_OnClick" HorizontalAlignment="Left" Margin="0,4,0,0"
                  ToolTip="누른 뒤 오버레이 상단을 끌어 옮깁니다"/>
          <TextBlock Text="오버레이 켜기/끄기 키" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="HotkeyBox" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                     PreviewKeyDown="Hotkey_OnPreviewKeyDown" LostFocus="Hotkey_OnLostFocus"
                     ToolTip="게임 중에도 쓸 수 있는 단축키"/>
            <Button Grid.Column="1" x:Name="HotkeyCaptureButton" Content="키 변경" Margin="8,0,0,0"
                    Click="HotkeyCapture_OnClick"/>
          </Grid>
          <TextBlock x:Name="HotkeyHint" Style="{StaticResource FieldHint}" Margin="3,5,3,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      </StackPanel>
      </StackPanel>
      </Expander>
    </ScrollViewer>
   </Border>
   <Border MinHeight="{x:Static local:MainPlanTheme.FooterHeight}" Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="{x:Static local:OverlayTheme.PlanLine}" BorderThickness="{x:Static local:MainPlanTheme.TopLine}" Padding="{x:Static local:MainPlanTheme.ChromeInset}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock x:Name="DataVersionText" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Visible" TextWrapping="Wrap" Margin="0,4,0,0"
                Foreground="{x:Static local:OverlayTheme.PlanSecondary}" FontSize="{x:Static local:MainPlanTheme.CaptionSize}" AutomationProperties.AutomationId="data-version-support"/>
     <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="GameplayRecordingStatus" Visibility="Collapsed"
                Foreground="{x:Static local:OverlayTheme.PlanWarning}" FontSize="{x:Static local:MainPlanTheme.CaptionSize}"
                TextWrapping="Wrap" AutomationProperties.AutomationId="gameplay-recording-status"/>
     <TextBlock x:Name="FooterStatus" Foreground="{x:Static local:OverlayTheme.PlanSecondary}" FontSize="{x:Static local:MainPlanTheme.CaptionSize}" TextWrapping="Wrap" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="Map2320PatchButton" Content="2.320 변경점" Click="Map2320Patch_OnClick" Style="{StaticResource SubtleButton}" FontSize="{x:Static local:OverlayTheme.PlannerValueTypeSize}" Padding="0" Margin="{x:Static local:MainPlanTheme.MetricGap}" Background="Transparent" ToolTip="이전 버전인 원랜디 2.320에서 바뀐 내용을 볼 수 있어요." AutomationProperties.AutomationId="map-2320-patch"/>
      <Button x:Name="CompatibilityCopyButton" Content="제보용 정보 복사" Click="CopyCompatibilityInfo_OnClick" IsEnabled="False" Style="{StaticResource SubtleButton}" FontSize="{x:Static local:OverlayTheme.PlannerValueTypeSize}" Padding="0" Margin="{x:Static local:MainPlanTheme.MetricGap}" Background="Transparent" AutomationProperties.AutomationId="compatibility-copy"/>
      <Button Content="업데이트 확인" Click="CheckUpdateNow_OnClick" Style="{StaticResource SubtleButton}" FontSize="{x:Static local:OverlayTheme.PlannerValueTypeSize}" Padding="0" Margin="{x:Static local:MainPlanTheme.MetricGap}" Background="Transparent"/>
      <TextBlock x:Name="VersionText" Foreground="{x:Static local:OverlayTheme.PlanSecondary}" FontSize="{x:Static local:MainPlanTheme.CaptionSize}" VerticalAlignment="Center"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Border>
</Window>
