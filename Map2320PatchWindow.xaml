<Window x:Class="OrandOverlay.Map2320PatchWindow"
 xmlns:local="clr-namespace:OrandOverlay"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="원랜디 2.320 변경점" Width="800" Height="720" MinWidth="520" MinHeight="400"
 FontFamily="Malgun Gothic" FontSize="14" Background="{x:Static local:RandyPickTheme.Canvas}" Foreground="{x:Static local:RandyPickTheme.Text}"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
 AutomationProperties.AutomationId="map-2320-patch-dialog">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="23"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock Text="원랜디 2.320 변경점" FontSize="24" FontWeight="Bold" LineHeight="32"/>
   <TextBlock Text="일반 모드 조합 안내 · 전투 수치는 참고값" Foreground="{x:Static local:RandyPickTheme.Warning}" FontWeight="SemiBold" Margin="0,8,0,0"/>
   <TextBlock Text="2.320 당시 조합·스토리·항법 안내입니다. 인식한 유닛이 실제 보유 유닛과 다를 수 있어요. 조합은 게임에서 확인해 주세요." FontSize="13" Margin="0,6,0,0"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0" Focusable="True" AutomationProperties.Name="2.320 주요 변경점">
   <StackPanel>
    <StackPanel Margin="0,0,0,20">
     <TextBlock Text="2.320 당시 안내 범위" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="읽힌 유닛과 라운드를 보고, 조합에 필요한 재료를 비교할 수 있습니다. 항법은 직접 선택해 주세요. 스턴·이감·방깎 합계와 자동 추천은 아직 제공하지 않습니다."/>
    </StackPanel>
    <StackPanel Margin="0,0,0,20">
     <TextBlock Text="게임 설명과 다른 수치" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="2.320 맵 자료에서 불릿 특강 4레벨의 공격·공속은 50%, 방깎은 50입니다. 게임 설명의 48과 달라요.&#10;환전소의 포인트 차감은 일반 3, 특별 10으로 확인됩니다. 설명에 나온 2 / 6과 다릅니다."/>
    </StackPanel>
    <StackPanel Margin="0,0,0,20">
     <TextBlock Text="조합과 전투 효과는 게임에서 확인해 주세요" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="니카는 재료 외에도 강화 상태와 별도 조건이 필요합니다. 재료 비율이 100%여도 바로 조합할 수 있다는 뜻은 아닙니다.&#10;게임의 능력치 표에는 레오·강화 불릿의 일부 효과가 빠질 수 있습니다. 표시된 수치와 실제 전투 효과가 다를 수 있어요."/>
    </StackPanel>
    <Expander Header="자세히 알아보기" IsExpanded="False" Margin="0,0,0,12" Foreground="{x:Static local:RandyPickTheme.Secondary}" AutomationProperties.AutomationId="map-2320-evidence">
     <StackPanel Margin="0,12,0,0">
    <StackPanel Margin="0,0,0,20">
     <TextBlock Text="불릿 · 게임 설명은 48, 맵 자료는 50" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="2.320 자료에서 특강 4레벨의 공격·공속은 각각 50%, 방깎은 50입니다. 게임 설명의 48%·방깎 48과 달라요. 특성 포인트 4를 써서 3레벨 능력을 4레벨로 올리는 선택입니다.&#10;연계 피해에는 아이템 수가 아닌 능력 레벨이 적용되며, 4레벨도 3레벨과 같은 계수로 계산됩니다. 연타에는 공격 속도 능력이 쓰입니다. 설정값을 살펴본 결과일 뿐, 실제 최종 피해를 측정한 값은 아닙니다."/>
     <TextBlock Text="이 안내는 2.320 당시 맵 자료를 살펴본 결과입니다." FontSize="12" Foreground="{x:Static local:RandyPickTheme.Secondary}" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel Margin="0,0,0,20">
     <TextBlock Text="환전소 · 일반 3 / 특별 10 포인트" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="2.320 자료에서 일반 탐색은 3, 특별 탐색은 10포인트가 차감됩니다. 게임 설명의 2 / 6과 달라요. 보유 한도를 확인하기 전에 차감되며, 이 처리 과정에는 환불이 없습니다. 사용 후 버튼이 꺼지지만 다시 켜지는 모든 경우를 확인하지 못했으므로 한 판에 한 번만 쓸 수 있다고 단정할 수 없습니다."/>
     <TextBlock Text="이 안내는 2.320 당시 맵 자료를 살펴본 결과입니다." FontSize="12" Foreground="{x:Static local:RandyPickTheme.Secondary}" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel Margin="0,0,0,20">
     <TextBlock Text="레오 · 이감 10% / 20%, 능력치 표에는 7 또는 누락" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="2.320 자료에서 기본 레오의 이동 속도 감소는 10%지만, 게임의 능력치 표에는 예전 값인 7이 반영됩니다. 계엄령으로 2레벨(20%)이 되어도 이 능력의 표 기여분은 0으로 나옵니다. 레오의 전체 이감이나 실제 전투 효과가 0이라는 뜻은 아닙니다. 강화 불릿도 표에는 1레벨의 5만 반영되고 2·3·4레벨 기여분은 빠집니다."/>
     <TextBlock Text="게임의 능력치 표와 실제 효과가 다를 수 있어요." FontSize="12" Foreground="{x:Static local:RandyPickTheme.Secondary}" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel Margin="0,0,0,20">
     <TextBlock Text="니카 · 재료 외에 확인할 조건" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="니카를 조합하려면 재료 외에 플레이어의 강화 상태와 별도 조건이 필요합니다. 루피 또는 스네이크맨을 고르는 항목은 별도 보유 유닛이 아니에요. 필요한 토큰도 가방 속 아이템 수와는 다른 조건입니다. 현재 확인된 정보만으로는 조합 가능 여부를 판단할 수 없으니 게임에서 확인해 주세요.&#10;50라운드에 오로성 효과가 적용되는지는 특정 강화 상태를 살펴보며, 살아 있는 니카를 매번 찾는 방식은 아닙니다. 오로성 적용 후 니카 조합에 성공하면 관련 상태는 바로 복원되지만 에메트 연출은 15초 뒤에 나옵니다. 이미 등장한 모든 적의 효과와 체력까지 즉시 완전히 돌아온다고 보장할 수는 없습니다."/>
     <TextBlock Text="재료가 모두 있어 보여도 조합이 바로 가능하다는 뜻은 아니에요." FontSize="12" Foreground="{x:Static local:RandyPickTheme.Secondary}" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel Margin="0,0,0,20">
     <TextBlock Text="2.320 능력치 표는 실제 전투 합계와 달라요" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="게임의 능력치 표를 정확히 읽으려면 유닛의 소유자·생존 여부·종류와 능력 레벨을 알아야 합니다. 인식한 유닛 이름과 수량만으로 계산하거나 수량만큼 곱할 수 없어요. 같은 능력에서는 등록된 레벨 중 낮은 값, 비슷한 효과에서는 절댓값이 작은 값을 고릅니다. 방깎과 이감도 지속 효과와 발동 효과를 따로 보며 임의로 더하지 않습니다.&#10;효과가 실제로 발동했는지, 대상·범위·지속 시간·확률·상한은 확인하지 않았습니다. 능력치 표는 직접 새로고침해야 하고 다시 누르려면 5초를 기다려야 해서 오래된 값일 수 있어요. 레오와 강화 불릿의 누락도 있으므로 실제 전투의 정답으로 볼 수 없습니다. 이 안내로 현재 보유 유닛의 효과 합계나 조합 준비 여부를 알 수는 없습니다."/>
     <TextBlock Text="표시된 수치는 게임에서 실제 적용되는 값과 다를 수 있어요." FontSize="12" Foreground="{x:Static local:RandyPickTheme.Secondary}" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel Margin="0,0,0,20">
     <TextBlock Text="이 안내의 범위" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="이 안내는 2.320 맵 자료와 이전 2.314 자료를 비교한 결과입니다. 실제 게임을 실행하거나 피해·효과를 측정한 결과가 아니며, 현재 게임 버전에서 같은 효과가 난다는 보장도 아닙니다."/>
     <TextBlock Text="실제 조합 가능 여부와 전투 효과는 게임에서 확인해 주세요." FontSize="12" Foreground="{x:Static local:RandyPickTheme.Secondary}" Margin="0,8,0,0"/>
    </StackPanel>
     </StackPanel>
    </Expander>
   </StackPanel>
  </ScrollViewer>
  <Button Grid.Row="2" Content="닫기" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" MinWidth="90" Padding="16,8" Margin="0,12,0,0" AutomationProperties.AutomationId="map-2320-close"/>
 </Grid>
</Window>
